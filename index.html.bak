<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Thakafa Dz | ثقافة دز — Algerian Cultural Platform</title>
  
  <!-- SEO & Social Meta Tags -->
  <meta name="description" content="منظومة ثقافة دز (Thakafa Dz) لحفظ وتوثيق التراث الثقافي والفني الجزائري، استكشاف معالم اليونسكو، المهرجانات، فن الطهي، حجز التذاكر، ودليل الفنانين.">
  <meta name="keywords" content="ثقافة الجزائر, تراث الجزائر, وزارة الثقافة والفنون, متاحف الجزائر, تيمقاد, طاسيلي, الكسكسي الجزائري, Thakafa Dz">
  <meta name="theme-color" content="#07150E">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Thakafa Dz">

  <!-- PWA Manifest Data URI -->
  <link rel="manifest" href="manifest.json">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="icon-192.png">
  <link rel="apple-touch-icon" href="icon-512.png">

  <!-- Google Fonts: Readex Pro, Amiri & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Readex+Pro:wght@300;400;500;600;700&family=Amiri:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    /* ══════════════════════════════════════════════════════
       DESIGN TOKENS & DYNAMIC STYLES
       ══════════════════════════════════════════════════════ */
    :root {
      --bg-dark: #07150E;
      --surface-card: #0D2217;
      --surface-elevated: #133021;
      --border-subtle: rgba(212, 175, 55, 0.22);
      --border-focus: #D4AF37;
      --gold-primary: #D4AF37;
      --gold-light: #F5D77F;
      --gold-dark: #9E7D1E;
      --emerald-accent: #1B7A3D;
      --emerald-light: #28A745;
      --neon-cyan: #00F0FF;
      --neon-gold: #FFD700;
      --neon-emerald: #00FF88;
      --text-primary: #F8FAFC;
      --text-muted: #CBD5E1;
      --text-dim: #94A3B8;
      --font-body: 'Readex Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-heading: 'Amiri', Georgia, serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    html {
      scroll-behavior: smooth;
      background-color: var(--bg-dark);
      color: var(--text-primary);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.6;
    }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      padding-bottom: max(5.2rem, calc(env(safe-area-inset-bottom) + 5rem));
      background: radial-gradient(circle at 50% 0%, #0F2A1C 0%, #07150E 50%, #040A07 100%);
    }

    /* ══ AUTH MODAL STYLES ══ */
    #auth-modal { animation: fadeIn 0.3s ease; }
    .auth-modal-inner { animation: slideUp 0.4s cubic-bezier(0.16,1,0.3,1); }
    @keyframes slideUp { from { opacity:0; transform:translateY(40px) scale(0.96); } to { opacity:1; transform:translateY(0) scale(1); } }
    .auth-tab-btn {
      flex:1; padding:0.85rem; background:transparent; border:none; border-bottom:2px solid transparent;
      color:var(--text-muted); font-family:var(--font-body); font-size:0.9rem; font-weight:600; cursor:pointer; transition:all 0.3s;
    }
    .auth-tab-btn.active { color:var(--gold-primary); border-bottom-color:var(--gold-primary); }
    .auth-field { width:100%; background:rgba(0,0,0,0.4); border:1.5px solid rgba(212,175,55,0.2); border-radius:0.85rem; padding:0.9rem 1rem; color:#FFF; font-family:var(--font-body); font-size:0.9rem; outline:none; transition:all 0.3s; }
    .auth-field:focus { border-color:var(--gold-primary); box-shadow:0 0 0 3px rgba(212,175,55,0.1); }
    .auth-field::placeholder { color:#4B5563; }
    .auth-submit-btn {
      width:100%; padding:1rem; background:linear-gradient(135deg, var(--gold-primary), #A07A18);
      border:none; border-radius:0.85rem; color:#000; font-weight:800; font-size:1rem; font-family:var(--font-body);
      cursor:pointer; transition:all 0.3s; letter-spacing:0.03em; position:relative; overflow:hidden;
    }
    .auth-submit-btn:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(212,175,55,0.4); }
    .auth-submit-btn::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,transparent,rgba(255,255,255,0.18),transparent); transform:translateX(-100%); transition:transform 0.6s; }
    .auth-submit-btn:hover::after { transform:translateX(100%); }
    .sec-badge { display:inline-flex; align-items:center; gap:0.3rem; background:rgba(0,255,136,0.08); border:1px solid rgba(0,255,136,0.25); border-radius:2rem; padding:0.22rem 0.65rem; font-size:0.68rem; color:#00FF88; }
    .user-av-nav { width:2rem; height:2rem; border-radius:50%; background:linear-gradient(135deg,var(--gold-primary),#8B6914); display:flex; align-items:center; justify-content:center; font-weight:800; color:#000; font-size:0.85rem; border:1.5px solid var(--gold-primary); }

    /* ══ BOOKS SECTION STYLES ══ */
    .book-card { background:var(--surface-card); border:1px solid var(--border-subtle); border-radius:1.25rem; padding:1.5rem; display:flex; flex-direction:column; gap:0.9rem; transition:all 0.35s; position:relative; overflow:hidden; }
    .book-card:hover { transform:translateY(-4px); box-shadow:0 16px 40px rgba(0,0,0,0.6); }

    /* ══ GOOGLE MAPS PILL SELECTORS ══ */
    .gmap-monument-pill {
      background: rgba(13,34,23,0.85); border: 1px solid rgba(212,175,55,0.3); border-radius: 2rem;
      padding: 0.35rem 0.9rem; color: #E2E8F0; font-family: var(--font-body); font-size: 0.78rem; font-weight: 600;
      cursor: pointer; white-space: nowrap; transition: all 0.25s; flex-shrink: 0;
    }
    .gmap-monument-pill:hover { border-color: var(--gold-primary); color: #FFF; background: rgba(212,175,55,0.15); }
    .gmap-monument-pill.active { background: var(--gold-primary); color: #000; border-color: var(--gold-primary); font-weight: 700; box-shadow: 0 0 12px rgba(212,175,55,0.4); }

    /* English LTR Mode */

    body.lang-en {
      direction: ltr;
      text-align: left;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-heading: 'Inter', sans-serif;
    }
    body.lang-en .site-header .brand-link { flex-direction: row; }
    body.lang-en .nav-desktop { direction: ltr; }
    body.lang-en .timeline-border { border-right: none; border-left: 2px solid var(--gold-primary); padding-right: 0; padding-left: 1.25rem; }

    h1, h2, h3, h4, .font-heading {
      font-family: var(--font-heading);
      letter-spacing: -0.01em;
    }

    .container {
      width: 100%;
      max-width: 1240px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    /* Skip link */
    .skip-link {
      position: fixed;
      top: 1rem;
      right: 1rem;
      z-index: 100;
      background: var(--gold-primary);
      color: #000;
      padding: 0.75rem 1.25rem;
      border-radius: 0.5rem;
      font-weight: 700;
      text-decoration: none;
      transform: translateY(-200%);
      transition: transform 0.2s ease;
    }
    .skip-link:focus { transform: translateY(0); outline: 3px solid #FFF; }

    /* Animated Glow & Floating Effects */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(1deg); }
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.4; filter: blur(25px); transform: scale(1); }
      50% { opacity: 0.7; filter: blur(35px); transform: scale(1.08); }
    }
    @keyframes shimmerMove {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(200%); }
    }
    @keyframes spinOrbit {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .animate-float { animation: floatSlow 5s ease-in-out infinite; }
    .animate-spin-slow { animation: spinOrbit 30s linear infinite; }

    /* Cards */
    .card {
      background: rgba(13, 34, 23, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-subtle);
      border-radius: 1.25rem;
      overflow: hidden;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
      position: relative;
    }
    .card-interactive { cursor: pointer; }
    .card-interactive:hover {
      transform: translateY(-5px);
      border-color: rgba(212, 175, 55, 0.55);
      box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.7), 0 0 20px rgba(212, 175, 55, 0.15);
    }

    /* Images */
    .img-wrap {
      width: 100%;
      height: 200px;
      overflow: hidden;
      position: relative;
      background: #0A1C12;
    }
    .img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.5s ease;
    }
    .card:hover .img-wrap img { transform: scale(1.08); }
    .img-tag {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      z-index: 2;
      background: rgba(7, 21, 14, 0.88);
      backdrop-filter: blur(8px);
      color: var(--gold-light);
      padding: 0.25rem 0.65rem;
      border-radius: 9999px;
      font-size: 0.725rem;
      font-weight: 600;
      border: 1px solid rgba(212, 175, 55, 0.35);
    }
    body.lang-en .img-tag { right: auto; left: 0.75rem; }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-family: inherit;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 0.65rem 1.25rem;
      border-radius: 0.875rem;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s ease;
      user-select: none;
      position: relative;
      overflow: hidden;
    }
    .btn-gold {
      background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
      color: #07150E;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
    }
    .btn-gold:hover {
      background: linear-gradient(135deg, #FFF0B3, var(--gold-light));
      transform: translateY(-2px);
      box-shadow: 0 6px 22px rgba(212, 175, 55, 0.5);
    }
    .btn-outline {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-primary);
    }
    .btn-outline:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--gold-primary);
      color: var(--gold-light);
      transform: translateY(-2px);
    }
    .btn-emergency {
      background: linear-gradient(135deg, #DC2626, #991B1B);
      color: #FFF;
      box-shadow: 0 4px 15px rgba(220, 38, 38, 0.4);
    }
    .btn-emergency:hover { background: #EF4444; transform: scale(1.02); }
    .btn-pwa {
      background: linear-gradient(135deg, #0284C7, #0369A1);
      color: #FFF;
      box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);
    }
    .btn-pwa:hover { background: #38BDF8; color: #000; transform: translateY(-2px); }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      background: rgba(212, 175, 55, 0.12);
      color: var(--gold-light);
      border: 1px solid rgba(212, 175, 55, 0.3);
    }

    /* Views */
    .app-view {
      display: none;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .app-view.active {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    /* Header */
    header.site-header {
      position: sticky;
      top: 0;
      z-index: 60;
      background: rgba(5, 15, 10, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-subtle);
      box-shadow: 0 4px 25px rgba(0,0,0,0.5);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 4.8rem;
    }

    /* Desktop Nav */
    .nav-desktop {
      display: none;
      gap: 0.25rem;
      background: rgba(255, 255, 255, 0.04);
      padding: 0.3rem;
      border-radius: 1rem;
      border: 1px solid rgba(212, 175, 55, 0.25);
    }
    @media (min-width: 1100px) { .nav-desktop { display: flex; } }

    .nav-link {
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 500;
      padding: 0.45rem 0.75rem;
      border-radius: 0.7rem;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      background: transparent;
      border: none;
      white-space: nowrap;
    }
    .nav-link:hover { color: var(--gold-light); background: rgba(212, 175, 55, 0.1); }
    .nav-link.active {
      color: #07150E;
      background: linear-gradient(135deg, var(--gold-light), var(--gold-primary));
      font-weight: 700;
      box-shadow: 0 2px 10px rgba(212, 175, 55, 0.3);
    }

    /* PWA Install Banner */
    .pwa-banner {
      background: linear-gradient(90deg, #082F49, #0F766E, #14532D);
      border-bottom: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
      color: #FFF;
      position: relative;
      z-index: 70;
    }

    /* Modals */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(8px);
      z-index: 150;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      opacity: 0;
      transition: opacity 0.25s ease;
    }
    .modal-backdrop.open { display: flex; opacity: 1; }
    .modal-box {
      background: #091F14;
      border: 1px solid var(--gold-primary);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 30px rgba(212, 175, 55, 0.25);
      border-radius: 1.25rem;
      max-width: 600px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      padding: 1.75rem;
      position: relative;
    }

    /* Neon AI Widget */
    .neon-ai-trigger {
      position: fixed;
      bottom: max(5.5rem, calc(env(safe-area-inset-bottom) + 5.2rem));
      left: 1.25rem;
      z-index: 80;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 9999px;
      background: linear-gradient(135deg, #07150E, #133021);
      border: 2px solid var(--neon-cyan);
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.5), 0 0 30px rgba(212, 175, 55, 0.3);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--neon-cyan);
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    body.lang-en .neon-ai-trigger { left: auto; right: 1.25rem; }
    .neon-ai-trigger:hover {
      transform: scale(1.1) rotate(6deg);
      border-color: var(--neon-gold);
      box-shadow: 0 0 25px rgba(255, 215, 0, 0.7);
      color: var(--neon-gold);
    }
    .neon-ai-drawer {
      position: fixed;
      bottom: max(9.5rem, calc(env(safe-area-inset-bottom) + 9rem));
      left: 1.25rem;
      width: 370px;
      max-width: calc(100vw - 2.5rem);
      height: 520px;
      max-height: calc(100vh - 12rem);
      background: rgba(7, 21, 14, 0.98);
      border: 1px solid var(--neon-cyan);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.3), 0 25px 50px rgba(0,0,0,0.85);
      border-radius: 1.25rem;
      backdrop-filter: blur(16px);
      z-index: 85;
      display: none;
      flex-direction: column;
      overflow: hidden;
    }
    body.lang-en .neon-ai-drawer { left: auto; right: 1.25rem; }
    .neon-ai-drawer.open { display: flex; }
    .ai-chat-body {
      flex: 1;
      padding: 1rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      font-size: 0.85rem;
    }
    .ai-msg {
      padding: 0.75rem 1rem;
      border-radius: 1rem;
      max-width: 85%;
      line-height: 1.5;
    }
    .ai-msg-assistant {
      background: rgba(19, 48, 33, 0.85);
      border: 1px solid rgba(0, 240, 255, 0.3);
      color: #E2E8F0;
      align-self: flex-start;
      border-bottom-right-radius: 0.2rem;
    }
    .ai-msg-user {
      background: linear-gradient(135deg, var(--gold-dark), var(--gold-primary));
      color: #07150E;
      font-weight: 600;
      align-self: flex-end;
      border-bottom-left-radius: 0.2rem;
    }

    /* Bottom App Bar for Mobile */
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 55;
      background: rgba(5, 16, 11, 0.97);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid rgba(212, 175, 55, 0.3);
      display: flex;
      justify-content: space-around;
      padding: 0.5rem 0 max(0.5rem, env(safe-area-inset-bottom));
    }
    .bottom-tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
      font-size: 0.65rem;
      color: var(--text-muted);
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.25rem 0.5rem;
      border-radius: 0.5rem;
      transition: color 0.2s ease;
    }
    .bottom-tab.active { color: var(--gold-primary); font-weight: 700; }

    /* Toast */
    .toast-container {
      position: fixed;
      top: 5.5rem;
      right: 1.25rem;
      z-index: 160;
      max-width: 380px;
      pointer-events: none;
    }
    body.lang-en .toast-container { right: auto; left: 1.25rem; }
    .toast-card {
      background: var(--surface-elevated);
      border: 1px solid var(--gold-primary);
      box-shadow: 0 10px 25px rgba(0,0,0,0.7);
      border-radius: 1rem;
      padding: 0.85rem 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      transform: translateY(-50px);
      opacity: 0;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
      pointer-events: auto;
    }
    .toast-card.show { transform: translateY(0); opacity: 1; }

    /* Layout Grids */
    .grid-3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 1.5rem; }
    .grid-2 { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.25rem; }

    @media (max-width: 640px) {
      .sm-hide { display: none !important; }
      .grid-3, .grid-2 { grid-template-columns: 1fr; }
    }

    /* ══════════════════════════════════════════════════════
       MODERN LUXURY SCROLLBAR (Replacing default grey)
       ══════════════════════════════════════════════════════ */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #021a11;
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #D4AF37 0%, #155E37 100%);
      border-radius: 9999px;
      border: 2px solid #021a11;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, #F5D77F 0%, #D4AF37 100%);
    }
    * {
      scrollbar-width: thin;
      scrollbar-color: #D4AF37 #021a11;
    }

    /* ══════════════════════════════════════════════════════
       FLOATING PILL NAVBAR & SCREENSHOT STYLES
       ══════════════════════════════════════════════════════ */
    .floating-header-wrapper {
      position: sticky;
      top: 0.85rem;
      z-index: 60;
      padding: 0 1rem;
      margin-bottom: 1.5rem;
    }
    .floating-navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      max-width: 1440px;
      margin: 0 auto;
      width: 100%;
    }
    .pill-brand {
      flex-shrink: 0 !important;
    }
    .pill-actions {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      background: rgba(13, 34, 23, 0.88);
      border: 1.5px solid rgba(212, 175, 55, 0.4);
      border-radius: 9999px;
      padding: 0.35rem 0.85rem;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.45);
      flex-shrink: 0 !important;
      z-index: 10;
      white-space: nowrap;
    }
    .pill-nav-links {
      display: flex;
      align-items: center;
      gap: 0.15rem;
      background: rgba(13, 34, 23, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
      padding: 0.3rem 0.6rem;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.3);
      overflow-x: auto;
      scrollbar-width: none;
      flex-shrink: 1;
      min-width: 0;
    }
    .pill-nav-links::-webkit-scrollbar { display: none; }
    .pill-nav-btn {
      padding: 0.4rem 0.75rem;
      font-size: 0.82rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    @media (max-width: 1240px) {
      .pill-nav-links {
        display: none !important;
      }
      .lg-hide {
        display: flex !important;
      }
    }
    @media (min-width: 1241px) {
      .lg-hide {
        display: none !important;
      }
    }
    .pill-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1.35rem;
      background: rgba(13, 34, 23, 0.72);
      border: 1px solid rgba(212, 175, 55, 0.4);
      border-radius: 9999px;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      text-decoration: none;
      color: #FFF;
      font-family: var(--font-heading);
      font-size: 1.25rem;
      font-weight: 700;
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.35);
      transition: all 0.3s ease;
    }
    .pill-brand:hover {
      border-color: var(--gold-primary);
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
      transform: translateY(-1px);
    }
    .pill-brand .brand-gold {
      background: linear-gradient(135deg, #F5D77F, #D4AF37, #B88628);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .pill-nav-links {
      display: flex;
      align-items: center;
      gap: 0.2rem;
      background: rgba(13, 34, 23, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 9999px;
      padding: 0.35rem 0.65rem;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.3);
    }
    .pill-nav-btn {
      background: transparent;
      border: none;
      color: #E2E8F0;
      font-family: var(--font-body);
      font-size: 0.88rem;
      font-weight: 500;
      padding: 0.45rem 1rem;
      border-radius: 9999px;
      cursor: pointer;
      position: relative;
      transition: all 0.25s ease;
      white-space: nowrap;
    }
    .pill-nav-btn:hover {
      color: #FFF;
      background: rgba(255, 255, 255, 0.05);
    }
    .pill-nav-btn.active {
      color: #FFF;
      font-weight: 600;
    }
    .pill-nav-btn.active::after {
      content: '';
      position: absolute;
      bottom: 4px;
      left: 20%;
      right: 20%;
      height: 2px;
      background: #D4AF37;
      border-radius: 2px;
      box-shadow: 0 0 8px #D4AF37;
    }
    .pill-actions {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(13, 34, 23, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 9999px;
      padding: 0.35rem 0.75rem;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.3);
    }
    .pill-icon-btn {
      background: none;
      border: none;
      color: #E2E8F0;
      cursor: pointer;
      padding: 0.35rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: color 0.2s ease, transform 0.2s ease;
    }
    .pill-icon-btn:hover {
      color: var(--gold-primary);
      transform: scale(1.1);
    }
    .pill-divider {
      width: 1px;
      height: 18px;
      background: rgba(255, 255, 255, 0.18);
    }
    .pill-flag {
      display: inline-flex;
      align-items: center;
      font-size: 1.25rem;
      filter: drop-shadow(0 2px 4px rgba(0,0,0,0.4));
    }

    /* ══════════════════════════════════════════════════════
       HERO MASTER LAYOUT (Matching Screenshot)
       ══════════════════════════════════════════════════════ */
    .hero-master-container {
      position: relative;
      overflow: hidden;
      border-radius: 2rem;
      background: radial-gradient(ellipse at 85% 15%, rgba(27, 122, 61, 0.3) 0%, transparent 55%),
                  radial-gradient(ellipse at 15% 85%, rgba(212, 175, 55, 0.15) 0%, transparent 50%),
                  linear-gradient(135deg, #021E14 0%, #032A1C 50%, #01140D 100%);
      border: 1px solid rgba(212, 175, 55, 0.35);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 0 80px rgba(0, 0, 0, 0.4);
      padding: 3.5rem 3rem;
      margin-bottom: 2.5rem;
    }
    .hero-light-cone {
      position: absolute;
      top: 0;
      right: 0;
      width: 65%;
      height: 100%;
      background: radial-gradient(circle at 100% 0%, rgba(245, 215, 127, 0.18) 0%, rgba(27, 122, 61, 0.12) 30%, transparent 70%);
      pointer-events: none;
      z-index: 1;
      mix-blend-mode: screen;
    }
    .hero-watermark-tifinagh {
      position: absolute;
      top: 2rem;
      left: 3rem;
      font-size: 1.6rem;
      font-weight: 700;
      letter-spacing: 0.3rem;
      color: rgba(212, 175, 55, 0.35);
      user-select: none;
      pointer-events: none;
      z-index: 1;
    }
    .hero-watermark-kufic {
      position: absolute;
      bottom: 1.5rem;
      left: 3rem;
      font-size: 2.4rem;
      font-family: var(--font-heading);
      letter-spacing: 0.15rem;
      color: rgba(212, 175, 55, 0.22);
      user-select: none;
      pointer-events: none;
      z-index: 1;
      line-height: 1;
    }
    .hero-master-grid {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: 3rem;
    }
    .hero-master-left {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: right;
    }
    body.lang-en .hero-master-left {
      text-align: left;
    }
    .hero-tifinagh-script {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.25rem;
      color: rgba(212, 175, 55, 0.85);
      margin-bottom: 0.75rem;
      display: inline-block;
      text-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
    }
    .hero-main-title {
      font-family: var(--font-heading);
      font-size: clamp(3rem, 6vw, 4.8rem);
      font-weight: 700;
      line-height: 1.05;
      color: #FFFFFF;
      margin-bottom: 1.25rem;
      letter-spacing: -0.02em;
    }
    .hero-main-title .gold-dz {
      background: linear-gradient(135deg, #FDE68A 0%, #D4AF37 50%, #B45309 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: inline-block;
      filter: drop-shadow(0 2px 10px rgba(212, 175, 55, 0.35));
    }
    .hero-master-desc {
      font-size: 1.15rem;
      line-height: 1.7;
      color: #E2E8F0;
      max-width: 520px;
      margin-bottom: 2.25rem;
      font-weight: 300;
    }
    .hero-welcome-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.85rem;
      padding: 0.95rem 2.2rem;
      border-radius: 9999px;
      background: linear-gradient(135deg, #ECC869 0%, #D4AF37 50%, #A8791C 100%);
      color: #051C11;
      font-family: var(--font-body);
      font-size: 1.1rem;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.35);
      box-shadow: 0 6px 28px rgba(212, 175, 55, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.6);
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      text-decoration: none;
    }
    .hero-welcome-cta:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 10px 35px rgba(212, 175, 55, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.8);
      color: #020C07;
    }
    .hero-welcome-cta .cta-icon {
      font-size: 1.2rem;
      transition: transform 0.3s ease;
    }
    .hero-welcome-cta:hover .cta-icon {
      transform: rotate(90deg) scale(1.2);
    }

    .hero-master-right {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .star-emblem-glow {
      position: absolute;
      width: 480px;
      height: 480px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(212, 175, 55, 0.28) 0%, rgba(27, 122, 61, 0.18) 45%, transparent 70%);
      filter: blur(50px);
      pointer-events: none;
      z-index: 1;
      animation: pulseGlow 6s infinite ease-in-out;
    }
    .star-emblem-frame {
      position: relative;
      z-index: 2;
      width: 100%;
      max-width: 500px;
      display: flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.85)) drop-shadow(0 0 35px rgba(212, 175, 55, 0.4));
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
    }
    .hero-master-container:hover .star-emblem-frame {
      transform: scale(1.02);
      filter: drop-shadow(0 25px 55px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 50px rgba(212, 175, 55, 0.55));
    }
    .star-emblem-frame:hover {
      transform: scale(1.03) rotate(0.5deg);
    }
    .star-emblem-frame img {
      width: 100%;
      height: auto;
      max-height: 530px;
      object-fit: contain;
      border-radius: 1.5rem;
    }

    /* ══════════════════════════════════════════════════════
       FLOATING SOS EMERGENCY BUTTON
       ══════════════════════════════════════════════════════ */
    .floating-emergency-trigger {
      position: fixed;
      bottom: 1.5rem;
      left: 1.5rem;
      z-index: 95;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: linear-gradient(135deg, #991B1B 0%, #DC2626 100%);
      color: #FFFFFF;
      border: 1.5px solid rgba(254, 202, 202, 0.4);
      border-radius: 9999px;
      padding: 0.65rem 1.25rem;
      box-shadow: 0 4px 25px rgba(220, 38, 38, 0.5);
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 0.88rem;
      font-weight: 700;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    body.lang-en .floating-emergency-trigger {
      left: auto;
      right: 1.5rem;
    }
    .floating-emergency-trigger:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 8px 30px rgba(220, 38, 38, 0.65);
    }
    .emergency-pulse-ring {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #FEF08A;
      box-shadow: 0 0 10px #FEF08A;
      animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    /* ══════════════════════════════════════════════════════
       CATEGORIES GRID ENHANCEMENTS
       ══════════════════════════════════════════════════════ */
    .category-card {
      background: rgba(13, 34, 23, 0.65);
      border: 1px solid rgba(212, 175, 55, 0.22);
      border-radius: 1.25rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
    }
    .category-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--gold-primary), transparent);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .category-card:hover {
      border-color: var(--gold-primary);
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(212, 175, 55, 0.2);
    }
    .category-card:hover::before {
      opacity: 1;
    }

    @media (max-width: 960px) {
      .hero-master-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
      }
      .hero-master-left {
        align-items: center;
        text-align: center;
      }
      body.lang-en .hero-master-left {
        text-align: center;
      }
      .hero-master-right {
        order: -1;
      }
      .star-emblem-frame {
        max-width: 320px;
      }
      .pill-nav-links {
        display: none;
      }
      .hero-watermark-tifinagh, .hero-watermark-kufic {
        display: none;
      }
    }


    /* ══════════════════════════════════════════════════════
       ULTRA-MODERN HERO ICON & SEAMLESS MASKING
       ══════════════════════════════════════════════════════ */
    .seamless-emblem-img {
      width: 100%;
      height: auto;
      max-height: 540px;
      object-fit: contain;
      -webkit-mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 78%);
      mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 50%, rgba(0,0,0,0) 78%);
      filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.95)) drop-shadow(0 0 40px rgba(212, 175, 55, 0.5));
      border: none !important;
      outline: none !important;
    }
    
    .kufic-heritage-badge {
      display: inline-flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 0.75rem 1.35rem;
      background: rgba(13, 34, 23, 0.75);
      border: 1.5px solid rgba(212, 175, 55, 0.55);
      border-radius: 1rem;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), 0 0 25px rgba(212, 175, 55, 0.25);
      margin-top: 1.5rem;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .kufic-text {
      font-family: var(--font-heading);
      font-size: 1.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      background: linear-gradient(135deg, #FFF1B0 0%, #E6C15D 40%, #D4AF37 80%, #9E7D1E 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 15px rgba(212, 175, 55, 0.4));
      line-height: 1.2;
    }
    .kufic-sub {
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      color: var(--gold-light);
      font-family: monospace, sans-serif;
      font-weight: 600;
      margin-top: 0.2rem;
      opacity: 0.9;
    }

    .ultra-modern-icon {
      width: 2.2rem;
      height: 2.2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(2, 30, 20, 0.45);
      border: 1.5px solid rgba(255, 255, 255, 0.35);
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      flex-shrink: 0;
    }
    .hero-welcome-cta:hover .ultra-modern-icon {
      transform: rotate(180deg) scale(1.15);
      box-shadow: 0 0 25px rgba(212, 175, 55, 0.9);
      background: rgba(2, 30, 20, 0.7);
    }
    @keyframes spinClockwise {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes spinCounter {
      from { transform: rotate(360deg); }
      to { transform: rotate(0deg); }
    }
    .spin-cw {
      transform-origin: center;
      animation: spinClockwise 9s linear infinite;
    }
    .spin-ccw {
      transform-origin: center;
      animation: spinCounter 6s linear infinite;
    }

    /* Vector Algeria Map Interactive Styles */
    .algeria-svg-pin {
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .algeria-svg-pin:hover {
      transform: scale(1.35);
      filter: drop-shadow(0 0 12px #D4AF37);
    }

  </style>

  <!-- Leaflet Interactive Maps (Local Offline & Fast) -->
  <link rel="stylesheet" href="leaflet/leaflet.css">
  <script src="leaflet/leaflet.js"></script>

</head>
<body>

  <!-- ══════════════════════════════════════════════════════
       OFFICIAL SOVEREIGN INSTITUTIONAL RIBBON
       ══════════════════════════════════════════════════════ -->
  <div class="sovereign-ribbon" style="background: linear-gradient(90deg, #021B12 0%, #063120 50%, #021B12 100%); border-bottom: 1px solid rgba(212,175,55,0.35); padding: 0.4rem 1.5rem; font-size: 0.75rem; color: #E2E8F0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
    <div style="display:inline-flex; align-items:center; gap:0.6rem; margin:0 auto; flex-wrap:wrap; justify-content:center;">
      <span style="display:inline-flex; align-items:center; gap:0.4rem; color:var(--gold-primary); font-weight:600;">
        <svg style="width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/></svg>
        <span data-i18n="header_ministry">الجمهورية الجزائرية الديمقراطية الشعبية — وزارة الثقافة والفنون</span>
      </span>
      <span style="color:rgba(255,255,255,0.3);">|</span>
      <span style="color:var(--text-muted); font-size:0.72rem;">المنظومة الرقمية الوطنية الموحدة للتراث والفنون 2026</span>
    </div>

    <!-- Quick Top Language Switcher Badge (Always Visible at Top of Screen) -->
    <button type="button" onclick="toggleLanguage()" id="sovereign-lang-btn" style="background:rgba(212,175,55,0.18); border:1px solid rgba(212,175,55,0.45); border-radius:1rem; padding:0.25rem 0.85rem; color:var(--gold-primary); font-size:0.75rem; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem; flex-shrink:0; transition:all 0.25s;" onmouseover="this.style.background='rgba(212,175,55,0.3)'" onmouseout="this.style.background='rgba(212,175,55,0.18)'" title="تبديل لغة الموقع / Switch Language">
      <svg style="width:0.95rem; height:0.95rem; fill:none; stroke:currentColor; stroke-width:2.2;" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"/>
        <line x1="2" y1="12" x2="22" y2="12"/>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
      <span id="sovereign-lang-label">English (EN)</span>
    </button>
  </div>


  <!-- Skip Link -->
  <a href="#main-content" class="skip-link" data-i18n="skip_to_content">تخطي إلى المحتوى الرئيسي</a>

  <!-- ══════════════════════════════════════════════════════
       FLOATING PILL NAVBAR (Matching Screenshot)
       ══════════════════════════════════════════════════════ -->
  <header class="floating-header-wrapper">
    <div class="floating-navbar">
      
      <!-- Brand Pill -->
      <a href="#home" class="pill-brand" onclick="navigateTo('home')" dir="ltr" style="direction:ltr !important; unicode-bidi:isolate; display:inline-flex; align-items:center; gap:0.65rem;">
        <img src="icon-192.png" alt="Tkahafa Dz Icon" style="width:2rem; height:2rem; border-radius:50%; object-fit:cover; border:1.5px solid var(--gold-primary); box-shadow:0 0 10px rgba(212,175,55,0.45); flex-shrink:0;">
        <span style="font-family:'Cinzel', serif; font-size:1.25rem; font-weight:800; letter-spacing:0.02em; white-space:nowrap; display:inline-flex; align-items:center; gap:0.35rem;">
          <span style="color:#FFF;">Tkahafa</span> <span class="brand-gold">Dz</span>
        </span>
      </a>

      <!-- Navigation Links Pill -->
      <nav class="pill-nav-links" aria-label="التنقل الرئيسي">
        <button type="button" class="pill-nav-btn active" data-view="home" onclick="navigateTo('home')" data-i18n="nav_home">الرئيسية</button>
        <button type="button" class="pill-nav-btn" data-view="events" onclick="navigateTo('events')" data-i18n="nav_events">الفعاليات</button>
        <button type="button" class="pill-nav-btn" data-view="atlas" onclick="navigateTo('atlas')" data-i18n="nav_atlas">التراث والآثار</button>
        <button type="button" class="pill-nav-btn" data-view="tickets" onclick="navigateTo('tickets')" data-i18n="nav_tickets">المتاحف</button>
        <button type="button" class="pill-nav-btn" data-view="artists" onclick="navigateTo('artists')" data-i18n="nav_artists">الفنانين</button>
        <button type="button" class="pill-nav-btn" data-view="cuisine" onclick="navigateTo('cuisine')" data-i18n="nav_cuisine">الطهي التراثي</button>
        <button type="button" class="pill-nav-btn" data-view="manuscripts" onclick="navigateTo('manuscripts')" data-i18n="nav_manuscripts">المخطوطات</button>
        <button type="button" class="pill-nav-btn" data-view="quiz" onclick="navigateTo('quiz')" data-i18n="nav_quiz">المسابقة</button>
        <button type="button" class="pill-nav-btn" data-view="books" onclick="navigateTo('books')" data-i18n="nav_books">المعارض والكتب</button>
        <button type="button" class="pill-nav-btn" data-view="rewards" onclick="navigateTo('rewards')" data-i18n="nav_rewards">الجواز الثقافي</button>
      </nav>

      <!-- Right Action Pill: Search + Algerian Flag + Language Switcher -->
      <div class="pill-actions">
        <!-- User Profile Button -->
        <button type="button" class="pill-icon-btn" onclick="openAuthModal()" title="حسابي / My Account" aria-label="تسجيل الدخول" id="auth-nav-btn" style="transition:all 0.3s;">
          <svg style="width:1.15rem;height:1.15rem;fill:none;stroke:currentColor;stroke-width:2;" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>
        <span class="pill-divider"></span>
        
        <!-- Search Button -->
        <button type="button" class="pill-icon-btn" onclick="openSearchModal()" title="بحث في المنصة / Search" aria-label="بحث في المنصة">
          <svg style="width:1.15rem; height:1.15rem; fill:none; stroke:currentColor; stroke-width:2.2;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <span class="pill-divider"></span>
        
        <!-- Algerian Flag -->
        <span class="pill-flag" title="الجمهورية الجزائرية الديمقراطية الشعبية">🇩🇿</span>
        <span class="pill-divider"></span>

        <!-- Prominent Language Switcher Button with Glowing Globe Icon -->
        <button type="button" class="pill-icon-btn lang-pill-btn" onclick="toggleLanguage()" id="lang-btn" title="تغيير اللغة / Switch Language" aria-label="تغيير اللغة" style="display:inline-flex; align-items:center; gap:0.35rem; padding:0.35rem 0.8rem; border-radius:2rem; background:rgba(212,175,55,0.2); border:1.5px solid rgba(212,175,55,0.55); color:var(--gold-primary); font-size:0.8rem; font-weight:700; cursor:pointer; transition:all 0.3s; box-shadow:0 0 12px rgba(212,175,55,0.3);">
          <svg style="width:1.25rem; height:1.25rem; fill:none; stroke:currentColor; stroke-width:2.2; flex-shrink:0;" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span id="lang-label" style="letter-spacing:0.02em;">English</span>
        </button>
        <span class="pill-divider"></span>

        <!-- Mobile & Tablet Drawer Hamburger Button -->
        <button type="button" class="pill-icon-btn lg-hide" onclick="toggleDrawer(true)" aria-label="القائمة الجانبية" title="القائمة الرئيسية" style="color:var(--gold-primary);">
          <svg style="width:1.35rem; height:1.35rem; fill:none; stroke:currentColor; stroke-width:2.2;" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>

    </div>
  </header>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="mobile-drawer" style="position:fixed; inset:0; z-index:100; background:rgba(0,0,0,0.75); backdrop-filter:blur(6px); display:none;" role="dialog" aria-modal="true">
    <div style="position:absolute; top:0; right:0; bottom:0; width:85%; max-width:320px; background:var(--surface-card); border-left:1px solid var(--border-subtle); padding:1.5rem; overflow-y:auto; display:flex; flex-direction:column;">
      <div style="display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border-subtle); padding-bottom:1rem; margin-bottom:1rem;">
      <!-- Drawer Language Switcher Button -->
      <button type="button" class="btn btn-outline" onclick="toggleLanguage()" style="width:100%; justify-content:center; gap:0.6rem; margin-bottom:1rem; border-color:var(--gold-primary); color:var(--gold-primary); font-weight:700; padding:0.65rem 1rem;">
        <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:2.2; flex-shrink:0;" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"/>
          <line x1="2" y1="12" x2="22" y2="12"/>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
        <span id="drawer-lang-label">تبديل اللغة / Switch to English</span>
      </button>
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <img src="icon-192.png" alt="Tkahafa Dz Icon" style="width:2.5rem; height:2.5rem; border-radius:50%; object-fit:cover; border:1.5px solid var(--gold-primary); box-shadow:0 0 10px rgba(212,175,55,0.4);">
          <div dir="ltr" style="direction:ltr !important;">
            <div style="font-family:'Cinzel', serif; font-size:1.15rem; font-weight:800; color:#FFF;">Tkahafa <span style="color:var(--gold-primary);">Dz</span></div>
            <div style="font-size:0.7rem; color:var(--text-muted);" data-i18n="brand_badge">ثقافة دز</div>
          </div>
        </div>
        <button type="button" onclick="toggleDrawer(false)" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:1.2rem;">✕</button>
      </div>

      <nav style="display:flex; flex-direction:column; gap:0.45rem;">
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('home'); toggleDrawer(false);">
          <span>🏠</span> <span data-i18n="nav_home">الرئيسية</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('events'); toggleDrawer(false);">
          <span>🎭</span> <span data-i18n="nav_events">المهرجانات والمعارض</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('atlas'); toggleDrawer(false);">
          <span>🗺️</span> <span data-i18n="nav_atlas">أطلس الآثار واليونسكو</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('tickets'); toggleDrawer(false);">
          <span>🏛️</span> <span data-i18n="nav_tickets">المتاحف وحجز التذاكر QR</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('artists'); toggleDrawer(false);">
          <span>🎨</span> <span data-i18n="nav_artists">دليل الفنانين والحرفيين</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('cuisine'); toggleDrawer(false);">
          <span>🍲</span> <span data-i18n="nav_cuisine">المائدة والطهي التراثي</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('books'); toggleDrawer(false);">
          <span>📚</span> <span data-i18n="nav_books">المعارض والكتب والأدب</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('manuscripts'); toggleDrawer(false);">
          <span>📜</span> <span data-i18n="nav_manuscripts">المخطوطات والذكاء</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('quiz'); toggleDrawer(false);">
          <span>🎮</span> <span data-i18n="nav_quiz">المسابقة الثقافية</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('rewards'); toggleDrawer(false);">
          <span>🏆</span> <span data-i18n="nav_rewards">الجواز الثقافي والمكافآت</span>
        </button>
        <button type="button" class="btn btn-gold" style="justify-content:flex-start; width:100%; margin-top:0.5rem; gap:0.6rem;" onclick="openAuthModal(); toggleDrawer(false);">
          <svg style="width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span data-i18n="auth_login_btn">تسجيل الدخول / حسابي</span>
        </button>
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; gap:0.6rem;" onclick="navigateTo('admin'); toggleDrawer(false);">
          <span>📊</span> <span data-i18n="nav_admin">لوحة الإحصائيات</span>
        </button>
      </nav>

      <div style="margin-top:auto; padding-top:1.5rem; border-top:1px solid var(--border-subtle); display:flex; flex-direction:column; gap:0.5rem;">
        <button type="button" class="btn btn-pwa" style="width:100%;" onclick="promptPWAInstall(); toggleDrawer(false);" data-i18n="pwa_install_btn">
          تثبيت التطبيق على الهاتف 📲
        </button>
        <button type="button" class="btn btn-emergency" style="width:100%;" onclick="openEmergencyModal(); toggleDrawer(false);" data-i18n="sos_btn">
          طوارئ النجدة والسلامة 🚨
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       MAIN CONTENT CONTAINER
       ══════════════════════════════════════════════════════ -->
  <main id="main-content" style="flex:1;">

    <!-- ────────────────────────────────────────────────────
         VIEW 1: HOME (Modern Animated Hero with NO Big Clunky Image)
         ──────────────────────────────────────────────────── -->
    <section id="view-home" class="app-view active" aria-labelledby="home-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <!-- Master Luxury Hero Banner matching Screenshot -->
        <div class="hero-master-container">
          <div class="hero-light-cone"></div>
          <div class="hero-watermark-tifinagh" dir="ltr">+o[ИΣΘ+</div>
          <div class="hero-watermark-kufic">ثقافة الجزائر</div>

          <div class="hero-master-grid">
            
            <!-- Left Column: Typography, Subtitle & Welcoming Button -->
            <div class="hero-master-left">
              <div class="hero-tifinagh-script" dir="ltr" style="font-family:monospace, sans-serif; font-size:1.4rem; font-weight:700; letter-spacing:0.35rem; color:#ECC869; text-shadow:0 0 15px rgba(212,175,55,0.5); margin-bottom:0.75rem;">+o[ИΣΘ+</div>
              
              <h1 class="hero-main-title" dir="ltr" style="direction:ltr !important; unicode-bidi:isolate; text-align:start; font-family:'Cinzel', serif; font-size:clamp(3.2rem, 6vw, 5.2rem); font-weight:800; line-height:1.02; margin-bottom:1.25rem;">
                <span style="color:#FFFFFF; text-shadow:0 4px 25px rgba(0,0,0,0.5);">Tkahafa</span> 
                <span class="gold-dz" style="background:linear-gradient(135deg, #FFF1B0 0%, #E6C15D 40%, #B88628 80%, #87590E 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; filter:drop-shadow(0 4px 15px rgba(212,175,55,0.45));">Dz</span>
              </h1>
              
              <p class="hero-master-desc" data-i18n="hero_platform_desc" style="font-size:1.15rem; line-height:1.75; color:#E2E8F0; max-width:540px; margin-bottom:1.75rem; font-weight:300;">
                The national digital platform of Tkahafa Dz, celebrating Algerian culture and arts.
              </p>
              
              <!-- Ultra-Modern Welcoming Button with High-Tech Cultural Icon -->
              <button type="button" class="hero-welcome-cta" onclick="scrollToCategoriesSection()" style="display:inline-flex; align-items:center; gap:1rem; padding:0.85rem 2.2rem; border-radius:9999px; background:linear-gradient(135deg, #ECC869 0%, #D4AF37 50%, #A8791C 100%); color:#051C11; font-family:var(--font-body); font-size:1.12rem; font-weight:700; border:1px solid rgba(255, 255, 255, 0.4); box-shadow:0 8px 30px rgba(212, 175, 55, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.7); cursor:pointer;">
                <span data-i18n="hero_welcome_btn" style="letter-spacing:0.01em;">ثقافة الجزائر ترحب بكم</span>
                <span class="ultra-modern-icon">
                  <svg viewBox="0 0 28 28" fill="none" style="width:1.35rem; height:1.35rem; color:#0A1C12;">
                    <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 2" class="spin-cw" />
                    <circle cx="14" cy="14" r="8" stroke="currentColor" stroke-width="1.2" opacity="0.6" stroke-dasharray="4 2" class="spin-ccw" />
                    <polygon points="14,3 16.5,11.5 25,14 16.5,16.5 14,25 11.5,16.5 3,14 11.5,11.5" fill="currentColor" />
                    <circle cx="14" cy="14" r="2.5" fill="#D4AF37" />
                  </svg>
                </span>
              </button>

              <!-- Prominent Illuminated Kufic 'ثقافة الجزائر' Calligraphy Badge requested by user -->
              <div class="kufic-heritage-badge" aria-label="ثقافة الجزائر">
                <div class="kufic-text">ثـقـافـة الـجـزائـر</div>
                <div class="kufic-sub">TKAHAFA DZ • HERITAGE OF ALGERIA</div>
              </div>

            </div>

            <!-- Right Column: 3D Eight-Pointed Star Emblem from Screenshot (Seamless Clean Blend) -->
            <div class="hero-master-right">
              <div class="star-emblem-glow"></div>
              <div class="star-emblem-frame">
                <img src="star_emblem_seamless.png" alt="Thakafa Dz Star Emblem — معالم وتراث وثقافة الجزائر" loading="eager" class="seamless-emblem-img">
              </div>
            </div>

          </div>
        </div>

        <!-- ══════════════════════════════════════════════════════
             CATEGORIES & SECTIONS DESTINATION (#categories-section)
             ══════════════════════════════════════════════════════ -->
        <div id="categories-section" style="scroll-margin-top:5.5rem; margin-bottom:3rem;">
          <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:1.5rem; flex-wrap:wrap; gap:1rem;">
            <div>
              <span class="badge" style="background:rgba(212,175,55,0.15); border-color:rgba(212,175,55,0.4); color:var(--gold-primary);" data-i18n="cat_section_badge">استكشف كنوز الجزائر</span>
              <h2 class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="cat_section_title">أقسام وتصنيفات ثقافة دز</h2>
            </div>
            <p style="color:var(--text-muted); font-size:0.9rem; max-width:480px; margin:0;" data-i18n="cat_section_subtitle">
              منصة شاملة تربطك بمهرجانات 58 ولاية، معالم اليونسكو، المتاحف الوطنية، تراث الطهي، والمخطوطات النادرة المدعومة بالذكاء الاصطناعي.
            </p>
          </div>

          <!-- 10 Core Category Cards with Hover Glow & Badges -->
          <div class="grid-3">
            
            <!-- Category 1: Festivals & Exhibitions -->
            <div class="category-card" onclick="navigateTo('events')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(212,175,55,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(212,175,55,0.4); display:flex; align-items:center; justify-content:center; color:var(--gold-primary); box-shadow:0 4px 15px rgba(212,175,55,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
                <span class="badge" style="background:rgba(27,122,61,0.25); border-color:rgba(27,122,61,0.5); color:#4ADE80;">2026</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_festivals_title">المهرجانات والمعارض</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_festivals_desc">أجندة الفعاليات الثقافية الكبرى، حجز التذاكر المباشر والوصول عبر خرائط Google Maps.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:var(--gold-primary); font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">استعراض الفعاليات ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">58 ولاية</span>
              </div>
            </div>

            <!-- Category 2: UNESCO Atlas -->
            <div class="category-card" onclick="navigateTo('atlas')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(56,189,248,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(56,189,248,0.4); display:flex; align-items:center; justify-content:center; color:#38BDF8; box-shadow:0 4px 15px rgba(56,189,248,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><path d="M3 21h18M3 10h18M5 10v11M9 10v11M15 10v11M19 10v11M12 2L2 7h20L12 2z"/></svg>
        </div>
                <span class="badge" style="background:rgba(56,189,248,0.2); border-color:rgba(56,189,248,0.4); color:#38BDF8;">UNESCO</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_atlas_title">أطلس التراث والآثار</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_atlas_desc">معالم الجزائر المصنفة عالمياً (تيمقاد، طاسيلي، جميلة) مع الملاحة الحية والإحداثيات.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#38BDF8; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">فتح الخريطة والأطلس ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">GPS دقيق</span>
              </div>
            </div>

            <!-- Category 3: Museums & QR Tickets -->
            <div class="category-card" onclick="navigateTo('tickets')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(234,179,8,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(234,179,8,0.4); display:flex; align-items:center; justify-content:center; color:#EAB308; box-shadow:0 4px 15px rgba(234,179,8,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 15h.01M7 9h.01M17 15h.01M17 9h.01M11 9h2v6h-2z"/></svg>
        </div>
                <span class="badge" style="background:rgba(234,179,8,0.2); border-color:rgba(234,179,8,0.4); color:#EAB308;">QR Pass</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_tickets_title">المتاحف وتذاكر الدخول</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_tickets_desc">حجز فوري لتذاكر زيارة المتاحف الوطنية (باردو، سيرتا، زبانة، الفنون الجميلة) وتوليد QR فوري.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#EAB308; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">حجز التذاكر الرقمية ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">فوري وآمن</span>
              </div>
            </div>

            <!-- Category 4: Artists & Crafts Directory -->
            <div class="category-card" onclick="navigateTo('artists')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(168,85,247,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(168,85,247,0.4); display:flex; align-items:center; justify-content:center; color:#C084FC; box-shadow:0 4px 15px rgba(168,85,247,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"/></svg>
        </div>
                <span class="badge" style="background:rgba(168,85,247,0.2); border-color:rgba(168,85,247,0.4); color:#C084FC;">دعم المبدعين</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_artists_title">دليل الفنانين والحرفيين</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_artists_desc">منصة التواصل مع الحرفيين، رواد الفن التشكيلي، صانعي الفخار والحلي التقليدية ودعم أعمالهم.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#C084FC; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">تصفح الفنانين والتواصل ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">مباشر</span>
              </div>
            </div>

            <!-- Category 5: Culinary Heritage -->
            <div class="category-card" onclick="navigateTo('cuisine')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(239,68,68,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(239,68,68,0.4); display:flex; align-items:center; justify-content:center; color:#F87171; box-shadow:0 4px 15px rgba(239,68,68,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
        </div>
                <span class="badge" style="background:rgba(239,68,68,0.2); border-color:rgba(239,68,68,0.4); color:#F87171;">الطهي العريق</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_cuisine_title">المائدة وفنون الطهي</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_cuisine_desc">توثيق الكسكسي الجزائري المصنف باليونسكو، الشخشوخة، الرشتة، الحلويات التقليدية وتاريخها.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#F87171; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">استكشاف المطبخ الجزائري ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">أصالة</span>
              </div>
            </div>

            <!-- Category 6: Manuscripts & AI Analysis -->
            <div class="category-card" onclick="navigateTo('manuscripts')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(16,185,129,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(16,185,129,0.4); display:flex; align-items:center; justify-content:center; color:#34D399; box-shadow:0 4px 15px rgba(16,185,129,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
                <span class="badge" style="background:rgba(16,185,129,0.2); border-color:rgba(16,185,129,0.4); color:#34D399;">AI Vision</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_manuscripts_title">المخطوطات والذكاء الاصطناعي</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_manuscripts_desc">التقط صورة لأي مخطوط أو نقش صخري ليقوم الذكاء الاصطناعي والواقع المعزز بقراءته وشرحه فوراً.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#34D399; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">فحص المخطوط بالذكاء ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">كاميرا مباشرة</span>
              </div>
            </div>

            <!-- Category 7: Cultural Quiz -->
            <div class="category-card" onclick="navigateTo('quiz')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(244,63,94,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(244,63,94,0.4); display:flex; align-items:center; justify-content:center; color:#FB7185; box-shadow:0 4px 15px rgba(244,63,94,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1h10v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34c3.48-.56 6-3.56 6-7.16V4H3v3.5c0 3.6 2.52 6.6 6 7.16z"/></svg>
        </div>
                <span class="badge" style="background:rgba(244,63,94,0.2); border-color:rgba(244,63,94,0.4); color:#FB7185;">تحديات XP</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_quiz_title">المسابقة الثقافية التفاعلية</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_quiz_desc">اختبر معلوماتك في تاريخ الجزائر وتراثها واجمع نقاط الخبرة XP والشهادات التقديرية.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#FB7185; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">بدء التحدي الآن ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">جوائز</span>
              </div>
            </div>

            <!-- Category 8: Cultural Passport & Youth -->
            <div class="category-card" onclick="navigateTo('rewards')">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(212,175,55,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(212,175,55,0.4); display:flex; align-items:center; justify-content:center; color:var(--gold-primary); box-shadow:0 4px 15px rgba(212,175,55,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M7 21v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
        </div>
                <span class="badge" style="background:rgba(212,175,55,0.2); border-color:rgba(212,175,55,0.4); color:var(--gold-primary);">وزارة الشباب</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_passport_title">الجواز الثقافي والمكافآت</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_passport_desc">شراكة مع مديريات الشباب لتقديم كوبونات، تخفيضات في النقل والتذاكر، ودعم مواهب الشباب.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:var(--gold-primary); font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">تفعيل الجواز والكوبونات ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">مكافآت حصرية</span>
              </div>
            </div>

            <!-- Category 9: AI Cultural Guide -->
            <div class="category-card" onclick="openAIAssistantModal()">
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <div style="width:3rem; height:3rem; border-radius:0.85rem; background:linear-gradient(135deg, rgba(0,240,255,0.2), rgba(16,36,25,0.8)); border:1.5px solid rgba(0,240,255,0.4); display:flex; align-items:center; justify-content:center; color:#00F0FF; box-shadow:0 4px 15px rgba(0,240,255,0.25);">
          <svg style="width:1.5rem; height:1.5rem; fill:none; stroke:currentColor; stroke-width:1.8;" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4M8 16h.01M16 16h.01"/></svg>
        </div>
                <span class="badge" style="background:rgba(0,240,255,0.2); border-color:rgba(0,240,255,0.4); color:#00F0FF;">نيون AI</span>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.35rem;" data-i18n="cat_ai_title">مساعد الذكاء الاصطناعي</h3>
                <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.5;" data-i18n="cat_ai_desc">مرشدك الذكي للإجابة عن أي استفسار ثقافي وتاريخي وتخطيط مسارات الرحلات بدقة.</p>
              </div>
              <div style="display:flex; align-items:center; justify-content:space-between; border-top:1px solid rgba(255,255,255,0.08); padding-top:0.75rem;">
                <span style="color:#00F0FF; font-size:0.8rem; font-weight:600;" data-i18n="explore_btn">محادثة المساعد الذكي ←</span>
                <span style="color:var(--text-dim); font-size:0.75rem;">فوري</span>
              </div>
            </div>

          </div>
        </div>

        <!-- Section Pillars -->
        <h2 class="font-heading" style="font-size:1.6rem; color:var(--gold-primary); margin-bottom:1.25rem;" data-i18n="home_featured_title">محاور المنصة الوطنية</h2>
        <div class="grid-3" style="margin-bottom:3rem;">
          
          <div class="card card-interactive" onclick="navigateTo('events')">
            <div class="img-wrap">
              <span class="img-tag" data-i18n="tag_festivals">مهرجانات 2026</span>
              <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=800&q=80" alt="Djemila Festival" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.4rem;" data-i18n="card_events_title">المهرجانات والمعارض</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem;" data-i18n="card_events_desc">جدول الفعاليات الثقافية في الجزائر، حجز التذاكر الفوري مع خرائط Google Maps للوصول للموقع بدقة.</p>
              <span style="color:var(--gold-primary); font-size:0.8rem; font-weight:600;" data-i18n="card_events_btn">استعراض الفعاليات ←</span>
            </div>
          </div>

          <div class="card card-interactive" onclick="navigateTo('atlas')">
            <div class="img-wrap">
              <span class="img-tag" data-i18n="tag_unesco">تراث اليونسكو</span>
              <img src="https://images.unsplash.com/photo-1596401057633-54a8fe8ef647?auto=format&fit=crop&w=800&q=80" alt="Timgad Trajan Arch" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.4rem;" data-i18n="card_atlas_title">أطلس الآثار الوطنية</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem;" data-i18n="card_atlas_desc">معالم الجزائر المصنفة عالمياً، مع إحداثيات GPS الدقيقة وتوجيه الملاحة المباشر عبر Google Maps.</p>
              <span style="color:var(--gold-primary); font-size:0.8rem; font-weight:600;" data-i18n="card_atlas_btn">فتح أطلس المعالم ←</span>
            </div>
          </div>

          <div class="card card-interactive" onclick="navigateTo('artists')">
            <div class="img-wrap">
              <span class="img-tag" data-i18n="tag_artists">دعم الإبداع</span>
              <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=800&q=80" alt="Algerian Artists" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.4rem;" data-i18n="card_artists_title">دليل الفنانين والحرفيين</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem;" data-i18n="card_artists_desc">التعريف برواد الفن الجزائري، ورشات الحرف التقليدية وإمكانية التواصل المباشر معهم لدعم المجتمع الإبداعي.</p>
              <span style="color:var(--gold-primary); font-size:0.8rem; font-weight:600;" data-i18n="card_artists_btn">تصفح الفنانين والتواصل ←</span>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 2: EVENTS & FESTIVALS
         ──────────────────────────────────────────────────── -->
    <section id="view-events" class="app-view" aria-labelledby="events-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
          <div>
            <span class="badge" data-i18n="events_badge">الأجندة الثقافية 2026</span>
            <h1 id="events-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="events_title">المهرجانات والمعارض الوطنية</h1>
            <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="events_desc">حجز تذاكر الدخول الإلكترونية والوصول الدقيق لمواقع الفعاليات عبر خرائط Google Maps</p>
          </div>
          <div style="display:flex; gap:0.5rem;">
            <button type="button" class="btn btn-outline" onclick="filterEvents('all')" data-i18n="btn_filter_all">الكل</button>
            <button type="button" class="btn btn-outline" onclick="filterEvents('theatre')" data-i18n="btn_filter_theatre">مسرح وموسيقى</button>
            <button type="button" class="btn btn-outline" onclick="filterEvents('heritage')" data-i18n="btn_filter_heritage">تراث وفنون</button>
          </div>
        </div>

        <div id="events-grid" class="grid-3"></div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 3: ATLAS & UNESCO SITES
         ──────────────────────────────────────────────────── -->
    <section id="view-atlas" class="app-view" aria-labelledby="atlas-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="atlas_badge">التراث العالمي والتاريخي</span>
          <h1 id="atlas-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="atlas_title">أطلس الآثار ومواقع اليونسكو في الجزائر</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="atlas_desc">مواقع أثرية مصنفة مع الإحداثيات الجغرافية الموثقة وروابط التوجيه المباشر عبر Google Maps</p>
        </div>

        
        <!-- ══════════════════════════════════════════════════════
             GOOGLE MAPS INTERACTIVE HERITAGE SYSTEM
             ══════════════════════════════════════════════════════ -->
        <div class="card" style="padding:1.5rem; margin-bottom:2.5rem; border-color:rgba(212,175,55,0.45); background:radial-gradient(circle at 50% 0%, #0F2A1C 0%, #071710 100%); box-shadow:0 20px 50px rgba(0,0,0,0.7);">
          
          <!-- Header and Mode Switchers -->
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; flex-wrap:wrap; gap:1rem;">
            <div>
              <div style="display:inline-flex; align-items:center; gap:0.5rem; background:rgba(212,175,55,0.15); border:1px solid rgba(212,175,55,0.4); border-radius:2rem; padding:0.25rem 0.85rem; margin-bottom:0.4rem;">
                <svg style="width:0.85rem; height:0.85rem; fill:var(--gold-primary);" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                <span style="font-size:0.75rem; color:var(--gold-primary); font-weight:700;">Google Maps الجزائر الحي والمباشر</span>
              </div>
              <h3 class="font-heading" style="font-size:1.4rem; color:#FFF; margin:0;">خريطة معالم التراث واليونسكو والأضرحة الملكية</h3>
            </div>

            <!-- Google Map View Switcher Buttons -->
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <button type="button" id="gmap-btn-sat" class="btn btn-gold" onclick="setGoogleMapMode('k')" style="padding:0.35rem 0.85rem; font-size:0.78rem; border-radius:2rem;">
                🛰️ قمر صناعي (Satellite 3D)
              </button>
              <button type="button" id="gmap-btn-road" class="btn btn-outline" onclick="setGoogleMapMode('m')" style="padding:0.35rem 0.85rem; font-size:0.78rem; border-radius:2rem;">
                🗺️ خريطة وتضاريس (Roadmap)
              </button>
              <button type="button" class="btn btn-outline" onclick="resetGoogleMapAlgeria()" style="padding:0.35rem 0.85rem; font-size:0.78rem; border-radius:2rem;">
                🇩🇿 كامل الجزائر
              </button>
            </div>
          </div>

          <!-- Quick Monument Selector Bar -->
          <div style="margin-bottom:1rem;">
            <div style="font-size:0.78rem; color:var(--text-muted); margin-bottom:0.5rem; font-weight:600;">📍 اختر معلماً للانتقال المباشر إليه عبر Google Maps:</div>
            <div id="monuments-pill-bar" style="display:flex; gap:0.5rem; overflow-x:auto; padding-bottom:0.6rem; scrollbar-width:thin;">
              <button type="button" class="gmap-monument-pill active" onclick="focusGoogleMapSite('timgad')">🏛️ تيمقاد (باتنة)</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('djemila')">🏛️ جميلة (سطيف)</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('tassili')">🏛️ طاسيلي ناجر (جانت)</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('kasbah')">🏛️ قصبة الجزائر</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('medracen')">👑 ضريح المدراسن (باتنة)</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('chretienne')">👑 الضريح الملكي الموريطاني (تيبازة)</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('tin_hinan')">👑 ضريح تين هينان (تمنراست)</button>
              <button type="button" class="gmap-monument-pill" onclick="focusGoogleMapSite('masinissa')">👑 قبر الملك ماسينيسا (قسنطينة)</button>
            </div>
          </div>
          
          <!-- Live Embedded Google Map Container -->
          <div style="position:relative; width:100%; height:520px; border-radius:1.25rem; overflow:hidden; border:2px solid rgba(212,175,55,0.45); box-shadow:0 15px 45px rgba(0,0,0,0.85);">
            
            <iframe id="google-heritage-iframe"
                    src="https://maps.google.com/maps?q=35.4844,6.4678&hl=ar&z=15&t=k&output=embed"
                    style="width:100%; height:100%; border:none; display:block; filter:contrast(1.05);"
                    loading="lazy"
                    allowfullscreen
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>

            <!-- Floating Active Monument Info Card -->
            <div id="gmap-monument-card" style="position:absolute; bottom:16px; right:16px; left:16px; max-width:480px; background:rgba(7,21,14,0.92); border:1.5px solid var(--gold-primary); border-radius:1.15rem; padding:1.25rem; box-shadow:0 20px 50px rgba(0,0,0,0.9); backdrop-filter:blur(12px); animation:slideUp 0.3s ease; z-index:10;">
              <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:0.75rem;">
                <div style="display:flex; gap:0.85rem; align-items:center;">
                  <img id="gmap-card-img" src="timgad.jpg" alt="معلم أثري" style="width:68px; height:68px; border-radius:0.75rem; object-fit:cover; border:1.5px solid var(--gold-primary); box-shadow:0 0 10px rgba(212,175,55,0.4); flex-shrink:0;">
                  <div>
                    <h4 id="gmap-card-title" class="font-heading" style="color:#FFF; font-size:1.15rem; margin:0 0 0.2rem 0;">تيمقاد الأثرية (قوس تراجان)</h4>
                    <div style="display:flex; gap:0.4rem; align-items:center; flex-wrap:wrap;">
                      <span id="gmap-card-wilaya" style="font-size:0.72rem; color:var(--gold-light); font-weight:600;">ولاية باتنة (05)</span>
                      <span id="gmap-card-badge" class="badge" style="font-size:0.65rem; padding:0.15rem 0.5rem; background:rgba(212,175,55,0.2); border-color:rgba(212,175,55,0.4);">UNESCO 1982</span>
                    </div>
                  </div>
                </div>
                <button type="button" onclick="document.getElementById('gmap-monument-card').style.display='none'" style="background:none; border:none; color:#94A3B8; font-size:1.3rem; cursor:pointer; line-height:1;" aria-label="إخفاء البطاقة">✕</button>
              </div>
              
              <p id="gmap-card-desc" style="color:#CBD5E1; font-size:0.82rem; margin:0 0 0.85rem 0; line-height:1.5;">جوهرة العمارة الرومانية في إفريقيا شيدها الإمبراطور تراجان عام 100م بنظام رقعة الشطرنج، مع قوس تراجان الشامخ والمكتبة الرومانية ومسرح الـ 3500 متفرج.</p>
              
              <div style="display:flex; gap:0.6rem; flex-wrap:wrap;">
                <a id="gmap-card-direct-link" href="https://www.google.com/maps/dir/?api=1&destination=35.4844,6.4678" target="_blank" rel="noopener" class="btn btn-gold" style="flex:1; justify-content:center; padding:0.45rem 0.9rem; font-size:0.78rem; text-decoration:none;">
                  <svg style="width:0.95rem; height:0.95rem; fill:none; stroke:currentColor; stroke-width:2.2; margin-left:0.3rem;" viewBox="0 0 24 24"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                  <span>التوجيه المباشر في Google Maps 📍</span>
                </a>
                <button type="button" class="btn btn-outline" onclick="navigateTo('tickets')" style="padding:0.45rem 0.9rem; font-size:0.78rem;">
                  حجز تذكرة QR 🎟️
                </button>
              </div>
            </div>

          </div>
          
          <!-- Bottom hint -->
          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:0.85rem; font-size:0.8rem; color:var(--text-muted); flex-wrap:wrap; gap:0.5rem;">
            <span>🗺️ خريطة Google Maps تدعم التكبير، التحريك، والرؤية الفضائية ثلاثية الأبعاد للأضرحة والمعالم الجزائرية.</span>
            <span style="color:var(--gold-primary); font-weight:600;">إحداثيات GPS رسمية موثقة 🇩🇿</span>
          </div>
        </div>

        <div id="atlas-grid" class="grid-3"></div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 4: MUSEUMS & TICKETS
         ──────────────────────────────────────────────────── -->
    <section id="view-tickets" class="app-view" aria-labelledby="tickets-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="tickets_badge">الشبكة المتحفية الوطنية</span>
          <h1 id="tickets-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="tickets_title">المتاحف الوطنية وحجز التذاكر الإلكترونية</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="tickets_desc">احجز زيارتك للمتاحف الرسمية واحصل على تذكرة QR فورية مع موقع المتحف الدقيق على الخريطة</p>
        </div>

        <div id="museums-grid" class="grid-3"></div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 5: ARTISTS DIRECTORY
         ──────────────────────────────────────────────────── -->
    <section id="view-artists" class="app-view" aria-labelledby="artists-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="artists_badge">المجتمع الإبداعي الجزائري</span>
          <h1 id="artists-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="artists_title">دليل الفنانين والحرفيين — تواصل ودعم</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="artists_desc">تعريف بالرواد والمعاصرين وتسهيل التواصل معهم لطلب الأعمال ودعم الإنتاج الفني والحرفي</p>
        </div>

        <div id="artists-grid" class="grid-3"></div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 6: CUISINE
         ──────────────────────────────────────────────────── -->
    <section id="view-cuisine" class="app-view" aria-labelledby="cuisine-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="cuisine_badge">التراث اللامادي</span>
          <h1 id="cuisine-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="cuisine_title">المائدة الجزائرية وفنون الطهي الأصيل</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="cuisine_desc">أطباق وحلويات تقليدية مصنفة في التراث الإنساني لليونسكو مع تفاصيل تاريخها ومكوناتها</p>
        </div>

        <div id="cuisine-grid" class="grid-3"></div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 7: MANUSCRIPTS
         ──────────────────────────────────────────────────── -->
    <section id="view-manuscripts" class="app-view" aria-labelledby="manuscripts-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="manuscripts_badge">الذكاء الاصطناعي والواقع المعزز</span>
          <h1 id="manuscripts-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="manuscripts_title">مختبر قراءة وترجمة المخطوطات الذكي</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="manuscripts_desc">التقط صورة لمخطوطة أو ارفعها، وسيقوم الذكاء الاصطناعي بفك الخط المغربي وترجمتها وتحليل طبقات الواقع المعزز AR</p>
        </div>

        <div class="card" style="padding:1.75rem; margin-bottom:2rem;">
          <div style="display:flex; flex-wrap:wrap; gap:1.5rem; align-items:center;">
            
            <div style="flex:1; min-width:280px;">
              <h2 class="font-heading" style="font-size:1.35rem; color:var(--gold-light); margin-bottom:0.75rem;" data-i18n="ms_subheading">تصوير مخطوط جديد أو اختيار نموذج تاريخي</h2>
              <p style="color:var(--text-muted); font-size:0.875rem; margin-bottom:1.25rem;" data-i18n="ms_subdesc">يمكنك استخدام كاميرا هاتفك لتصوير أي وثيقة أو اختيار أحد المخطوطات الوطنية المحفوظة بخزائن الهامل وأدرار وتلمسان.</p>
              
              <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
                <label class="btn btn-gold" style="cursor:pointer;">
                  <svg style="width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                  <span data-i18n="ms_upload_btn">التقاط / رفع صورة مخطوط</span>
                  <input type="file" accept="image/*" id="manuscript-input" style="display:none;" onchange="handleManuscriptUpload(event)">
                </label>
                <button type="button" class="btn btn-outline" onclick="loadSampleManuscript('hamel')" data-i18n="ms_sample_hamel">مخطوط زاوية الهامل</button>
                <button type="button" class="btn btn-outline" onclick="loadSampleManuscript('tlemcen')" data-i18n="ms_sample_tlemcen">مخطوط فلك تلمسان</button>
              </div>
            </div>

            <div style="flex:1; min-width:280px; text-align:center;">
              <div id="manuscript-preview-wrap" style="position:relative; width:100%; height:260px; border-radius:1rem; overflow:hidden; border:2px dashed var(--border-subtle); background:#06120B;">
                <img id="manuscript-preview-img" src="https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=800&q=80" alt="Manuscript Preview" style="width:100%; height:100%; object-fit:cover;">
                <div id="ar-scanline" style="display:none; position:absolute; top:0; left:0; right:0; height:4px; background:var(--neon-cyan); box-shadow:0 0 15px var(--neon-cyan);"></div>
              </div>
            </div>

          </div>
        </div>

        <div id="manuscript-result" class="card" style="padding:1.5rem; display:block; border-color:var(--gold-primary);">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.5rem;">
            <div style="display:flex; align-items:center; gap:0.5rem;">
              <span class="badge" style="background:rgba(0,240,255,0.15); color:var(--neon-cyan); border-color:var(--neon-cyan);">AI Engine</span>
              <h3 id="ms-title" class="font-heading" style="font-size:1.25rem; color:#FFF;">مخطوط خزانة زاوية الهامل — القرن 11 هـ</h3>
            </div>
            <button type="button" class="btn btn-outline" onclick="toggleARLayers()" style="font-size:0.775rem;" data-i18n="ms_ar_toggle">
              معاينة طبقات الواقع المعزز (AR Layers)
            </button>
          </div>

          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.25rem;">
            <div style="background:rgba(0,0,0,0.3); padding:1rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.06);">
              <h4 style="color:var(--gold-light); font-size:0.85rem; margin-bottom:0.5rem;" data-i18n="ms_read_text_label">النص المقروء بالخط المغربي المبسوط:</h4>
              <p id="ms-text" style="font-size:1.05rem; line-height:1.8; color:#F8FAFC;">
                «الحمد لله الذي زيّن سماء المعارف بأنوار الحكمة، وصلى الله على سيدنا محمد مفتاح الرحمة.. هذا تقييد في بيان منازل النجوم ومواقيت الفصول على ما جرى به عمل أهل المغرب الأوسط والجزائر المحروسة..»
              </p>
            </div>
            <div style="background:rgba(0,0,0,0.3); padding:1rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.06);">
              <h4 style="color:var(--gold-light); font-size:0.85rem; margin-bottom:0.5rem;" data-i18n="ms_explanation_label">الشرح الدلالي والسياق التاريخي:</h4>
              <p id="ms-desc" style="color:var(--text-muted); font-size:0.85rem; line-height:1.6;">
                وثيقة فلكية وتاريخية توثق استخدام الحسابات الفلكية لحساب التقويم الفلاحي ومواسم الزراعة، مكتوبة بحبر سرياني طبيعي مستخرج من الصمغ والعفص، ومحفوظة بنظام ترميم يدوي أصيل.
              </p>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 8: CULTURAL QUIZ
         ──────────────────────────────────────────────────── -->
    <section id="view-quiz" class="app-view" aria-labelledby="quiz-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem; text-align:center;">
          <span class="badge" data-i18n="quiz_badge">مسابقة الثقافة الجزائرية</span>
          <h1 id="quiz-heading" class="font-heading" style="font-size:2.2rem; color:#FFF; margin-top:0.4rem;" data-i18n="quiz_title">مسابقة عباقرة التراث والفنون</h1>
          <p style="color:var(--text-muted); font-size:0.95rem; max-width:600px; margin:0 auto;" data-i18n="quiz_desc">اختبر معلوماتك في تاريخ ومعالم وموسيقى وطهي الجزائر واربح نقاط خبرة XP وكوبونات تضاف مباشرة لجوازك الثقافي!</p>
        </div>

        <div class="card" style="max-width:680px; margin:0 auto; padding:2rem; border-color:var(--gold-primary);">
          
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem; border-bottom:1px solid var(--border-subtle); padding-bottom:1rem;">
            <span style="font-size:0.85rem; color:var(--gold-light);" id="quiz-progress-text">السؤال 1 من 5</span>
            <span class="badge" id="quiz-score-badge">النقاط: 0 XP</span>
          </div>

          <h3 id="quiz-question" class="font-heading" style="font-size:1.35rem; color:#FFF; margin-bottom:1.5rem; min-height:3rem;"></h3>
          <div id="quiz-options" style="display:flex; flex-direction:column; gap:0.75rem; margin-bottom:1.5rem;"></div>
          <div id="quiz-feedback" style="display:none; padding:1rem; border-radius:0.75rem; margin-bottom:1.5rem; font-size:0.875rem;"></div>

          <div style="display:flex; justify-content:flex-end;">
            <button type="button" class="btn btn-gold" id="quiz-next-btn" style="display:none;" onclick="nextQuizQuestion()" data-i18n="quiz_next_btn">السؤال التالي ←</button>
          </div>

        </div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 9: PASSPORT & YOUTH
         ──────────────────────────────────────────────────── -->
    <section id="view-rewards" class="app-view" aria-labelledby="rewards-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="passport_badge">برنامج السفير الثقافي والشراكة الشبابية</span>
          <h1 id="rewards-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="passport_title">جواز السفير الثقافي — دعم الشباب والمكافآت</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="passport_desc">بالتنسيق مع وزارة الشباب والرياضة ومديريات الشباب عبر 58 ولاية: نقاط، كوبونات تخفيض، وامتيازات الإقامة الثقافية</p>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.75rem; margin-bottom:2.5rem;">
          
          <div class="card" style="background:radial-gradient(circle at 70% 30%, #153A26 0%, #07150E 90%); border:2px solid var(--gold-primary); padding:1.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem;">
              <div>
                <span class="badge" style="font-size:0.65rem;" data-i18n="pass_country">الجمهورية الجزائرية الديمقراطية الشعبية</span>
                <h3 class="font-heading" style="font-size:1.5rem; color:#FFF; margin-top:0.25rem;" data-i18n="pass_card_title">جواز السفير الثقافي</h3>
                <span style="font-size:0.75rem; color:var(--gold-light);">PASSEPORT CULTUREL DZ</span>
              </div>
              <div class="icon-medallion" style="border-color:var(--gold-primary);">
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </div>
            </div>

            <div style="margin-bottom:1.25rem;">
              <div style="font-size:0.75rem; color:var(--text-dim);" data-i18n="pass_holder_label">اسم حامل الجواز:</div>
              <div style="font-size:1.1rem; font-weight:700; color:#FFF;" id="passport-holder-name" data-i18n="pass_default_user">مواطن جزائري مستكشف</div>
              <div style="font-size:0.75rem; color:var(--gold-light); margin-top:0.2rem;">ID: DZ-CUL-2026-9948</div>
            </div>

            <div style="margin-bottom:1.25rem;">
              <div style="display:flex; justify-content:space-between; font-size:0.8rem; margin-bottom:0.35rem;">
                <span style="color:var(--text-muted);"><span data-i18n="pass_level">المستوى:</span> <strong style="color:var(--gold-primary);" data-i18n="pass_level_name">سفير التراث (المستوى 4)</strong></span>
                <span style="color:var(--gold-light);" id="passport-xp-display">5,200 / 6,000 XP</span>
              </div>
              <div style="width:100%; height:8px; background:rgba(255,255,255,0.1); border-radius:9999px; overflow:hidden;">
                <div id="passport-xp-bar" style="width:86%; height:100%; background:linear-gradient(90deg, var(--emerald-accent), var(--gold-primary));"></div>
              </div>
            </div>

            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <span class="badge" data-i18n="badge_badge1">شاركت في 12 فعالية</span>
              <span class="badge" data-i18n="badge_badge2">مسح 8 معالم</span>
              <span class="badge" data-i18n="badge_badge3">متطوع معتمد</span>
            </div>
          </div>

          <div class="card" style="padding:1.75rem;">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1rem;">
              <div class="icon-medallion" style="border-color:var(--emerald-light); color:var(--emerald-light);">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <h3 class="font-heading" style="font-size:1.25rem; color:#FFF;" data-i18n="youth_partnership_title">فضاء الشباب ووزارة الشباب والرياضة</h3>
                <span style="font-size:0.75rem; color:var(--text-dim);" data-i18n="youth_partnership_sub">الشراكة الاستراتيجية لدعم فئة الشباب عبر 58 ولاية</span>
              </div>
            </div>

            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1.25rem; line-height:1.6;" data-i18n="youth_partnership_desc">
              تتيح بطاقتك الثقافية الاستفادة من شبكة بيوت الشباب (Auberges de Jeunesse) بأسعار رمزية عند التنقل لحضور المهرجانات الوطنية، واحتساب ساعات التطوع الثقافي.
            </p>

            <div style="display:flex; flex-direction:column; gap:0.6rem;">
              <div style="background:rgba(255,255,255,0.03); padding:0.65rem 0.85rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.06); display:flex; justify-content:space-between; align-items:center;">
                <div>
                  <div style="font-size:0.825rem; color:#FFF; font-weight:600;" data-i18n="coupon_hostel_title">تخفيض 40% على بيوت الشباب (DJS)</div>
                  <div style="font-size:0.7rem; color:var(--text-dim);" data-i18n="coupon_hostel_desc">صالح بجميع الولايات أثناء المهرجانات</div>
                </div>
                <button type="button" class="btn btn-outline" style="padding:0.35rem 0.75rem; font-size:0.75rem;" onclick="claimCoupon('DJS-YOUTH-40')" data-i18n="btn_use_coupon">استخدام</button>
              </div>

              <div style="background:rgba(255,255,255,0.03); padding:0.65rem 0.85rem; border-radius:0.75rem; border:1px solid rgba(255,255,255,0.06); display:flex; justify-content:space-between; align-items:center;">
                <div>
                  <div style="font-size:0.825rem; color:#FFF; font-weight:600;" data-i18n="coupon_museum_title">دخول مجاني للمتاحف الوطنية (أيام الجمعة)</div>
                  <div style="font-size:0.7rem; color:var(--text-dim);" data-i18n="coupon_museum_desc">لحاملي بطاقة الشاب الثقافية دون 30 سنة</div>
                </div>
                <button type="button" class="btn btn-outline" style="padding:0.35rem 0.75rem; font-size:0.75rem;" onclick="claimCoupon('FREE-MUSEUM-FRI')" data-i18n="btn_activate_coupon">تفعيل</button>
              </div>
            </div>

          </div>

        </div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 10: TRACKING & PAYMENT
         ──────────────────────────────────────────────────── -->
    <section id="view-tracking" class="app-view" aria-labelledby="tracking-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem;">
          <span class="badge" data-i18n="tracking_badge">التجارة والحرف الإلكترونية</span>
          <h1 id="tracking-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="tracking_title">بوابة الدفع الإلكتروني وتتبع طرود الحرف</h1>
          <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="tracking_desc">ادفع بأمان عبر البطاقة الذهبية أو CIB وتتبع مسار شحنتك الحرفية من الورشة إلى باب منزلك</p>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:1.75rem;">
          
          <div class="card" style="padding:1.75rem;">
            <h3 class="font-heading" style="font-size:1.3rem; color:var(--gold-light); margin-bottom:1rem;" data-i18n="tracking_box_title">تتبع مسار الطرد (بريد الجزائر / ياليدين)</h3>
            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1.25rem;" data-i18n="tracking_box_desc">أدخل رقم التتبع الخاص بطلبك الفني أو التذكرة لمتابعة وصوله الحي عبر شبكة النقل الوطنية:</p>
            
            <div style="display:flex; gap:0.5rem; margin-bottom:1.5rem;">
              <input type="text" id="track-number-input" value="DZ-78491-ALG" placeholder="DZ-78491-ALG" style="flex:1; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.65rem 1rem; border-radius:0.75rem; font-family:inherit; font-size:0.85rem;">
              <button type="button" class="btn btn-gold" onclick="searchTracking()" data-i18n="btn_track_shipment">تتبع الشحنة</button>
            </div>

            <div id="tracking-timeline" class="timeline-border" style="border-right:2px solid var(--gold-primary); padding-right:1.25rem; display:flex; flex-direction:column; gap:1.25rem;">
              <div>
                <div style="font-size:0.85rem; color:#FFF; font-weight:600;" data-i18n="timeline_step1">1. تأكيد الطلب من ورشة الحرفي (تيزي وزو)</div>
                <div style="font-size:0.725rem; color:var(--text-dim);" data-i18n="timeline_step1_sub">تم تجهيز القطعة الفنية وتغليفها الآمن — مكتمل</div>
              </div>
              <div>
                <div style="font-size:0.85rem; color:#FFF; font-weight:600;" data-i18n="timeline_step2">2. الاستلام في مركز بريد الجزائر / Express</div>
                <div style="font-size:0.725rem; color:var(--text-dim);" data-i18n="timeline_step2_sub">تسجيل الطرد في مركز الفرز الولائي — مكتمل</div>
              </div>
              <div style="color:var(--gold-light);">
                <div style="font-size:0.85rem; font-weight:700;" data-i18n="timeline_step3">3. جاري التوزيع في الولاية الوجهة (الجزائر العاصمة)</div>
                <div style="font-size:0.725rem; color:var(--neon-cyan);" data-i18n="timeline_step3_sub">الطرد الآن مع الموزع — متوقع التسليم اليوم</div>
              </div>
            </div>
          </div>

          <div class="card" style="padding:1.75rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
              <h3 class="font-heading" style="font-size:1.3rem; color:var(--gold-light);" data-i18n="payment_box_title">بوابة الدفع الإلكتروني الوطني الآمن</h3>
              <div style="display:flex; gap:0.4rem;">
                <span class="badge" style="background:#0F3520; color:#4ADE80;">Edahabia</span>
                <span class="badge" style="background:#1E3A8A; color:#60A5FA;">CIB</span>
              </div>
            </div>

            <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1.25rem;" data-i18n="payment_box_desc">دعم كامل لبطاقات الدفع الإلكتروني الصادرة عن البنوك الجزائرية ومؤسسة بريد الجزائر بتشفير عالي:</p>

            <form onsubmit="handlePaymentSubmit(event)" style="display:flex; flex-direction:column; gap:0.85rem;">
              <div>
                <label style="font-size:0.75rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;" data-i18n="card_num_label">رقم البطاقة (16 رقماً):</label>
                <input type="text" placeholder="XXXX XXXX XXXX XXXX" maxlength="19" required style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.65rem 0.85rem; border-radius:0.75rem; font-family:monospace; font-size:0.9rem;">
              </div>

              <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
                <div>
                  <label style="font-size:0.75rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;" data-i18n="card_exp_label">تاريخ الانتهاء:</label>
                  <input type="text" placeholder="MM/YY" maxlength="5" required style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.65rem 0.85rem; border-radius:0.75rem; font-family:monospace; font-size:0.9rem;">
                </div>
                <div>
                  <label style="font-size:0.75rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;">CVV2:</label>
                  <input type="password" placeholder="•••" maxlength="3" required style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.65rem 0.85rem; border-radius:0.75rem; font-family:monospace; font-size:0.9rem;">
                </div>
              </div>

              <div style="background:rgba(212,175,55,0.08); padding:0.75rem; border-radius:0.75rem; font-size:0.8rem; color:var(--gold-light);" data-i18n="sample_amount">
                المبلغ التجريبي: <strong>500.00 دج</strong> (تذكرة دخول متحف + دعم حرفي)
              </div>

              <button type="submit" class="btn btn-gold" style="width:100%; margin-top:0.5rem;" data-i18n="btn_confirm_pay">
                تأكيد الدفع الإلكتروني المشفر
              </button>
            </form>
          </div>

        </div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 11: LENS
         ──────────────────────────────────────────────────── -->
    <section id="view-lens" class="app-view" aria-labelledby="lens-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="margin-bottom:2rem; text-align:center;">
          <span class="badge" data-i18n="lens_badge">رؤية حاسوبية ومعالجة بكسلات</span>
          <h1 id="lens-heading" class="font-heading" style="font-size:2.2rem; color:#FFF; margin-top:0.4rem;" data-i18n="lens_title">الماسح البصري الذكي للمعالم الأثرية</h1>
          <p style="color:var(--text-muted); font-size:0.95rem; max-width:620px; margin:0 auto;" data-i18n="lens_desc">وجّه كاميرا هاتفك نحو أي معلم أثري أو ارفع صورة، وسيقوم النظام بتحليل البكسلات ومطابقتها مع قاعدة بيانات المعالم بدقة حقيقية</p>
        </div>

        <div class="card" style="max-width:720px; margin:0 auto; padding:1.5rem; border-color:var(--gold-primary);">
          
          <div style="position:relative; width:100%; height:340px; background:#000; border-radius:1rem; overflow:hidden; margin-bottom:1.25rem;">
            <video id="lens-video" autoplay playsinline muted style="width:100%; height:100%; object-fit:cover; display:none;"></video>
            <canvas id="lens-canvas" style="width:100%; height:100%; object-fit:contain; background:#040906;"></canvas>
            
            <div id="lens-overlay" style="position:absolute; inset:0; pointer-events:none; border:2px dashed rgba(212,175,55,0.4); border-radius:1rem; margin:1rem; display:flex; align-items:center; justify-content:center;">
              <span style="background:rgba(0,0,0,0.6); color:var(--gold-light); font-size:0.8rem; padding:0.35rem 0.75rem; border-radius:9999px;" data-i18n="lens_align_tip">
                قم بمحاذاة المعلم داخل الإطار
              </span>
            </div>
          </div>

          <div style="display:flex; justify-content:center; gap:0.75rem; flex-wrap:wrap; margin-bottom:1.25rem;">
            <button type="button" class="btn btn-gold" id="btn-camera-toggle" onclick="startLiveCamera()">
              <svg style="width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <span data-i18n="btn_start_camera">تشغيل كاميرا الهاتف الحية</span>
            </button>
            <label class="btn btn-outline" style="cursor:pointer;">
              <svg style="width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              <span data-i18n="btn_upload_monument">رفع صورة معلم</span>
              <input type="file" accept="image/*" id="lens-file-input" style="display:none;" onchange="handleLensUpload(event)">
            </label>
            <button type="button" class="btn btn-outline" onclick="simulateMonumentDetection('timgad')" data-i18n="btn_sim_timgad">تجربة تيمقاد</button>
            <button type="button" class="btn btn-outline" onclick="simulateMonumentDetection('kasbah')" data-i18n="btn_sim_kasbah">تجربة القصبة</button>
          </div>

          <div id="lens-result" style="display:none; background:rgba(19,48,33,0.8); border:1px solid var(--gold-primary); padding:1.25rem; border-radius:1rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
              <h3 id="det-name" class="font-heading" style="font-size:1.35rem; color:#FFF;">تيمقاد — قوس تراجان</h3>
              <span id="det-confidence" class="badge">تطابق: 97.4%</span>
            </div>
            <p id="det-desc" style="color:var(--text-muted); font-size:0.875rem; margin-bottom:0.75rem;"></p>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
              <a id="det-map-link" href="https://www.google.com/maps/search/?api=1&query=35.4844,6.4678" target="_blank" rel="noopener" class="btn btn-gold" style="padding:0.4rem 0.85rem; font-size:0.775rem;" data-i18n="btn_det_maps">
                عرض الموقع الدقيق على Google Maps
              </a>
              <button type="button" class="btn btn-outline" onclick="navigateTo('tickets')" style="padding:0.4rem 0.85rem; font-size:0.775rem;" data-i18n="btn_det_book">
                حجز تذكرة الزيارة
              </button>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ────────────────────────────────────────────────────
         VIEW 12: ADMIN DASHBOARD
         ──────────────────────────────────────────────────── -->

  <!-- ══════════════════════════════════════════════════════
       BOOKS & EXHIBITIONS SECTION
       ══════════════════════════════════════════════════════ -->
  <section id="view-books" class="app-view" aria-labelledby="books-heading">
    <div class="container" style="padding-top:2rem;padding-bottom:4rem;">

      <div style="text-align:center;margin-bottom:3rem;">
        <span class="badge" style="background:rgba(212,175,55,0.15);color:var(--gold-primary);border:1px solid rgba(212,175,55,0.3);padding:0.35rem 1.1rem;border-radius:2rem;display:inline-block;margin-bottom:1rem;" data-i18n="books_badge">معارض ● ثقافة ● إبداع جزائري</span>
        <h2 id="books-heading" class="section-title" data-i18n="books_title">المعارض والثقافة الجزائرية</h2>
        <p class="section-subtitle" style="max-width:720px;margin:0 auto;" data-i18n="books_subtitle">الصالون الدولي للكتاب بالجزائر · أبرز الكتب والروايات الجزائرية الموثقة · الإشعاع الثقافي على المستوى القاري والعالمي</p>
      </div>

      <!-- SILA Feature Card -->
      <div style="background:linear-gradient(135deg,#0D2217,#133021,#0A1C12);border:1.5px solid rgba(212,175,55,0.35);border-radius:1.5rem;padding:2.5rem;margin-bottom:3rem;position:relative;overflow:hidden;">
        <div style="position:absolute;top:-50px;right:-50px;width:220px;height:220px;background:radial-gradient(circle,rgba(212,175,55,0.07),transparent 70%);pointer-events:none;"></div>
        <div style="position:absolute;bottom:-30px;left:-30px;width:160px;height:160px;background:radial-gradient(circle,rgba(27,122,61,0.07),transparent 70%);pointer-events:none;"></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center;">
          <div>
            <div style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(212,175,55,0.15);border:1px solid rgba(212,175,55,0.3);border-radius:2rem;padding:0.3rem 0.9rem;margin-bottom:1.25rem;">
              <svg style="width:0.85rem;height:0.85rem;fill:var(--gold-primary);" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <span style="font-size:0.75rem;color:var(--gold-primary);font-weight:600;" data-i18n="sila_badge">الصالون الدولي للكتاب — SILA 2024</span>
            </div>
            <h3 class="font-heading" style="font-size:1.8rem;color:#FFF;margin-bottom:0.75rem;line-height:1.3;" data-i18n="sila_title">الصالون الدولي للكتاب بالجزائر</h3>
            <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:1.5rem;line-height:1.7;" data-i18n="sila_desc">تظاهرة ثقافية كبرى تُقام سنويًا بقصر المعارض — محمد بوضياف، الجزائر العاصمة. أسسه وزير الثقافة عام 1996، وبلغ في دورته الـ28 مشاركة أكثر من 50 دولة وأزيد من 600 ناشر وما يفوق المليون زائر.</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:1.5rem;">
              <div style="background:rgba(0,0,0,0.3);border:1px solid rgba(212,175,55,0.2);border-radius:0.75rem;padding:0.5rem 1rem;text-align:center;">
                <div style="font-size:0.65rem;color:var(--text-dim);text-transform:uppercase;margin-bottom:2px;" data-i18n="sila_edition">الدورة</div>
                <div style="font-size:1.2rem;font-weight:800;color:var(--gold-primary);">28</div>
              </div>
              <div style="background:rgba(0,0,0,0.3);border:1px solid rgba(212,175,55,0.2);border-radius:0.75rem;padding:0.5rem 1rem;text-align:center;">
                <div style="font-size:0.65rem;color:var(--text-dim);text-transform:uppercase;margin-bottom:2px;" data-i18n="sila_countries">دولة</div>
                <div style="font-size:1.2rem;font-weight:800;color:var(--gold-primary);">50+</div>
              </div>
              <div style="background:rgba(0,0,0,0.3);border:1px solid rgba(212,175,55,0.2);border-radius:0.75rem;padding:0.5rem 1rem;text-align:center;">
                <div style="font-size:0.65rem;color:var(--text-dim);text-transform:uppercase;margin-bottom:2px;" data-i18n="sila_publishers">ناشر</div>
                <div style="font-size:1.2rem;font-weight:800;color:var(--gold-primary);">600+</div>
              </div>
              <div style="background:rgba(0,0,0,0.3);border:1px solid rgba(212,175,55,0.2);border-radius:0.75rem;padding:0.5rem 1rem;text-align:center;">
                <div style="font-size:0.65rem;color:var(--text-dim);text-transform:uppercase;margin-bottom:2px;" data-i18n="sila_visitors">زائر</div>
                <div style="font-size:1.2rem;font-weight:800;color:var(--gold-primary);">1M+</div>
              </div>
            </div>
            <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
              <button type="button" class="btn btn-gold" style="font-size:0.85rem;" data-i18n="sila_register_btn">التسجيل للمشاركة</button>
              <button type="button" class="btn btn-outline" style="font-size:0.85rem;" data-i18n="sila_catalog_btn">كتالوج الكتب 2024</button>
            </div>
          </div>
          <div style="text-align:center;">
            <div style="background:linear-gradient(135deg,rgba(212,175,55,0.08),rgba(27,122,61,0.12));border:1px solid rgba(212,175,55,0.2);border-radius:1.25rem;padding:2rem;display:flex;flex-direction:column;align-items:center;gap:1rem;">
              <svg width="90" height="90" viewBox="0 0 90 90" fill="none">
                <rect x="8" y="6" width="42" height="58" rx="5" fill="rgba(212,175,55,0.08)" stroke="rgba(212,175,55,0.3)" stroke-width="1.5"/>
                <rect x="20" y="6" width="42" height="58" rx="5" fill="rgba(212,175,55,0.1)" stroke="rgba(212,175,55,0.4)" stroke-width="1.5"/>
                <rect x="34" y="6" width="44" height="60" rx="5" fill="#0D2217" stroke="rgba(212,175,55,0.7)" stroke-width="2"/>
                <line x1="43" y1="20" x2="70" y2="20" stroke="rgba(212,175,55,0.5)" stroke-width="1.5"/>
                <line x1="43" y1="28" x2="70" y2="28" stroke="rgba(212,175,55,0.3)" stroke-width="1.5"/>
                <line x1="43" y1="36" x2="70" y2="36" stroke="rgba(212,175,55,0.3)" stroke-width="1.5"/>
                <line x1="43" y1="44" x2="62" y2="44" stroke="rgba(212,175,55,0.2)" stroke-width="1.5"/>
                <circle cx="56" cy="62" r="10" fill="rgba(212,175,55,0.15)" stroke="var(--gold-primary)" stroke-width="1.5"/>
                <text x="51" y="66" fill="var(--gold-primary)" font-size="8" font-weight="bold" font-family="monospace">DZ</text>
              </svg>
              <div style="font-size:0.82rem;color:var(--text-muted);text-align:center;line-height:1.6;" data-i18n="sila_location_detail">قصر المعارض بالصافية<br>محمد بوضياف — الجزائر</div>
              <div style="display:flex;align-items:center;gap:0.5rem;font-size:0.8rem;color:var(--gold-primary);font-weight:600;">
                <svg style="width:0.9rem;height:0.9rem;fill:none;stroke:currentColor;stroke-width:2;" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span data-i18n="sila_dates">نوفمبر 2024 — قصر الصافية</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Books Grid -->
      <h3 class="font-heading" style="font-size:1.5rem;color:var(--gold-primary);margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem;">
        <svg style="width:1.3rem;height:1.3rem;fill:none;stroke:var(--gold-primary);stroke-width:2;" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <span data-i18n="books_canon_title">روائع الأدب الجزائري — مؤلفات موثقة</span>
      </h3>
      <div id="books-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:1.25rem;margin-bottom:3rem;"></div>

      <!-- International Showcases -->
      <h3 class="font-heading" style="font-size:1.4rem;color:var(--gold-primary);margin-bottom:1.25rem;" data-i18n="books_intl_title">الإشعاع الثقافي الجزائري عالميًا</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:1rem;margin-bottom:3rem;">
        <div class="card" style="text-align:center;padding:1.5rem;cursor:default;">
          <div style="font-size:2.5rem;margin-bottom:0.75rem;">🇩🇪</div>
          <div style="font-weight:700;color:#FFF;margin-bottom:0.4rem;" data-i18n="fair_frankfurt">معرض فرانكفورت الدولي</div>
          <div style="font-size:0.8rem;color:var(--text-muted);" data-i18n="fair_frankfurt_desc">تمثيل جزائري مستمر منذ 2015 — أكبر معرض كتاب عالميًا</div>
        </div>
        <div class="card" style="text-align:center;padding:1.5rem;cursor:default;">
          <div style="font-size:2.5rem;margin-bottom:0.75rem;">🇦🇪</div>
          <div style="font-weight:700;color:#FFF;margin-bottom:0.4rem;" data-i18n="fair_sharjah">معرض الشارقة الدولي</div>
          <div style="font-size:0.8rem;color:var(--text-muted);" data-i18n="fair_sharjah_desc">الجزائر ضيفة شرف 2023 — جائزة الكتاب العربي</div>
        </div>
        <div class="card" style="text-align:center;padding:1.5rem;cursor:default;">
          <div style="font-size:2.5rem;margin-bottom:0.75rem;">🇮🇹</div>
          <div style="font-weight:700;color:#FFF;margin-bottom:0.4rem;" data-i18n="fair_bologna">معرض بولونيا للكتاب</div>
          <div style="font-size:0.8rem;color:var(--text-muted);" data-i18n="fair_bologna_desc">المؤلفون الجزائريون في دائرة الضوء الدولية</div>
        </div>
        <div class="card" style="text-align:center;padding:1.5rem;cursor:default;">
          <div style="font-size:2.5rem;margin-bottom:0.75rem;">🌍</div>
          <div style="font-weight:700;color:#FFF;margin-bottom:0.4rem;" data-i18n="fair_africa">الاتحاد الأفريقي للكتاب</div>
          <div style="font-size:0.8rem;color:var(--text-muted);" data-i18n="fair_africa_desc">الجزائر رئيسة اتحاد الناشرين العرب والأفارقة</div>
        </div>
      </div>

      <!-- Submit Cultural Content -->
      <div style="background:linear-gradient(135deg,#0D2217,#133021);border:1.5px solid rgba(212,175,55,0.3);border-radius:1.5rem;padding:2.5rem;">
        <h3 class="font-heading" style="font-size:1.4rem;color:var(--gold-primary);margin-bottom:0.5rem;" data-i18n="books_submit_title">شارك إبداعك الثقافي</h3>
        <p style="color:var(--text-muted);font-size:0.9rem;margin-bottom:1.5rem;" data-i18n="books_submit_desc">لديك رواية، شعر، بحث تاريخي أو عمل فني؟ شاركه على المنصة وكن جزءًا من الإشعاع الثقافي الجزائري.</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
          <input type="text" placeholder="اسمك الكامل" class="auth-field" data-i18n-placeholder="submit_name_placeholder">
          <input type="text" placeholder="نوع العمل (رواية / شعر / بحث...)" class="auth-field">
        </div>
        <textarea rows="3" placeholder="وصف موجز لعملك..." class="auth-field" style="resize:vertical;"></textarea>
        <button type="button" class="btn btn-gold" style="margin-top:1rem;width:100%;" onclick="showToast(currentLang==='en'?'Thank you! Our team will review your submission.':'شكرًا! سيراجع فريقنا عملك قريبًا.','success')" data-i18n="submit_btn">إرسال للمراجعة والنشر</button>
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════════════
       USER PROFILE DASHBOARD (view-profile)
       ══════════════════════════════════════════════════════ -->
  <section id="view-profile" class="app-view" aria-labelledby="profile-heading">
    <div class="container" style="padding-top:2rem; padding-bottom:4rem;">

      <!-- Profile Header Card -->
      <div style="background:linear-gradient(135deg, #0D2217 0%, #133021 50%, #07150E 100%); border:1.5px solid rgba(212,175,55,0.4); border-radius:1.75rem; padding:2.5rem; margin-bottom:2.5rem; position:relative; overflow:hidden; box-shadow:0 20px 50px rgba(0,0,0,0.8);">
        <div style="position:absolute; top:-30px; left:-30px; width:180px; height:180px; background:radial-gradient(circle, rgba(212,175,55,0.1), transparent 70%); pointer-events:none;"></div>
        
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem;">
          <div style="display:flex; align-items:center; gap:1.5rem;">
            <div id="profile-avatar-large" style="width:5rem; height:5rem; border-radius:50%; background:linear-gradient(135deg, var(--gold-primary), #B8961E); display:flex; align-items:center; justify-content:center; font-size:2rem; font-weight:800; color:#000; border:2.5px solid #FFF; box-shadow:0 0 25px rgba(212,175,55,0.5); flex-shrink:0;">
              ث
            </div>
            <div>
              <div style="display:flex; align-items:center; gap:0.6rem; flex-wrap:wrap;">
                <h2 id="profile-user-name" class="font-heading" style="color:#FFF; font-size:1.8rem; margin:0;">مستخدم ثقافة دز</h2>
                <span class="badge" style="background:rgba(212,175,55,0.2); border-color:var(--gold-primary); color:var(--gold-primary); font-size:0.75rem;">عضو مفعّل 🇩🇿</span>
              </div>
              <div id="profile-user-contact" style="color:var(--text-muted); font-size:0.88rem; margin-top:0.35rem;" dir="ltr">+213 555 123 456</div>
              <div style="color:var(--text-dim); font-size:0.75rem; margin-top:0.2rem;">تشفير البيانات مؤمّن بنظام AES-256 و SSL/TLS</div>
            </div>
          </div>

          <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            <button type="button" class="btn btn-outline" onclick="logoutUser()" style="border-color:#EF4444; color:#EF4444; padding:0.5rem 1.25rem; font-size:0.85rem;">
              تسجيل الخروج 🚪
            </button>
          </div>
        </div>
      </div>

      <!-- User Stats & Badges Grid -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1.25rem; margin-bottom:2.5rem;">
        <div class="card" style="padding:1.5rem; text-align:center;">
          <div style="font-size:2rem; margin-bottom:0.4rem;">🏆</div>
          <div style="font-size:1.8rem; font-weight:800; color:var(--gold-primary);" id="profile-xp">150 XP</div>
          <div style="font-size:0.8rem; color:var(--text-muted);">نقاط الجواز الثقافي</div>
        </div>
        <div class="card" style="padding:1.5rem; text-align:center;">
          <div style="font-size:2rem; margin-bottom:0.4rem;">🎟️</div>
          <div style="font-size:1.8rem; font-weight:800; color:#38BDF8;" id="profile-tickets">2</div>
          <div style="font-size:0.8rem; color:var(--text-muted);">تذاكر رقمية محجوزة</div>
        </div>
        <div class="card" style="padding:1.5rem; text-align:center;">
          <div style="font-size:2rem; margin-bottom:0.4rem;">📍</div>
          <div style="font-size:1.8rem; font-weight:800; color:#10B981;">5</div>
          <div style="font-size:0.8rem; color:var(--text-muted);">معالم تمت زيارتها</div>
        </div>
        <div class="card" style="padding:1.5rem; text-align:center;">
          <div style="font-size:2rem; margin-bottom:0.4rem;">🛡️</div>
          <div style="font-size:1.8rem; font-weight:800; color:var(--neon-emerald);">100%</div>
          <div style="font-size:0.8rem; color:var(--text-muted);">مستوى حماية الحساب</div>
        </div>
      </div>

      <!-- Quick Action Shortcuts -->
      <div style="display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:2.5rem;">
        <button type="button" class="btn btn-gold" onclick="navigateTo('tickets')" style="flex:1; justify-content:center; padding:0.75rem 1.25rem;">
          حجز تذكرة متحف جديدة 🎟️
        </button>
        <button type="button" class="btn btn-outline" onclick="navigateTo('quiz')" style="flex:1; justify-content:center; padding:0.75rem 1.25rem;">
          المسابقة الثقافية وربح النقاط 🎮
        </button>
        <button type="button" class="btn btn-outline" onclick="navigateTo('rewards')" style="flex:1; justify-content:center; padding:0.75rem 1.25rem;">
          استبدال المكافآت والكوبونات 🎁
        </button>
      </div>

    </div>
  </section>

    <section id="view-admin" class="app-view" aria-labelledby="admin-heading">
      <div class="container" style="padding-top:2rem; padding-bottom:3.5rem;">
        
        <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:2rem; flex-wrap:wrap; gap:1rem;">
          <div>
            <span class="badge" data-i18n="admin_badge">لوحة القيادة والمتابعة الوطنية</span>
            <h1 id="admin-heading" class="font-heading" style="font-size:2rem; color:#FFF; margin-top:0.4rem;" data-i18n="admin_title">المرصد الرقمي للمؤشرات الثقافية لـ 58 ولاية</h1>
            <p style="color:var(--text-muted); font-size:0.9rem;" data-i18n="admin_desc">بيانات حية ومؤشرات إحصائية لحركة الزوار، مبيعات التذاكر، والمشاريع التراثية المعتمدة</p>
          </div>
          <button type="button" class="btn btn-gold" onclick="exportStatsCSV()" data-i18n="admin_export">
            تصدير تقرير الإحصاء (CSV)
          </button>
        </div>

        <div class="grid-3" style="margin-bottom:2rem;">
          <div class="card" style="padding:1.25rem;">
            <div style="font-size:0.775rem; color:var(--text-dim); margin-bottom:0.25rem;" data-i18n="stat_visitors_total">إجمالي زوار المعالم 2026</div>
            <div style="font-size:1.8rem; font-weight:700; color:var(--gold-primary);">1,428,950</div>
            <div style="font-size:0.75rem; color:var(--emerald-light); font-weight:600;">↑ +18.4%</div>
          </div>
          <div class="card" style="padding:1.25rem;">
            <div style="font-size:0.775rem; color:var(--text-dim); margin-bottom:0.25rem;" data-i18n="stat_qr_total">التذاكر الإلكترونية الصادرة QR</div>
            <div style="font-size:1.8rem; font-weight:700; color:#38BDF8;">412,300</div>
            <div style="font-size:0.75rem; color:var(--emerald-light); font-weight:600;">↑ +32.1%</div>
          </div>
          <div class="card" style="padding:1.25rem;">
            <div style="font-size:0.775rem; color:var(--text-dim); margin-bottom:0.25rem;" data-i18n="stat_manuscripts_total">المخطوطات الرقمية المرممة</div>
            <div style="font-size:1.8rem; font-weight:700; color:#A78BFA;">8,450</div>
            <div style="font-size:0.75rem; color:var(--text-muted);">National Archives</div>
          </div>
        </div>

        <!-- Wilayas Table -->
        <div class="card" style="padding:1.5rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem; flex-wrap:wrap; gap:0.75rem;">
            <h3 class="font-heading" style="font-size:1.2rem; color:#FFF;" data-i18n="table_wilayas_title">جدول متابعة الولايات الـ 58</h3>
            <input type="text" id="wilaya-search" placeholder="Search Wilaya / بحث ولاية..." oninput="filterWilayaTable(this.value)" style="background:rgba(0,0,0,0.3); border:1px solid var(--border-subtle); color:#FFF; padding:0.45rem 0.85rem; border-radius:0.65rem; font-size:0.825rem; width:220px;">
          </div>

          <div style="overflow-x:auto;">
            <table style="width:100%; text-align:inherit; border-collapse:collapse; font-size:0.825rem;">
              <thead>
                <tr style="border-bottom:1px solid var(--border-subtle); color:var(--gold-light);">
                  <th style="padding:0.75rem 0.5rem;" data-i18n="th_code">الرقم</th>
                  <th style="padding:0.75rem 0.5rem;" data-i18n="th_wilaya">الولاية</th>
                  <th style="padding:0.75rem 0.5rem;" data-i18n="th_monuments">المعالم الرئيسية</th>
                  <th style="padding:0.75rem 0.5rem;" data-i18n="th_museums">المتاحف المفتوحة</th>
                  <th style="padding:0.75rem 0.5rem;" data-i18n="th_visitors">الزوار السنوي</th>
                  <th style="padding:0.75rem 0.5rem;" data-i18n="th_status">حالة الجاهزية</th>
                </tr>
              </thead>
              <tbody id="wilaya-table-body"></tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- ══════════════════════════════════════════════════════
       NEON AI ASSISTANT WIDGET
       ══════════════════════════════════════════════════════ -->
  <button type="button" class="neon-ai-trigger" onclick="toggleAIAssistant()" aria-label="Open AI Assistant">
    <svg style="width:1.75rem; height:1.75rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24">
      <path d="M12 2a8 8 0 0 0-8 8c0 3.37 2.09 6.25 5.06 7.43V20a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2.57C17.91 16.25 20 13.37 20 10a8 8 0 0 0-8-8z"/>
      <line x1="9.5" y1="9" x2="9.51" y2="9"/><line x1="14.5" y1="9" x2="14.51" y2="9"/>
    </svg>
  </button>

  <div id="neon-ai-drawer" class="neon-ai-drawer" role="dialog" aria-modal="true" aria-label="Thakafa AI Assistant">
    <div style="background:rgba(19,48,33,0.95); padding:0.85rem 1rem; border-bottom:1px solid var(--neon-cyan); display:flex; justify-content:space-between; align-items:center;">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--neon-emerald); box-shadow:0 0 8px var(--neon-emerald);"></span>
        <strong style="color:var(--gold-light); font-size:0.9rem;" data-i18n="ai_name">حكيم التراث الذكي (Thakafa AI)</strong>
      </div>
      <button type="button" onclick="toggleAIAssistant()" style="background:none; border:none; color:var(--text-muted); cursor:pointer;">✕</button>
    </div>

    <div id="ai-chat-body" class="ai-chat-body">
      <div class="ai-msg ai-msg-assistant" id="ai-welcome-msg" data-i18n="ai_welcome">
        أهلاً بك في منصة ثقافة دز! أنا مرشدك الذكي في التراث والمعالم الجزائرية والمتاحف. كيف يمكنني إرشادك اليوم؟
      </div>
    </div>

    <div style="padding:0.4rem 0.75rem; display:flex; gap:0.35rem; overflow-x:auto; background:rgba(0,0,0,0.3); border-top:1px solid rgba(255,255,255,0.06);">
      <button type="button" class="btn btn-outline" style="padding:0.25rem 0.5rem; font-size:0.7rem; white-space:nowrap;" onclick="askAIPrompt('bardo')" data-i18n="chip_bardo">حجز تذكرة باردو؟</button>
      <button type="button" class="btn btn-outline" style="padding:0.25rem 0.5rem; font-size:0.7rem; white-space:nowrap;" onclick="askAIPrompt('sos')" data-i18n="chip_sos">أرقام الطوارئ؟</button>
      <button type="button" class="btn btn-outline" style="padding:0.25rem 0.5rem; font-size:0.7rem; white-space:nowrap;" onclick="askAIPrompt('timgad')" data-i18n="chip_timgad">موقع قوس تراجان؟</button>
    </div>

    <form onsubmit="handleAIChatSubmit(event)" style="display:flex; padding:0.65rem; background:rgba(7,21,14,0.9); border-top:1px solid rgba(255,255,255,0.1);">
      <input type="text" id="ai-input" placeholder="اكتب سؤالك / Ask a question..." style="flex:1; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.55rem 0.85rem; border-radius:0.65rem; font-size:0.8rem; font-family:inherit;">
      <button type="submit" class="btn btn-gold" style="padding:0.55rem 0.85rem; margin-right:0.4rem; margin-left:0.4rem;">
        <svg style="width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </form>
  </div>

  <!-- ══════════════════════════════════════════════════════
       BOTTOM NAVIGATION BAR FOR MOBILE
       ══════════════════════════════════════════════════════ -->
  <nav class="bottom-bar" aria-label="Bottom Navigation">
    <button type="button" class="bottom-tab active" data-view="home" onclick="navigateTo('home')">
      <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span data-i18n="nav_home">الرئيسية</span>
    </button>
    <button type="button" class="bottom-tab" data-view="events" onclick="navigateTo('events')">
      <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span data-i18n="nav_events">المهرجانات</span>
    </button>
    <button type="button" class="bottom-tab" data-view="lens" onclick="navigateTo('lens')">
      <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
      <span data-i18n="nav_lens">الماسح</span>
    </button>
    <button type="button" class="bottom-tab" data-view="atlas" onclick="navigateTo('atlas')">
      <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
      <span data-i18n="nav_atlas">الآثار</span>
    </button>
    <button type="button" class="bottom-tab" data-view="tickets" onclick="navigateTo('tickets')">
      <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
      <span data-i18n="nav_tickets">المتاحف</span>
    </button>
    <button type="button" class="bottom-tab" onclick="openEmergencyModal()">
      <svg style="width:1.2rem; height:1.2rem; fill:none; stroke:#F87171; stroke-width:2;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <span style="color:#F87171;" data-i18n="nav_sos">طوارئ</span>
    </button>
  </nav>

  <!-- ══════════════════════════════════════════════════════
       MODALS (Emergency, Booking, Artist, PWA)
       ══════════════════════════════════════════════════════ -->
  
  <!-- Emergency Modal -->
  <div id="emergency-modal" class="modal-backdrop" role="dialog" aria-modal="true">
    <div class="modal-box" style="border-color:#DC2626;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid rgba(220,38,38,0.3); padding-bottom:0.75rem;">
        <h2 class="font-heading" style="font-size:1.4rem; color:#FFF;" data-i18n="sos_modal_title">أرقام الطوارئ وسلامة الزوار</h2>
        <button type="button" onclick="closeEmergencyModal()" style="background:none; border:none; color:var(--text-muted); cursor:pointer;">✕</button>
      </div>

      <p style="color:var(--text-muted); font-size:0.875rem; margin-bottom:1.5rem;" data-i18n="sos_modal_desc">
        في حال التعرض لأي خطر أو طارئ أثناء زيارة المعالم أو المسالك الصحراوية والجبلية، اتصل مباشرة بالجهات الأمنية الجزائرية بنقرة واحدة:
      </p>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem; margin-bottom:1.5rem;">
        <a href="tel:1548" class="btn btn-outline" style="border-color:#38BDF8; color:#38BDF8;"><strong>1548</strong> — <span data-i18n="police_name">الشرطة</span></a>
        <a href="tel:1055" class="btn btn-outline" style="border-color:#4ADE80; color:#4ADE80;"><strong>1055</strong> — <span data-i18n="gendarme_name">الدرك الوطني</span></a>
        <a href="tel:14" class="btn btn-outline" style="border-color:#F87171; color:#F87171;"><strong>14</strong> — <span data-i18n="civil_name">الحماية المدنية</span></a>
        <a href="tel:1021" class="btn btn-outline" style="border-color:#FBBF24; color:#FBBF24;"><strong>1021</strong> — <span data-i18n="coast_name">الطوارئ البحرية</span></a>
      </div>

      <div style="background:rgba(220,38,38,0.1); border:1px solid rgba(220,38,38,0.3); padding:1rem; border-radius:0.85rem;">
        <div style="font-size:0.85rem; font-weight:700; color:#FCA5A5; margin-bottom:0.4rem;" data-i18n="gps_title">مشاركة إحداثيات GPS المباشرة مع النجدة:</div>
        <div id="gps-coords-display" style="font-family:monospace; font-size:0.85rem; color:#FFF; margin-bottom:0.6rem;" data-i18n="gps_hint">
          انقر أدناه لتحديد خط الطول والعرض بدقة لإرساله لفرق الإنقاذ
        </div>
        <button type="button" class="btn btn-emergency" onclick="getCurrentCoordinates()" style="font-size:0.8rem;" data-i18n="btn_gps_now">
          تحديد موقعي الآن ومشاركته (SOS GPS)
        </button>
      </div>
    </div>
  </div>

  <!-- Booking Modal -->
  <div id="booking-modal" class="modal-backdrop" role="dialog" aria-modal="true">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border-subtle); padding-bottom:0.75rem;">
        <h2 class="font-heading" style="font-size:1.4rem; color:var(--gold-primary);" data-i18n="book_modal_title">حجز تذكرة الدخول الرسمية</h2>
        <button type="button" onclick="closeBookingModal()" style="background:none; border:none; color:var(--text-muted); cursor:pointer;">✕</button>
      </div>

      <div id="booking-form-wrap">
        <form onsubmit="handleBookingConfirm(event)" style="display:flex; flex-direction:column; gap:0.9rem;">
          <input type="hidden" id="book-item-id">
          <div>
            <label style="font-size:0.8rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;" data-i18n="book_item_label">الفعالية / المتحف:</label>
            <input type="text" id="book-item-name" readonly style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;">
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:0.75rem;">
            <div>
              <label style="font-size:0.8rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;" data-i18n="book_date_label">تاريخ الزيارة:</label>
              <input type="date" id="book-date" required style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;">
            </div>
            <div>
              <label style="font-size:0.8rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;" data-i18n="book_count_label">عدد التذاكر:</label>
              <input type="number" id="book-count" min="1" max="10" value="1" required style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;">
            </div>
          </div>
          <div>
            <label style="font-size:0.8rem; color:var(--text-dim); display:block; margin-bottom:0.25rem;" data-i18n="book_name_label">اسم الزائر الكامل:</label>
            <input type="text" id="book-user-name" required placeholder="Full Name" style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;">
          </div>
          <button type="submit" class="btn btn-gold" style="width:100%;" data-i18n="btn_issue_qr">إصدار تذكرة الدخول الرقمية QR</button>
        </form>
      </div>

      <div id="booking-pass-result" style="display:none; text-align:center; padding:1rem 0;">
        <div style="background:#FFF; padding:1.25rem; border-radius:1rem; display:inline-block; margin-bottom:1rem; border:4px solid var(--gold-primary);">
          <svg viewBox="0 0 100 100" style="width:160px; height:160px;">
            <rect width="100" height="100" fill="#FFF" />
            <path fill="#07150E" d="M10,10 h30 v30 h-30 z M15,15 h20 v20 h-20 z M20,20 h10 v10 h-10 z M60,10 h30 v30 h-30 z M65,15 h20 v20 h-20 z M70,20 h10 v10 h-10 z M10,60 h30 v30 h-30 z M15,65 h20 v20 h-20 z M20,70 h10 v10 h-10 z" />
            <rect x="45" y="15" width="8" height="25" fill="#07150E" />
            <rect x="15" y="45" width="25" height="8" fill="#07150E" />
            <rect x="50" y="50" width="15" height="15" fill="#D4AF37" />
            <rect x="70" y="60" width="20" height="8" fill="#07150E" />
            <rect x="60" y="75" width="10" height="15" fill="#07150E" />
            <rect x="75" y="75" width="15" height="15" fill="#1B7A3D" />
          </svg>
        </div>
        <div id="pass-details-text" style="font-size:0.875rem; color:#FFF; margin-bottom:1.25rem; line-height:1.6;"></div>
        <div style="display:flex; justify-content:center; gap:0.5rem;">
          <button type="button" class="btn btn-gold" onclick="window.print()" data-i18n="btn_print">طباعة التذكرة</button>
          <button type="button" class="btn btn-outline" onclick="closeBookingModal()" data-i18n="btn_close">إغلاق</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Artist Modal -->
  <div id="artist-modal" class="modal-backdrop" role="dialog" aria-modal="true">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; border-bottom:1px solid var(--border-subtle); padding-bottom:0.75rem;">
        <h2 class="font-heading" style="font-size:1.4rem; color:var(--gold-primary);" data-i18n="art_modal_title">تواصل مع الفنان / دعم إبداعي</h2>
        <button type="button" onclick="closeArtistModal()" style="background:none; border:none; color:var(--text-muted); cursor:pointer;">✕</button>
      </div>

      <div style="display:flex; gap:1rem; align-items:center; margin-bottom:1.25rem; background:rgba(255,255,255,0.03); padding:0.75rem; border-radius:0.75rem;">
        <img id="artist-modal-img" src="" alt="" style="width:60px; height:60px; border-radius:50%; object-fit:cover; border:2px solid var(--gold-primary);">
        <div>
          <h3 id="artist-modal-name" class="font-heading" style="font-size:1.2rem; color:#FFF;"></h3>
          <span id="artist-modal-role" style="font-size:0.775rem; color:var(--gold-light);"></span>
        </div>
      </div>

      <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem;" data-i18n="art_modal_desc">
        أرسل رسالتك المباشرة أو طلب اقتناء عمل فني لدعم استمرارية التراث:
      </p>

      <form onsubmit="handleArtistContactSubmit(event)" style="display:flex; flex-direction:column; gap:0.75rem;">
        <input type="text" required placeholder="Full Name / الاسم الكامل" style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;">
        <input type="tel" required placeholder="Phone / رقم الهاتف" style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;">
        <textarea rows="3" required placeholder="Your Message / تفاصيل الرسالة..." style="width:100%; background:rgba(0,0,0,0.4); border:1px solid var(--border-subtle); color:#FFF; padding:0.6rem; border-radius:0.65rem;"></textarea>
        <button type="submit" class="btn btn-gold" style="width:100%;" data-i18n="btn_send_artist">إرسال الرسالة ودعم الفنان</button>
      </form>
    </div>
  </div>

  <!-- PWA Install Modal -->
  <div id="pwa-modal" class="modal-backdrop" role="dialog" aria-modal="true">
    <div class="modal-box" style="text-align:center;">
      <div style="font-size:3rem; margin-bottom:0.5rem;">📲</div>
      <h2 class="font-heading" style="font-size:1.5rem; color:var(--gold-primary); margin-bottom:0.75rem;" data-i18n="pwa_modal_title">تثبيت تطبيق Thakafa Dz</h2>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1.5rem; line-height:1.6;" data-i18n="pwa_modal_desc">
        يمكنك تثبيت تطبيق «ثقافة دز» مباشرة على شاشة هاتفك الرئيسية، للوصول السريع بدون كتابة الرابط، وتصفح المعالم والتذاكر دون الحاجة لاتصال بالإنترنت!
      </p>
      <div style="display:flex; justify-content:center; gap:0.75rem;">
        <button type="button" class="btn btn-pwa" onclick="executePWAInstall()" data-i18n="btn_confirm_install">تثبيت الآن على الهاتف</button>
        <button type="button" class="btn btn-outline" onclick="closePWAModal()" data-i18n="btn_close">إغلاق</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast-container" role="status" aria-live="polite">
    <div id="toast-inner" class="toast-card">
      <div id="toast-message" style="font-size:0.875rem; color:var(--text-primary); font-weight:500;"></div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       DATA STRUCTURES & BILINGUAL CONTENT
       ══════════════════════════════════════════════════════ -->
