        btn_map: "Map",
        btn_google_maps: "Navigate via Google Maps",
        btn_contact_art: "Connect with Artist & Support"
      }
    };

    let currentLang = 'ar';
    let currentQuizIndex = 0;
    let quizScore = 0;
    let cameraStream = null;
    let deferredPWAEvent = null;

    /* PWA Install Event Handler */
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPWAEvent = e;
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'flex';
    });

    function promptPWAInstall() {
      const modal = document.getElementById('pwa-modal');
      if (modal) modal.classList.add('open');
    }

    function closePWAModal() {
      const modal = document.getElementById('pwa-modal');
      if (modal) modal.classList.remove('open');
    }

    function executePWAInstall() {
      closePWAModal();
      if (deferredPWAEvent) {
        deferredPWAEvent.prompt();
        deferredPWAEvent.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            showToast(currentLang === 'ar' ? 'شكراً لك! تم تثبيت تطبيق ثقافة دز بنجاح.' : 'Thank you! Thakafa Dz app installed successfully.');
          }
          deferredPWAEvent = null;
        });
      } else {
        showToast(currentLang === 'ar' ? 'لتثبيت التطبيق على آيفون/كروم: اضغط على زر المشاركة ثم "إضافة إلى الشاشة الرئيسية"' : 'To install: Tap Share then "Add to Home Screen"');
      }
    }

    function dismissPWABanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
    }

    /* Initialize Application */
    document.addEventListener('DOMContentLoaded', () => {
      renderAllDynamicContent();
      loadQuizQuestion(0);

      const initialView = window.location.hash.replace('#', '') || 'home';
      renderBooks();
      if (USER_STATE) updateNavForUser();
      navigateTo(initialView, false);

      window.addEventListener('hashchange', () => {
        const v = window.location.hash.replace('#', '') || 'home';
        navigateTo(v, false);
      });
    });

    /* Render All Dynamic Sections based on currentLang */
    function renderAllDynamicContent() {
      try { renderEvents(FESTIVALS_DATA); } catch(e) { console.error('renderEvents error:', e); }
      try { renderAtlas(ATLAS_DATA); } catch(e) { console.error('renderAtlas error:', e); }
      try { renderMuseums(MUSEUMS_DATA); } catch(e) { console.error('renderMuseums error:', e); }
      try { renderArtists(ARTISTS_DATA); } catch(e) { console.error('renderArtists error:', e); }
      try { renderCuisine(CUISINE_DATA); } catch(e) { console.error('renderCuisine error:', e); }
      try { renderWilayaTable(WILAYAS_SAMPLE); } catch(e) { console.error('renderWilayaTable error:', e); }
      try { renderBooks(); } catch(e) { console.error('renderBooks error:', e); }
    }


    /* ══════════════════════════════════════════════════════
       GOOGLE MAPS HERITAGE SITES DATABASE & CONTROLLER
       ══════════════════════════════════════════════════════ */
    let currentGoogleMapMode = 'k'; // 'k' for satellite, 'm' for roadmap
    let currentGoogleMapSiteKey = 'timgad';

    const GOOGLE_MAP_SITES = {
      timgad: {
        name_ar: 'تيمقاد الأثرية (قوس تراجان)',
        name_en: 'Timgad Roman City (Thamugadi)',
        wilaya_ar: 'ولاية باتنة (05)',
        wilaya_en: 'Batna Province (05)',
        badge: 'UNESCO 1982',
        lat: 35.4844,
        lng: 6.4678,
        image: 'timgad.jpg',
        zoom: 16,
        desc_ar: 'جوهرة العمارة الرومانية في إفريقيا شيدها الإمبراطور تراجان عام 100م بنظام رقعة الشطرنج، مع قوس تراجان الشامخ والمكتبة الرومانية ومسرح الـ 3500 متفرج.',
        desc_en: 'Masterpiece of Roman urban grid planning built under Emperor Trajan in 100 AD, featuring the monumental arch, library, and 3,500-seat theater.'
      },
      djemila: {
        name_ar: 'مدينة جميلة الرومانية (كويكول)',
        name_en: 'Djemila Roman City (Cuicul)',
        wilaya_ar: 'ولاية سطيف (19)',
        wilaya_en: 'Setif Province (19)',
        badge: 'UNESCO 1982',
        lat: 36.3228,
        lng: 5.7361,
        image: 'djemila.jpg',
        zoom: 16,
        desc_ar: 'مدينة جبلية رومانية فريدة تتكيف بعبقرية مع التضاريس الوعرة، وتضم متحفاً استثنائياً لأروع الفسيفساء الأثرية في حوض البحر الأبيض المتوسط.',
        desc_en: 'Mountainous Roman colony adapted to rugged topography with exceptional mosaics museum, forum, and temples.'
      },
      tassili: {
        name_ar: 'طاسيلي ناجر والكهوف الصخرية',
        name_en: 'Tassili n’Ajjer National Park',
        wilaya_ar: 'ولاية جانت / إليزي (33)',
        wilaya_en: 'Djanet / Illizi Province (33)',
        badge: 'UNESCO 1982',
        lat: 24.4333,
        lng: 9.8333,
        image: 'tassili.jpg',
        zoom: 12,
        desc_ar: 'أكبر متحف مفتوح لفنون ما قبل التاريخ في العالم، يحوي أكثر من 15,000 نقش ورسم صخري عتيق يعود لأكثر من 10 آلاف عام، موثقاً تغير المناخ وحياة الإنسان القديم.',
        desc_en: 'Vast Saharan open-air museum preserving over 15,000 prehistoric rock carvings and cave paintings dating back 10,000+ years.'
      },
      kasbah: {
        name_ar: 'قصبة الجزائر المحروسة',
        name_en: 'Kasbah of Algiers',
        wilaya_ar: 'ولاية الجزائر (16)',
        wilaya_en: 'Algiers Province (16)',
        badge: 'UNESCO 1992',
        lat: 36.7865,
        lng: 3.0601,
        image: 'bardo.jpg',
        zoom: 17,
        desc_ar: 'مدينة إسلامية ومغاربية عريقة تطل على خليج الجزائر، تضم القصور العثمانية الفاخرة، المساجد التاريخية كجامع كتشاوة وجامع علي بتشين، وأزقة الحرف التقليدية.',
        desc_en: 'Historic Mediterranean Islamic medina with Ottoman palaces, Ketchaoua mosque, and artisan guild workshops.'
      },
      medracen: {
        name_ar: 'المدراسن — ضريح الملوك النوميديين (أوراس)',
        name_en: 'Medracen — Royal Numidian Mausoleum (Aurès)',
        wilaya_ar: 'ولاية باتنة (05)',
        wilaya_en: 'Batna Province (05)',
        badge: 'تراث نوميدي م.م (~300 ق.م)',
        lat: 35.5847,
        lng: 6.1033,
        image: 'djemila.jpg',
        zoom: 16,
        desc_ar: 'المدراسن هو ضريح دائري متدرج يعود للقرن الثالث قبل الميلاد (~300 ق.م)، قطره 59 متر وارتفاعه 19 مترًا، محاط بـ60 عمودًا دوريًا بدون ملاط. أحد أقدم الآثار الملكية الأمازيغية على الإطلاق.',
        desc_en: 'Medracen is a circular stepped royal mausoleum dating to the 3rd century BC (~300 BC), 59m diameter and 19m high, surrounded by 60 Doric columns without mortar.'
      },
      chretienne: {
        name_ar: 'الضريح الملكي الموريطاني — قبر الرومية (تيبازة)',
        name_en: 'Royal Mauretanian Mausoleum (Tipaza)',
