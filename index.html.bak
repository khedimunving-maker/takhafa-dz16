        author_en: 'Mohammed Dib',
        year: 1954,
        publisher_ar: 'Seuil — باريس',
        genre_ar: 'رواية — ثلاثية الجزائر',
        genre_en: 'Novel — Algeria Trilogy Part II',
        awards: 'جائزة فينيكس الفرنسية 2003 | قائمة كلاسيكيات UNESCO',
        synopsis_ar: 'الجزء الثاني من ثلاثية الجزائر الشهيرة. يصوّر حياة الفلاحين الجزائريين وظروفهم تحت الاستعمار في تلمسان. محمد ديب (1920–2003) حائز الجائزة الكبرى للأدب الفرنسي.',
        synopsis_en: 'Second part of Mohammed Dib\'s famous Algeria Trilogy. Depicts Algerian peasant life under French colonialism in Tlemcen. Dib (1920–2003) won the Grand Prix of French Literature.',
        color: '#DC2626'
      },
      {
        id: 'book-ahlam',
        title_ar: 'ذاكرة الجسد',
        title_fr: 'Mémoire de la chair',
        author_ar: 'أحلام مستغانمي',
        author_en: 'Ahlam Mosteghanemi',
        year: 1993,
        publisher_ar: 'دار الآداب — بيروت',
        genre_ar: 'رواية عاطفية — تريلوجي',
        genre_en: 'Romance Novel — Trilogy',
        awards: 'أكثر رواية عربية مبيعًا في التاريخ | 10 ملايين نسخة | 20+ لغة',
        synopsis_ar: 'أكثر رواية عربية مبيعًا على الإطلاق بأكثر من 10 ملايين نسخة ومترجمة لأكثر من 20 لغة. قصة حب وذاكرة وفن وجزائر ما بعد الاستقلال.',
        synopsis_en: 'The best-selling Arabic novel in history with 10M+ copies in 20+ languages. A story of love, memory, art and post-independence Algeria.',
        color: '#BE185D'
      },
      {
        id: 'book-tahar-djaout',
        title_ar: 'الصامتون يموتون / آخر صيف للعقل',
        title_fr: 'Le Dernier Été de la raison',
        author_ar: 'الطاهر جاووت',
        author_en: 'Tahar Djaout',
        year: 1999,
        publisher_ar: 'Seuil — باريس (نُشر بعد الاستشهاد)',
        genre_ar: 'رواية — أدب المقاومة',
        genre_en: 'Novel — Resistance Literature',
        awards: 'رمز المقاومة الثقافية الجزائرية | Prix Méditerranée',
        synopsis_ar: 'آخر روايات الطاهر جاووت (1954–1993)، الكاتب الشاعر الذي اغتيل لصمته الثقيل. تصور مجتمعًا يرزح تحت التطرف ويكافح من أجل بقاء العقل والجمال.',
        synopsis_en: 'Last novel of Tahar Djaout (1954–1993), the poet-writer assassinated for his bold pen. Depicts a society crushed by extremism, fighting for the survival of reason and beauty.',
        color: '#0891B2'
      },
      {
        id: 'book-mhd-benchicou',
        title_ar: 'ميموني — مذكرات من السجن',
        title_fr: 'Mémoires de prison',
        author_ar: 'محمد بن شيكو',
        author_en: 'Mohamed Benchicou',
        year: 2004,
        publisher_ar: 'Casbah Editions — الجزائر',
        genre_ar: 'مذكرات — أدب السجن',
        genre_en: 'Memoir — Prison Literature',
        awards: 'جائزة RSF لحرية الصحافة | Reporters Sans Frontières',
        synopsis_ar: 'مذكرات الصحفي الجزائري من داخل السجن، يوثق فيها تجربة الاعتقال والمقاومة الفكرية. وثيقة إنسانية مؤثرة عن الحرية والكرامة.',
        synopsis_en: 'Memoirs of the Algerian journalist written from prison, documenting intellectual resistance under detention. A moving document on freedom and dignity.',
        color: '#D97706'
      }
    ];

    function renderBooks() {
      const grid = document.getElementById('books-grid');
      if (!grid) return;
      grid.innerHTML = BOOKS_DATA.map(book => `
        <div class="book-card" style="border-left:4px solid ${book.color};">
          <div style="position:absolute;top:0;right:0;width:100px;height:100px;background:radial-gradient(circle,${book.color}10,transparent);pointer-events:none;border-radius:1.25rem;"></div>
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;position:relative;">
            <div>
              <div style="font-size:1.2rem;font-weight:800;color:#FFF;font-family:'Amiri',serif;line-height:1.3;" dir="rtl">${book.title_ar}</div>
              <div style="font-size:0.78rem;color:var(--text-dim);margin-top:0.2rem;font-style:italic;" dir="ltr">${book.title_fr}</div>
            </div>
            <span style="background:${book.color}25;border:1px solid ${book.color}50;border-radius:0.5rem;padding:0.25rem 0.6rem;font-size:0.72rem;color:${book.color};font-weight:700;white-space:nowrap;flex-shrink:0;">${book.year}</span>
          </div>
          <div style="display:flex;align-items:center;gap:0.6rem;position:relative;">
            <div style="width:2rem;height:2rem;border-radius:50%;background:${book.color}20;border:1px solid ${book.color}40;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg style="width:1rem;height:1rem;fill:${book.color};" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div>
              <div style="font-size:0.9rem;font-weight:600;color:var(--text-primary);" dir="rtl">${book.author_ar}</div>
              <div style="font-size:0.72rem;color:var(--text-dim);" dir="ltr">${book.author_en}</div>
            </div>
          </div>
          <span style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:0.4rem;padding:0.2rem 0.6rem;font-size:0.7rem;color:var(--text-muted);display:inline-block;" dir="rtl">${book.genre_ar}</span>
          <p style="font-size:0.85rem;color:var(--text-muted);line-height:1.65;position:relative;" dir="rtl">${currentLang === 'en' ? book.synopsis_en : book.synopsis_ar}</p>
          <div style="border-top:1px solid rgba(255,255,255,0.08);padding-top:0.75rem;font-size:0.72rem;color:var(--gold-primary);display:flex;align-items:flex-start;gap:0.4rem;position:relative;" dir="rtl">
            <svg style="width:0.8rem;height:0.8rem;fill:none;stroke:currentColor;stroke-width:2;flex-shrink:0;margin-top:1px;" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span>${book.awards}</span>
          </div>
        </div>
      `).join('');
    }

    /* ══════════════════════════════════════════════════════
       AUTH SYSTEM — USER SESSION MANAGEMENT
       ══════════════════════════════════════════════════════ */
    let USER_STATE = null;
    try { USER_STATE = JSON.parse(localStorage.getItem('tkahafa_user') || 'null'); } catch(e) {}
    let _otpTimer = null;
    window._demoOTP = null;

    function openAuthModal() {
      if (USER_STATE) { navigateTo('profile'); return; }
      const m = document.getElementById('auth-modal');
      if (m) { m.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
      switchAuthTab('login');
    }
    function closeAuthModal() {
      const m = document.getElementById('auth-modal');
      if (m) { m.style.display = 'none'; document.body.style.overflow = ''; }
      if (_otpTimer) clearInterval(_otpTimer);
    }
    function switchAuthTab(tab) {
      document.getElementById('auth-form-login').style.display = tab === 'login' ? 'block' : 'none';
      document.getElementById('auth-form-register').style.display = tab === 'register' ? 'block' : 'none';
      document.getElementById('atab-login').classList.toggle('active', tab === 'login');
      document.getElementById('atab-register').classList.toggle('active', tab === 'register');
    }
    function switchContactMethod(method) {
      const isPhone = method === 'phone';
      document.getElementById('reg-phone-wrap').style.display = isPhone ? 'block' : 'none';
      document.getElementById('reg-email-wrap').style.display = isPhone ? 'none' : 'block';
      document.getElementById('cm-phone').classList.toggle('active', isPhone);
      document.getElementById('cm-email').classList.toggle('active', !isPhone);
    }
    function togglePassVis(id) {
      const inp = document.getElementById(id);
      if (inp) inp.type = inp.type === 'password' ? 'text' : 'password';
    }
    function sendOTP() {
      const name = (document.getElementById('reg-name')?.value || '').trim();
      const phone = (document.getElementById('reg-phone')?.value || '').trim();
      const email = (document.getElementById('reg-email')?.value || '').trim();
      const contact = phone || email;
      if (!name || !contact) { showToast(currentLang==='en'?'Please fill in name and contact':'يرجى ملء الاسم ووسيلة التواصل','error'); return; }
      if (!document.getElementById('terms-ck').checked) { showToast(currentLang==='en'?'Please accept the terms':'يرجى قبول الشروط أولًا','error'); return; }
      document.getElementById('otp-section').style.display = 'block';
      document.getElementById('otp-send-wrap').style.display = 'none';
      document.getElementById('otp-verify-wrap').style.display = 'block';
      window._demoOTP = '123456';
      showToast(currentLang==='en'?`Code sent to ${contact}`:`تم الإرسال إلى ${contact} — الرمز التجريبي: 123456`,'success');
      let secs = 120;
      const timerEl = document.getElementById('otp-countdown');
      const resend = document.getElementById('otp-resend-btn');
      if (resend) resend.style.display = 'none';
      if (_otpTimer) clearInterval(_otpTimer);
      _otpTimer = setInterval(() => {
        secs--;
        if (timerEl) timerEl.textContent = `${String(Math.floor(secs/60)).padStart(2,'0')}:${String(secs%60).padStart(2,'0')}`;
        if (secs <= 0) { clearInterval(_otpTimer); if (timerEl) timerEl.textContent=''; if (resend) resend.style.display='block'; }
      }, 1000);
    }
    function handleRegister() {
      const otp = (document.getElementById('otp-input')?.value || '').trim();
      if (otp !== window._demoOTP) { showToast(currentLang==='en'?'Wrong OTP. Demo: 123456':'رمز خاطئ. الرمز التجريبي: 123456','error'); return; }
      const name = (document.getElementById('reg-name')?.value || '').trim();
      const phone = (document.getElementById('reg-phone')?.value || '').trim();
      const email = (document.getElementById('reg-email')?.value || '').trim();
      USER_STATE = { name, phone, email, createdAt: new Date().toISOString(), avatar: name.charAt(0).toUpperCase(), xp: 0 };
      localStorage.setItem('tkahafa_user', JSON.stringify(USER_STATE));
      closeAuthModal(); updateNavForUser();
      showToast(currentLang==='en'?`Welcome ${name}! Account created.`:`أهلًا ${name}! تم إنشاء حسابك بنجاح.`,'success');
    }
    function handleLogin() {
      const id = (document.getElementById('login-id')?.value || '').trim();
      const pass = (document.getElementById('login-pass')?.value || '').trim();
      if (!id || !pass) { showToast(currentLang==='en'?'Fill all fields':'يرجى ملء جميع الحقول','error'); return; }
      const saved = JSON.parse(localStorage.getItem('tkahafa_user') || 'null');
      USER_STATE = saved || { name: 'مستخدم ثقافة دز', avatar: 'ث', xp: 150, phone: id, createdAt: new Date().toISOString() };
      localStorage.setItem('tkahafa_user', JSON.stringify(USER_STATE));
      closeAuthModal(); updateNavForUser();
      showToast(currentLang==='en'?`Welcome back, ${USER_STATE.name}!`:`مرحبًا بعودتك، ${USER_STATE.name}!`,'success');
    }
    function logoutUser() {
      USER_STATE = null; localStorage.removeItem('tkahafa_user');
      const btn = document.getElementById('auth-nav-btn');
      if (btn) btn.innerHTML = '<svg style="width:1.1rem;height:1.1rem;fill:none;stroke:currentColor;stroke-width:2;" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
      showToast(currentLang==='en'?'Logged out successfully':'تم تسجيل الخروج بنجاح','info');
    }

    function updateNavForUser() {
      const btn = document.getElementById('auth-nav-btn');
      if (!btn || !USER_STATE) return;
      btn.innerHTML = `<div class="user-av-nav">${USER_STATE.avatar || '؟'}</div>`;
      btn.title = USER_STATE.name;

      // Update Profile Section if present
      const pName = document.getElementById('profile-user-name');
      const pAvatar = document.getElementById('profile-avatar-large');
      const pContact = document.getElementById('profile-user-contact');
      if (pName) pName.textContent = USER_STATE.name || 'مستخدم ثقافة دز';
      if (pAvatar) pAvatar.textContent = USER_STATE.avatar || 'ث';
      if (pContact) pContact.textContent = USER_STATE.phone || USER_STATE.email || '+213 555 123 456';
    }

    function showToast(msg, type = 'info') {
      const ex = document.getElementById('toast-notif');
      if (ex) ex.remove();
      const t = document.createElement('div');
      t.id = 'toast-notif';
      const c = { success:'#00C853', error:'#EF4444', info:'var(--gold-primary)' }[type] || 'var(--gold-primary)';
      t.style.cssText = `position:fixed;bottom:6rem;left:50%;transform:translateX(-50%);background:rgba(7,21,14,0.95);border:1px solid ${c}50;color:#FFF;padding:0.75rem 1.5rem;border-radius:2rem;z-index:400;font-size:0.88rem;backdrop-filter:blur(8px);box-shadow:0 8px 28px rgba(0,0,0,0.6);animation:slideDown 0.3s ease;max-width:90vw;text-align:center;`;
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t?.remove(), 4500);
    }

    function updatePassStrength(val) {
      const bar = document.getElementById('pass-bar');
      if (!bar) return;
      let s = 0;
      if (val.length >= 8) s += 25;
      if (/[A-Z]/.test(val)) s += 25;
      if (/[0-9]/.test(val)) s += 25;
      if (/[^A-Za-z0-9]/.test(val)) s += 25;
      bar.style.width = s + '%';
      bar.style.background = s <= 25 ? '#EF4444' : s <= 50 ? '#F59E0B' : s <= 75 ? '#10B981' : '#00FF88';
    }
        function navigateTo(viewId, updateHash = true) {

      const validViews = ['home', 'events', 'atlas', 'tickets', 'artists', 'cuisine', 'manuscripts', 'quiz', 'rewards', 'tracking', 'lens', 'admin', 'books', 'profile'];
      const targetId = validViews.includes(viewId) ? viewId : 'home';

      document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active'));
      const activeSec = document.getElementById(`view-${targetId}`);
      if (activeSec) activeSec.classList.add('active');

      // Update ALL Nav buttons & tabs with the active yellow bar!
      document.querySelectorAll('.pill-nav-btn, .nav-link, .bottom-tab, .drawer-nav-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.view === targetId);
      });

      if (updateHash) window.location.hash = targetId;
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (targetId === 'books') { renderBooks(); }

      // If opening Atlas, trigger Leaflet map resize
      if (targetId === 'atlas' && window.algeriaMap) {
        setTimeout(() => window.algeriaMap.invalidateSize(), 200);
      }

      // Clean up camera
      if (targetId !== 'lens' && cameraStream) {
        cameraStream.getTracks().forEach(track => track.stop());
        cameraStream = null;
        const v = document.getElementById('lens-video');
        if (v) v.style.display = 'none';
      }
    }

    function toggleDrawer(open) {
      const d = document.getElementById('mobile-drawer');
      if (d) d.style.display = open ? 'block' : 'none';
    }


    /* ══════════════════════════════════════════════════════
       INTERACTIVE MAP & RESTAURANT INTEGRATION LOGIC
       ══════════════════════════════════════════════════════ */
    let algeriaMap = null;
    let mapMarkers = [];

    function initAlgeriaMap() {
      const container = document.getElementById('algeria-interactive-map');
      if (!container || typeof L === 'undefined') return;

      if (algeriaMap) {
        algeriaMap.invalidateSize();
        return;
      }

      // Center of Algeria [28.0339, 1.6596]
      algeriaMap = L.map('algeria-interactive-map', {
        center: [32.5, 3.5],
        zoom: 6,
        minZoom: 5,
        maxZoom: 18,
        scrollWheelZoom: true
      });

      // Dark styled tile layer
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors | Thakafa Dz Heritage GIS'
      }).addTo(algeriaMap);

      window.algeriaMap = algeriaMap;
      populateMapMarkers();
    }

    function createCustomMarkerIcon(type) {
      const color = type === 'unesco' ? '#D4AF37' : type === 'museum' ? '#38BDF8' : type === 'restaurant' ? '#EF4444' : '#10B981';
      return L.divIcon({
        className: 'custom-heritage-pin',
        html: `<div style="width:28px; height:28px; border-radius:50%; background:${color}; border:2.5px solid #FFFFFF; box-shadow:0 0 15px ${color}, 0 4px 10px rgba(0,0,0,0.6); display:flex; align-items:center; justify-content:center; color:#000; font-size:12px; font-weight:bold;">🏛</div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 28],
        popupAnchor: [0, -28]
      });
    }

    function populateMapMarkers() {
      if (!algeriaMap) return;
      mapMarkers.forEach(m => algeriaMap.removeLayer(m));
      mapMarkers = [];

      // Add UNESCO and Atlas Sites
      ATLAS_DATA.forEach(site => {
        const marker = L.marker([site.lat, site.lng], { icon: createCustomMarkerIcon('unesco') })
          .bindPopup(`
            <div style="max-width:240px; text-align:right;">
              <img src="${site.image}" alt="${site.name_ar}" style="width:100%; height:120px; object-fit:cover; border-radius:8px; margin-bottom:8px; border:1px solid rgba(212,175,55,0.4);">
              <strong style="color:#D4AF37; font-size:1.05rem; display:block;">${currentLang === 'ar' ? site.name_ar : site.name_en}</strong>
              <span class="badge" style="font-size:0.65rem; margin:4px 0;">${site.unesco}</span>
              <p style="font-size:0.75rem; color:#CBD5E1; margin:6px 0;">${currentLang === 'ar' ? site.wilaya_ar : site.wilaya_en}</p>
              <button onclick="openGoogleMap(${site.lat}, ${site.lng}, '${site.name_ar}')" class="btn btn-gold" style="padding:0.3rem 0.6rem; font-size:0.7rem; width:100%; justify-content:center; margin-top:4px;">توجيه الملاحة GPS</button>
            </div>
          `);
        marker.category = 'unesco';
        marker.addTo(algeriaMap);
        mapMarkers.push(marker);
      });

      // Add Museums
      MUSEUMS_DATA.forEach(mu => {
        const marker = L.marker([mu.lat, mu.lng], { icon: createCustomMarkerIcon('museum') })
          .bindPopup(`
            <div style="max-width:240px; text-align:right;">
              <img src="${mu.image}" alt="${mu.name_ar}" style="width:100%; height:120px; object-fit:cover; border-radius:8px; margin-bottom:8px; border:1px solid rgba(56,189,248,0.4);">
              <strong style="color:#38BDF8; font-size:1.05rem; display:block;">${currentLang === 'ar' ? mu.name_ar : mu.name_en}</strong>
              <p style="font-size:0.75rem; color:#CBD5E1; margin:6px 0;">${currentLang === 'ar' ? mu.address_ar : mu.address_en}</p>
              <button onclick="openTicketModal('${mu.name_ar}', '${mu.price}', '${mu.wilaya_ar}')" class="btn btn-gold" style="padding:0.3rem 0.6rem; font-size:0.7rem; width:100%; justify-content:center; margin-top:4px;">حجز تذكرة الدخول QR</button>
            </div>
          `);
        marker.category = 'museums';
        marker.addTo(algeriaMap);
        mapMarkers.push(marker);
      });

      // Add Festivals
      FESTIVALS_DATA.forEach(fest => {
        const marker = L.marker([fest.lat, fest.lng], { icon: createCustomMarkerIcon('festival') })
          .bindPopup(`
            <div style="max-width:240px; text-align:right;">
              <img src="${fest.image}" alt="${fest.name_ar}" style="width:100%; height:120px; object-fit:cover; border-radius:8px; margin-bottom:8px; border:1px solid rgba(16,185,129,0.4);">
              <strong style="color:#10B981; font-size:1.05rem; display:block;">${currentLang === 'ar' ? fest.name_ar : fest.name_en}</strong>
              <span class="badge" style="font-size:0.65rem; margin:4px 0;">${fest.date_ar}</span>
              <p style="font-size:0.75rem; color:#CBD5E1; margin:6px 0;">${currentLang === 'ar' ? fest.location_ar : fest.location_en}</p>
              <button onclick="openTicketModal('${fest.name_ar}', '${fest.price}', '${fest.wilaya_ar}')" class="btn btn-gold" style="padding:0.3rem 0.6rem; font-size:0.7rem; width:100%; justify-content:center; margin-top:4px;">حجز مقعد في الفعالية</button>
            </div>
          `);
        marker.category = 'festivals';
        marker.addTo(algeriaMap);
        mapMarkers.push(marker);
      });
    }

    function filterMapMarkers(cat) {
      if (!algeriaMap) return;
      mapMarkers.forEach(m => {
        if (cat === 'all' || m.category === cat) {
          m.addTo(algeriaMap);
        } else {
          algeriaMap.removeLayer(m);
        }
      });
    }

    function focusLocationOnMap(lat, lng, zoom = 14) {
      navigateTo('atlas');
      setTimeout(() => {
        if (window.algeriaMap) {
          window.algeriaMap.invalidateSize();
          window.algeriaMap.flyTo([lat, lng], zoom, { duration: 1.5 });
        }
      }, 350);
    }

    /* Cuisine Restaurants Popup Logic */
    function openCuisineRestaurantsModal(dishId) {
      const dish = CUISINE_DATA.find(d => d.id === dishId) || CUISINE_DATA[0];
      const modal = document.getElementById('cuisine-restaurants-modal');
      const title = document.getElementById('cuisine-modal-dish-title');
      const list = document.getElementById('cuisine-restaurants-list');
      if (!modal || !list) return;

      title.textContent = currentLang === 'ar' ? `المطابخ والمطاعم المعتمدة لـ: ${dish.name_ar}` : `Authentic Kitchens for: ${dish.name_en}`;

      if (!dish.restaurants || dish.restaurants.length === 0) {
        list.innerHTML = `<div style="text-align:center; padding:2rem; color:#94A3B8;">جاري تحديث دليل المطابخ المعتمدة لهذا الطبق...</div>`;
      } else {
        list.innerHTML = dish.restaurants.map(r => `
          <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(212,175,55,0.25); border-radius:1rem; padding:1.25rem; display:flex; flex-direction:column; gap:0.6rem;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:0.5rem;">
              <h4 class="font-heading" style="font-size:1.2rem; color:#FFF; margin:0;">${currentLang === 'ar' ? r.name_ar : r.name_en}</h4>
              <span class="badge" style="background:rgba(212,175,55,0.15); color:var(--gold-primary); font-size:0.75rem;">${r.rating}</span>
            </div>
            <p style="font-size:0.85rem; color:#CBD5E1; margin:0;">📍 ${r.address} (${r.wilaya})</p>
            <p style="font-size:0.8rem; color:var(--gold-light); margin:0;">🍲 التخصص: ${r.specialty}</p>
            
            <div style="display:flex; gap:0.6rem; margin-top:0.5rem; flex-wrap:wrap;">
              <a href="tel:${r.phone}" class="btn btn-gold" style="padding:0.4rem 0.9rem; font-size:0.8rem; text-decoration:none;">
                📞 طلب مباشر (${r.phone})
              </a>
              <button type="button" class="btn btn-outline" onclick="closeCuisineRestaurantsModal(); focusLocationOnMap(${r.lat}, ${r.lng}, 15);" style="padding:0.4rem 0.9rem; font-size:0.8rem;">
                📍 عرض الموقع على الخريطة
              </button>
            </div>
          </div>
        `).join('');
      }

      modal.style.display = 'flex';
    }

    function closeCuisineRestaurantsModal() {
      const modal = document.getElementById('cuisine-restaurants-modal');
      if (modal) modal.style.display = 'none';
    }

    
    // Interactive dynamic spotlight on hero
    const heroBox = document.querySelector('.hero-master-container');
    const heroLightCone = document.querySelector('.hero-light-cone');
    if (heroBox && heroLightCone) {
      heroBox.addEventListener('mousemove', (e) => {
        const rect = heroBox.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        heroLightCone.style.background = `radial-gradient(circle at ${x}% ${y}%, rgba(245, 215, 127, 0.25) 0%, rgba(27, 122, 61, 0.15) 30%, transparent 65%)`;
      });
      heroBox.addEventListener('mouseleave', () => {
        heroLightCone.style.background = `radial-gradient(circle at 100% 0%, rgba(245, 215, 127, 0.18) 0%, rgba(27, 122, 61, 0.12) 30%, transparent 70%)`;
      });
    }

    
    // Ensure all nav buttons immediately set active class and move yellow underline
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.pill-nav-btn, .nav-link, .bottom-tab').forEach(btn => {
        btn.addEventListener('click', function(e) {
          const view = this.dataset.view;
          if (view) {
            document.querySelectorAll('.pill-nav-btn, .nav-link, .bottom-tab').forEach(b => {
              b.classList.toggle('active', b.dataset.view === view);
            });
          }
        });
      });
    });

    /* Quiz */
    function loadQuizQuestion(index) {
      currentQuizIndex = index;
      const q = QUIZ_QUESTIONS[index];
      if (!q) return;

      document.getElementById('quiz-progress-text').textContent = currentLang === 'ar' ? 
        `السؤال ${index + 1} من ${QUIZ_QUESTIONS.length}` : 
        `Question ${index + 1} of ${QUIZ_QUESTIONS.length}`;

      document.getElementById('quiz-score-badge').textContent = `XP: ${quizScore}`;
      document.getElementById('quiz-question').textContent = currentLang === 'ar' ? q.q_ar : q.q_en;

      const opts = currentLang === 'ar' ? q.opts_ar : q.opts_en;
      const optsWrap = document.getElementById('quiz-options');
      optsWrap.innerHTML = opts.map((opt, i) => `
        <button type="button" class="btn btn-outline" style="justify-content:flex-start; text-align:inherit; padding:0.85rem 1rem;" onclick="handleQuizAnswer(${i})">
          <span style="font-weight:700; color:var(--gold-primary); margin-right:0.5rem; margin-left:0.5rem;">${['A', 'B', 'C', 'D'][i]} -</span>
          <span>${escapeHTML(opt)}</span>
        </button>
      `).join('');

      document.getElementById('quiz-feedback').style.display = 'none';
      document.getElementById('quiz-next-btn').style.display = 'none';
    }

    function handleQuizAnswer(selected) {
      const q = QUIZ_QUESTIONS[currentQuizIndex];
      const feedback = document.getElementById('quiz-feedback');
      const nextBtn = document.getElementById('quiz-next-btn');

      const buttons = document.querySelectorAll('#quiz-options button');
      buttons.forEach((btn, i) => {
        btn.disabled = true;
        if (i === q.answer) {
          btn.style.borderColor = 'var(--emerald-light)';
          btn.style.background = 'rgba(40, 167, 69, 0.2)';
        } else if (i === selected) {
          btn.style.borderColor = '#DC2626';
          btn.style.background = 'rgba(220, 38, 38, 0.2)';
        }
      });

      const exp = currentLang === 'ar' ? q.exp_ar : q.exp_en;

      if (selected === q.answer) {
        quizScore += 100;
        document.getElementById('quiz-score-badge').textContent = `XP: ${quizScore}`;
        feedback.style.display = 'block';
        feedback.style.background = 'rgba(40, 167, 69, 0.15)';
        feedback.style.color = '#86EFAC';
        feedback.innerHTML = `<strong>${currentLang === 'ar' ? 'إجابة صحيحة!' : 'Correct!'} (+100 XP)</strong><br>${exp}`;
      } else {
        feedback.style.display = 'block';
        feedback.style.background = 'rgba(220, 38, 38, 0.15)';
        feedback.style.color = '#FCA5A5';
        feedback.innerHTML = `<strong>${currentLang === 'ar' ? 'إجابة غير دقيقة!' : 'Incorrect!'}</strong><br>${exp}`;
      }

      nextBtn.style.display = 'inline-flex';
    }

    function nextQuizQuestion() {
      if (currentQuizIndex + 1 < QUIZ_QUESTIONS.length) {
        loadQuizQuestion(currentQuizIndex + 1);
      } else {
        const wrap = document.getElementById('quiz-options');
        wrap.innerHTML = `
          <div style="text-align:center; padding:1.5rem 0;">
            <div style="font-size:2.5rem; margin-bottom:0.5rem;">🏆</div>
            <h4 class="font-heading" style="font-size:1.5rem; color:var(--gold-primary); margin-bottom:0.5rem;">${currentLang === 'ar' ? 'تهانينا! أتممت المسابقة بنجاح' : 'Congratulations! Quiz Completed'}</h4>
            <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:1.25rem;">${currentLang === 'ar' ? `حصلت على مجموع ${quizScore} XP أضيفت لجوازك الثقافي.` : `You earned ${quizScore} XP added to your Cultural Passport.`}</p>
            <button type="button" class="btn btn-gold" onclick="navigateTo('rewards')">${currentLang === 'ar' ? 'عرض الجواز الثقافي' : 'View Cultural Passport'}</button>
          </div>
        `;
        document.getElementById('quiz-feedback').style.display = 'none';
        document.getElementById('quiz-next-btn').style.display = 'none';
      }
    }

    /* Manuscripts */
    function loadSampleManuscript(type) {
      const img = document.getElementById('manuscript-preview-img');
      const title = document.getElementById('ms-title');
      const text = document.getElementById('ms-text');
      const desc = document.getElementById('ms-desc');

      if (type === 'hamel') {
        img.src = 'https://images.unsplash.com/photo-1457369804613-52c61a468e7d?auto=format&fit=crop&w=800&q=80';
        title.textContent = currentLang === 'ar' ? 'مخطوط خزانة زاوية الهامل — القرن 11 هـ' : 'El-Hamel Zawiya Manuscript — 17th Century';
        text.textContent = currentLang === 'ar' ? '«الحمد لله الذي زيّن سماء المعارف بأنوار الحكمة.. هذا تقييد في بيان مواقيت الفصول على ما جرى به عمل أهل المغرب الأوسط والجزائر المحروسة..»' : '“Praise be to God who adorned the heavens with wisdom.. This treatise calculates seasonal agricultural timings across the Central Maghreb and protected Algiers..”';
        desc.textContent = currentLang === 'ar' ? 'وثيقة تاريخية توثق استخدام الحسابات الفلكية لحساب التقويم الفلاحي ومواسم الزراعة.' : 'Historic document testifying to advanced astronomical calculations for regional agricultural seasons.';
      } else {
        img.src = 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=800&q=80';
        title.textContent = currentLang === 'ar' ? 'مخطوط علم الفلك لعلماء تلمسان — القرن 8 هـ' : 'Tlemcen Astronomy Manuscript — 14th Century';
        text.textContent = currentLang === 'ar' ? '«باب معرفة سمت القبلة بالدائرة الفلكية.. وحساب مطالع البروج في خط عرض مدينة تلمسان المحروسة..»' : '“Chapter on calculating astronomical azimuths and celestial coordinates aligned with the latitude of Tlemcen..”';
        desc.textContent = currentLang === 'ar' ? 'مخطوط نادر يوضح الإسهامات العلمية لمدرسة تلمسان في الفلك والرياضيات.' : 'Rare manuscript displaying Tlemcen’s intellectual contributions to mathematics and astronomy.';
      }
      showToast(currentLang === 'ar' ? 'تم تحميل المخطوط وتحليله بالذكاء الاصطناعي' : 'Manuscript loaded and analyzed via AI');
    }

    function handleManuscriptUpload(e) {
      const f = e.target.files && e.target.files[0];
      if (!f) return;
      const r = new FileReader();
      r.onload = (ev) => {
        document.getElementById('manuscript-preview-img').src = ev.target.result;
        showToast(currentLang === 'ar' ? 'جاري فك رموز المخطوط المرفوع...' : 'Decoding uploaded manuscript...');
      };
      r.readAsDataURL(f);
      e.target.value = '';
    }

    function toggleARLayers() {
      const s = document.getElementById('ar-scanline');
      if (s.style.display === 'block') {
        s.style.display = 'none';
        showToast(currentLang === 'ar' ? 'تم إيقاف فحص الواقع المعزز AR' : 'AR layer inspection turned off');
      } else {
        s.style.display = 'block';
        showToast(currentLang === 'ar' ? 'تم تفعيل طبقة الفحص الطيفي للألياف والحبر AR' : 'AR ink & fiber spectral inspection activated');
      }
    }

    /* Lens Vision */
    function startLiveCamera() {
      const v = document.getElementById('lens-video');
      const c = document.getElementById('lens-canvas');
      const btn = document.getElementById('btn-camera-toggle');

      if (cameraStream) {
        cameraStream.getTracks().forEach(t => t.stop());
        cameraStream = null;
        v.style.display = 'none';
        btn.innerHTML = `<span>${I18N[currentLang].btn_start_camera}</span>`;
        return;
      }

      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        showToast(currentLang === 'ar' ? 'الكاميرا غير متاحة، يمكنك رفع صورة' : 'Camera unavailable, please upload a photo');
        return;
      }

      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
        .then(stream => {
          cameraStream = stream;
          v.srcObject = stream;
          v.style.display = 'block';
          btn.innerHTML = `<span>Stop Camera</span>`;
          showToast(currentLang === 'ar' ? 'تم تشغيل الكاميرا' : 'Camera running');
          requestAnimationFrame(processCameraFrame);
        })
        .catch(() => {
          showToast(currentLang === 'ar' ? 'تعذر فتح الكاميرا (يرجى إعطاء الصلاحية)' : 'Camera access denied');
        });
    }

    function processCameraFrame() {
      if (!cameraStream) return;
      const v = document.getElementById('lens-video');
      const c = document.getElementById('lens-canvas');
      if (v.readyState === v.HAVE_ENOUGH_DATA) {
        c.width = v.videoWidth || 640;
        c.height = v.videoHeight || 480;
        const ctx = c.getContext('2d');
        ctx.drawImage(v, 0, 0, c.width, c.height);
      }
      requestAnimationFrame(processCameraFrame);
    }

    function handleLensUpload(e) {
      const f = e.target.files && e.target.files[0];
      if (!f) return;
      const r = new FileReader();
      r.onload = (ev) => {
        const img = new Image();
        img.onload = () => {
          const c = document.getElementById('lens-canvas');
          c.width = img.width;
          c.height = img.height;
          const ctx = c.getContext('2d');
          ctx.drawImage(img, 0, 0);
          simulateMonumentDetection('timgad');
        };
        img.src = ev.target.result;
      };
      r.readAsDataURL(f);
      e.target.value = '';
    }

    function simulateMonumentDetection(type) {
      const res = document.getElementById('lens-result');
      if (type === 'timgad') {
        document.getElementById('det-name').textContent = currentLang === 'ar' ? 'تيمقاد — قوس تراجان' : 'Timgad — Arch of Trajan';
        document.getElementById('det-desc').textContent = currentLang === 'ar' ? 'معلم روماني عريق شيد سنة 100م في مدينة تاموقادي بولاية باتنة.' : 'Monumental Roman arch built in 100 AD in Batna Province.';
        document.getElementById('det-map-link').href = 'https://www.google.com/maps/search/?api=1&query=35.4844,6.4678';
      } else {
        document.getElementById('det-name').textContent = currentLang === 'ar' ? 'قصبة الجزائر المحروسة' : 'Kasbah of Algiers';
        document.getElementById('det-desc').textContent = currentLang === 'ar' ? 'مدينة تاريخية مغاربية عريقة مصنفة تراثاً عالمياً لليونسكو.' : 'UNESCO World Heritage Mediterranean historic medina.';
        document.getElementById('det-map-link').href = 'https://www.google.com/maps/search/?api=1&query=36.7865,3.0601';
      }
      res.style.display = 'block';
      showToast(currentLang === 'ar' ? 'تم التعرف البصري بنجاح!' : 'Landmark recognized successfully!');
    }

    /* Modals Logic */
    function openEmergencyModal() { document.getElementById('emergency-modal').classList.add('open'); }
    function closeEmergencyModal() { document.getElementById('emergency-modal').classList.remove('open'); }

    function getCurrentCoordinates() {
      const disp = document.getElementById('gps-coords-display');
      disp.textContent = currentLang === 'ar' ? 'جاري تحديد موقعك GPS...' : 'Acquiring GPS fix...';
      if (!navigator.geolocation) {
        disp.textContent = 'Geolocation not supported. Dial 1548 / 1055 directly.';
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (p) => {
          const lat = p.coords.latitude.toFixed(6);
          const lng = p.coords.longitude.toFixed(6);
          disp.innerHTML = `<strong>GPS:</strong> Lat: ${lat}, Lng: ${lng}<br><a href="https://www.google.com/maps?q=${lat},${lng}" target="_blank" style="color:var(--neon-cyan); text-decoration:underline;">Google Maps Link</a>`;
        },
        () => { disp.textContent = 'GPS permission denied. Call 1548 / 14.'; },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    }

    function openEventBooking(id) {
      const ev = FESTIVALS_DATA.find(f => f.id === id);
      if (!ev) return;
      document.getElementById('book-item-id').value = ev.id;
      document.getElementById('book-item-name').value = currentLang === 'ar' ? ev.name_ar : ev.name_en;
      document.getElementById('booking-form-wrap').style.display = 'block';
      document.getElementById('booking-pass-result').style.display = 'none';
      document.getElementById('booking-modal').classList.add('open');
    }

    function openMuseumBooking(name) {
      document.getElementById('book-item-id').value = 'mus';
      document.getElementById('book-item-name').value = name;
      document.getElementById('booking-form-wrap').style.display = 'block';
      document.getElementById('booking-pass-result').style.display = 'none';
      document.getElementById('booking-modal').classList.add('open');
    }

    function closeBookingModal() { document.getElementById('booking-modal').classList.remove('open'); }

    function handleBookingConfirm(e) {
      e.preventDefault();
      const name = document.getElementById('book-user-name').value;
      const item = document.getElementById('book-item-name').value;
      const date = document.getElementById('book-date').value;
      document.getElementById('booking-form-wrap').style.display = 'none';
      document.getElementById('booking-pass-result').style.display = 'block';
      document.getElementById('pass-details-text').innerHTML = `
        <strong>#DZ-PASS-${Math.floor(100000 + Math.random()*900000)}</strong><br>
        ${escapeHTML(name)} | ${escapeHTML(item)} | ${escapeHTML(date)}<br>
        <span style="color:var(--emerald-light); font-weight:700;">CONFIRMED & VALIDATED</span>
      `;
      showToast(currentLang === 'ar' ? 'تم إصدار التذكرة بنجاح!' : 'QR Pass Issued Successfully!');
    }

    function openArtistModal(id) {
      const art = ARTISTS_DATA.find(a => a.id === id);
      if (!art) return;
      document.getElementById('artist-modal-name').textContent = currentLang === 'ar' ? art.name_ar : art.name_en;
      document.getElementById('artist-modal-role').textContent = currentLang === 'ar' ? art.discipline_ar : art.discipline_en;
      document.getElementById('artist-modal-img').src = art.image;
      document.getElementById('artist-modal').classList.add('open');
    }

    function closeArtistModal() { document.getElementById('artist-modal').classList.remove('open'); }

    function handleArtistContactSubmit(e) {
      e.preventDefault();
      closeArtistModal();
      showToast(currentLang === 'ar' ? 'تم إرسال رسالتك إلى الفنان بنجاح!' : 'Message sent to artist successfully!');
    }

    function claimCoupon(code) {
      showToast(currentLang === 'ar' ? `تم تفعيل الكوبون [${code}] في جوازك الثقافي!` : `Coupon [${code}] added to your passport!`);
    }

    function searchTracking() {
      const v = document.getElementById('track-number-input').value.trim();
      if (!v) return;
      showToast(currentLang === 'ar' ? `جاري تحديث شحنة [${v}]...` : `Updating parcel [${v}]...`);
    }

    function handlePaymentSubmit(e) {
      e.preventDefault();
      showToast(currentLang === 'ar' ? 'تم الدفع الإلكتروني بنجاح واقتطاع المبلغ عبر خادم SATIM الآمن.' : 'Payment processed successfully via SATIM!');
    }

    function exportStatsCSV() {
      let csv = 'Code,Wilaya,HeritageSites,Museums,Visitors\n';
      WILAYAS_SAMPLE.forEach(w => {
        csv += `${w.num},"${w.name_en}","${w.mon_en}",${w.mus},"${w.vis}"\n`;
      });
      const b = new Blob([csv], { type: 'text/csv' });
      const u = URL.createObjectURL(b);
      const a = document.createElement('a');
      a.href = u;
      a.download = 'thakafa_dz_metrics.csv';
      a.click();
    }

    /* Neon AI */
    function toggleAIAssistant() { document.getElementById('neon-ai-drawer').classList.toggle('open'); }

    function askAIPrompt(type) {
      let q = '';
      if (type === 'bardo') q = currentLang === 'ar' ? 'كيف أحجز تذكرة لمتحف باردو؟' : 'How to book a ticket for Bardo Museum?';
      else if (type === 'sos') q = currentLang === 'ar' ? 'ما هي أرقام الطوارئ في المواقع الأثرية؟' : 'What are emergency numbers at archaeological sites?';
      else q = currentLang === 'ar' ? 'أين يقع قوس تراجان بالضبط؟' : 'Where is Trajan Arch located?';
      
      document.getElementById('ai-input').value = q;
      handleAIChatSubmit(new Event('submit'));
    }

    function handleAIChatSubmit(e) {
      e.preventDefault();
      const inp = document.getElementById('ai-input');
      const txt = inp.value.trim();
      if (!txt) return;

      appendChatMessage(txt, 'user');
      inp.value = '';

      setTimeout(() => {
        let reply = currentLang === 'ar' ? 
          'مرحباً بك! ثقافة دز توثق معالم الجزائر الـ 58 ومتاحفها ومهرجاناتها المصنفة عالمياً.' : 
          'Welcome! Thakafa Dz covers all 58 Algerian provinces with verified UNESCO landmarks and ticketing.';
        
        const lower = txt.toLowerCase();
        if (lower.includes('bardo') || lower.includes('باردو')) {
          reply = currentLang === 'ar' ? 
            'يمكنك حجز تذكرة متحف باردو الوطني بقيمة 200 دج مباشرة عبر قسم المتاحف مع تذكرة QR فورية ورابط Google Maps بشارع روزفلت بالعاصمة.' : 
            'You can book National Bardo Museum tickets for 200 DZD in the Museums tab with instant QR pass and Google Maps directions.';
        } else if (lower.includes('sos') || lower.includes('طوارئ') || lower.includes('police')) {
          reply = currentLang === 'ar' ? 
            'أرقام الطوارئ: الشرطة 1548، الدرك 1055، الحماية المدنية 14. اضغط على الزر الأحمر في الهيدر لمشاركة إحداثيات GPS الحية.' : 
            'Emergency Hotlines: Police 1548, Gendarmerie 1055, Civil Protection 14. Use the top red SOS button for live GPS sharing.';
        } else if (lower.includes('timgad') || lower.includes('تراجان') || lower.includes('تيمقاد')) {
          reply = currentLang === 'ar' ? 
            'يقع قوس تراجان بمدينة تيمقاد الرومانية بولاية باتنة بإحداثيات 35.4844, 6.4678. زر أطلس الآثار يوجهك مباشرة بالخرائط.' : 
            'Trajan Arch is located in Roman Timgad, Batna (35.4844, 6.4678). Open the Heritage Atlas to navigate via Google Maps.';
        }
        appendChatMessage(reply, 'assistant');
      }, 400);
    }

    function appendChatMessage(msg, sender) {
      const b = document.getElementById('ai-chat-body');
      const d = document.createElement('div');
      d.className = `ai-msg ${sender === 'user' ? 'ai-msg-user' : 'ai-msg-assistant'}`;
      d.innerHTML = escapeHTML(msg);
      b.appendChild(d);
      b.scrollTop = b.scrollHeight;
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toast-message').textContent = msg;
      t.querySelector('.toast-card').classList.add('show');
      setTimeout(() => t.querySelector('.toast-card').classList.remove('show'), 3500);
    }

    function escapeHTML(s) {
      if (!s) return '';
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  </script>

  <!-- ══════════════════════════════════════════════════════
       GLOBAL SPOTLIGHT SEARCH MODAL
       ══════════════════════════════════════════════════════ -->
  <div id="search-modal" style="position:fixed; inset:0; z-index:110; background:rgba(0,0,0,0.8); backdrop-filter:blur(8px); display:none; align-items:flex-start; justify-content:center; padding:5rem 1rem;" role="dialog" aria-modal="true">
    <div style="background:#0D2217; border:1px solid rgba(212,175,55,0.4); border-radius:1.25rem; width:100%; max-width:640px; box-shadow:0 25px 60px rgba(0,0,0,0.8); overflow:hidden; animation:slideDown 0.25s ease;">
      <div style="display:flex; align-items:center; gap:0.75rem; padding:1.2rem 1.5rem; border-bottom:1px solid rgba(255,255,255,0.1);">
        <svg style="width:1.3rem; height:1.3rem; fill:none; stroke:#D4AF37; stroke-width:2.2;" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="global-search-input" placeholder="ابحث عن مهرجان، معلم، متحف، فنان، أكلة تراثية..." style="background:transparent; border:none; outline:none; color:#FFF; font-size:1.05rem; font-family:var(--font-body); width:100%;" oninput="handleGlobalSearch(this.value)">
        <button type="button" onclick="closeSearchModal()" style="background:none; border:none; color:#94A3B8; cursor:pointer; font-size:1.3rem;">✕</button>
      </div>
      <div id="search-results-box" style="max-height:380px; overflow-y:auto; padding:0.75rem 1rem;">
        <div style="padding:1.5rem; text-align:center; color:#94A3B8; font-size:0.9rem;" data-i18n="search_hint">
          اكتب كلمة للبحث الفوري في كافة أقسام وتراث منصة ثقافة دز...
        </div>
      </div>
    </div>
  </div>


  <!-- ══════════════════════════════════════════════════════
       CUISINE RESTAURANTS & KITCHENS MODAL
       ══════════════════════════════════════════════════════ -->
  <div id="cuisine-restaurants-modal" style="position:fixed; inset:0; z-index:120; background:rgba(0,0,0,0.85); backdrop-filter:blur(10px); display:none; align-items:center; justify-content:center; padding:1.5rem;" role="dialog" aria-modal="true">
    <div style="background:#0D2217; border:1.5px solid rgba(212,175,55,0.4); border-radius:1.5rem; width:100%; max-width:680px; max-height:90vh; display:flex; flex-direction:column; box-shadow:0 25px 60px rgba(0,0,0,0.8); overflow:hidden; animation:slideDown 0.3s ease;">
      
      <div style="padding:1.25rem 1.75rem; border-bottom:1px solid rgba(255,255,255,0.1); display:flex; justify-content:space-between; align-items:center; background:linear-gradient(90deg, #133021, #0A1C12);">
        <div>
          <span class="badge" style="background:rgba(212,175,55,0.2); color:var(--gold-primary); font-size:0.7rem;">المطابخ والمطاعم التراثية المعتمدة</span>
          <h3 id="cuisine-modal-dish-title" class="font-heading" style="font-size:1.4rem; color:#FFF; margin-top:0.25rem;">أين تتذوق هذا الطبق الأصيل؟</h3>
        </div>
        <button type="button" onclick="closeCuisineRestaurantsModal()" style="background:none; border:none; color:#CBD5E1; cursor:pointer; font-size:1.4rem; padding:0.25rem;">✕</button>
      </div>

      <div id="cuisine-restaurants-list" style="padding:1.5rem; overflow-y:auto; flex:1; display:flex; flex-direction:column; gap:1.2rem;">
        <!-- Filled dynamically -->
      </div>

      <div style="padding:1rem 1.75rem; border-top:1px solid rgba(255,255,255,0.1); background:rgba(0,0,0,0.4); display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:0.8rem; color:var(--text-muted);">جميع المطابخ معتمدة ومطابقة لمعايير الأصالة التراثية</span>
        <button type="button" class="btn btn-outline" onclick="closeCuisineRestaurantsModal()" style="padding:0.4rem 1rem;">إغلاق</button>
      </div>

    </div>
  </div>


  <!-- AUTH MODAL -->
  <div id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title"
       style="position:fixed;inset:0;z-index:300;background:rgba(0,0,0,0.88);backdrop-filter:blur(14px);display:none;align-items:center;justify-content:center;padding:1rem;">
    <div class="auth-modal-inner" style="background:linear-gradient(145deg,#0D2217 0%,#07150E 100%);border:1.5px solid rgba(212,175,55,0.4);border-radius:2rem;width:100%;max-width:430px;max-height:92vh;overflow-y:auto;box-shadow:0 40px 90px rgba(0,0,0,0.95),0 0 0 1px rgba(212,175,55,0.07),inset 0 1px 0 rgba(212,175,55,0.12);position:relative;">

      <!-- Close -->
      <button type="button" onclick="closeAuthModal()" aria-label="إغلاق"
        style="position:absolute;top:1rem;left:1rem;z-index:2;background:rgba(255,255,255,0.08);border:none;border-radius:50%;width:2.1rem;height:2.1rem;display:flex;align-items:center;justify-content:center;color:#94A3B8;cursor:pointer;font-size:1.1rem;transition:background 0.2s;"
        onmouseover="this.style.background='rgba(255,255,255,0.15)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">✕</button>

      <!-- Header -->
      <div style="padding:2rem 2rem 1.25rem;text-align:center;border-bottom:1px solid rgba(255,255,255,0.07);">
        <div style="display:inline-flex;align-items:center;justify-content:center;width:3.75rem;height:3.75rem;background:linear-gradient(135deg,rgba(212,175,55,0.18),rgba(27,122,61,0.18));border:1.5px solid rgba(212,175,55,0.45);border-radius:50%;margin-bottom:1rem;">
          <svg style="width:1.7rem;height:1.7rem;fill:none;stroke:var(--gold-primary);stroke-width:2;" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h2 id="auth-title" class="font-heading" style="font-size:1.5rem;color:#FFF;margin-bottom:0.35rem;" data-i18n="auth_modal_title">بوابة ثقافة دز</h2>
        <p style="font-size:0.82rem;color:var(--text-muted);" data-i18n="auth_modal_subtitle">سجّل لتستمتع بكل ميزات المنصة</p>
      </div>

      <!-- Tabs -->
      <div style="display:flex;border-bottom:1px solid rgba(255,255,255,0.07);">
        <button type="button" id="atab-login" class="auth-tab-btn active" onclick="switchAuthTab('login')" data-i18n="auth_tab_login">تسجيل الدخول</button>
        <button type="button" id="atab-register" class="auth-tab-btn" onclick="switchAuthTab('register')" data-i18n="auth_tab_register">فتح حساب جديد</button>
      </div>

      <div style="padding:1.75rem 1.75rem;">

        <!-- LOGIN FORM -->
        <div id="auth-form-login">
          <div style="margin-bottom:1.1rem;">
            <label style="display:block;font-size:0.78rem;color:var(--text-muted);margin-bottom:0.4rem;font-weight:500;" data-i18n="auth_phone_or_email">رقم الهاتف أو البريد الإلكتروني</label>
            <input type="text" id="login-id" class="auth-field" placeholder="+213 XXX XXX XXX أو email@example.com" dir="ltr">
          </div>
          <div style="margin-bottom:0.75rem;">
            <label style="display:block;font-size:0.78rem;color:var(--text-muted);margin-bottom:0.4rem;font-weight:500;" data-i18n="auth_password">كلمة المرور</label>
            <div style="position:relative;">
              <input type="password" id="login-pass" class="auth-field" placeholder="••••••••••" dir="ltr">
              <button type="button" onclick="togglePassVis('login-pass')" style="position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-dim);cursor:pointer;">
                <svg style="width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:2;" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>
          <div style="text-align:left;margin-bottom:1.25rem;">
            <button type="button" style="background:none;border:none;color:var(--gold-primary);font-size:0.8rem;cursor:pointer;font-family:var(--font-body);" data-i18n="auth_forgot_pass">نسيت كلمة المرور؟</button>
          </div>
          <button type="button" class="auth-submit-btn" onclick="handleLogin()" data-i18n="auth_login_submit">دخول إلى حسابي</button>
        </div>

        <!-- REGISTER FORM -->
        <div id="auth-form-register" style="display:none;">
          <div style="margin-bottom:1.1rem;">
            <label style="display:block;font-size:0.78rem;color:var(--text-muted);margin-bottom:0.4rem;font-weight:500;" data-i18n="auth_fullname">الاسم الكامل</label>
            <input type="text" id="reg-name" class="auth-field" placeholder="محمد أمين بوعلام">
          </div>
          <div style="display:flex;gap:0.5rem;margin-bottom:0.75rem;">
            <button type="button" id="cm-phone" class="auth-tab-btn active" onclick="switchContactMethod('phone')" style="border-radius:0.6rem;border:1.5px solid rgba(212,175,55,0.3);font-size:0.8rem;padding:0.5rem;" data-i18n="auth_via_phone">📱 هاتف</button>
            <button type="button" id="cm-email" class="auth-tab-btn" onclick="switchContactMethod('email')" style="border-radius:0.6rem;border:1.5px solid rgba(255,255,255,0.1);font-size:0.8rem;padding:0.5rem;" data-i18n="auth_via_email">📧 بريد</button>
          </div>
          <div id="reg-phone-wrap" style="margin-bottom:1.1rem;">
            <label style="display:block;font-size:0.78rem;color:var(--text-muted);margin-bottom:0.4rem;font-weight:500;" data-i18n="auth_phone">رقم الهاتف</label>
            <div style="display:flex;gap:0.5rem;">
              <input type="text" class="auth-field" value="+213" style="width:5rem;text-align:center;" dir="ltr" readonly>
              <input type="tel" id="reg-phone" class="auth-field" placeholder="0XXX XXX XXX" dir="ltr" style="flex:1;">
            </div>
          </div>
          <div id="reg-email-wrap" style="display:none;margin-bottom:1.1rem;">
            <label style="display:block;font-size:0.78rem;color:var(--text-muted);margin-bottom:0.4rem;font-weight:500;" data-i18n="auth_email">البريد الإلكتروني</label>
            <input type="email" id="reg-email" class="auth-field" placeholder="votre@email.com" dir="ltr">
          </div>
          <div style="margin-bottom:1.1rem;">
            <label style="display:block;font-size:0.78rem;color:var(--text-muted);margin-bottom:0.4rem;font-weight:500;" data-i18n="auth_new_password">كلمة المرور الجديدة</label>
            <input type="password" id="reg-pass" class="auth-field" placeholder="8 أحرف على الأقل" dir="ltr" oninput="updatePassStrength(this.value)">
            <div style="height:3px;border-radius:2px;background:rgba(255,255,255,0.08);margin-top:0.4rem;overflow:hidden;">
              <div id="pass-bar" style="height:100%;width:0;background:#EF4444;transition:width 0.3s,background 0.3s;"></div>
            </div>
          </div>
          <!-- OTP Section -->
          <div id="otp-section" style="display:none;margin-bottom:1.1rem;background:rgba(0,0,0,0.3);border:1px solid rgba(212,175,55,0.2);border-radius:1rem;padding:1rem;">
            <div style="font-size:0.78rem;color:var(--text-muted);margin-bottom:0.75rem;" data-i18n="auth_otp_sent">تم إرسال رمز التحقق</div>
            <input type="text" id="otp-input" class="auth-field" placeholder="● ● ● ● ● ●" maxlength="6" dir="ltr" style="letter-spacing:0.3em;text-align:center;font-size:1.3rem;font-weight:800;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.6rem;">
              <span id="otp-countdown" style="font-size:0.82rem;color:var(--gold-primary);font-weight:700;font-family:monospace;"></span>
              <button type="button" id="otp-resend-btn" onclick="sendOTP()" style="display:none;background:none;border:none;color:var(--text-dim);font-size:0.78rem;cursor:pointer;font-family:var(--font-body);" data-i18n="auth_resend_otp">إعادة الإرسال</button>
            </div>
          </div>
          <div style="display:flex;align-items:flex-start;gap:0.5rem;margin-bottom:1.25rem;">
            <input type="checkbox" id="terms-ck" style="margin-top:3px;accent-color:var(--gold-primary);width:1rem;height:1rem;cursor:pointer;">
            <label for="terms-ck" style="font-size:0.78rem;color:var(--text-muted);cursor:pointer;line-height:1.55;">
              <span data-i18n="auth_terms_text">أوافق على الشروط والخصوصية — تشفير AES-256</span>
            </label>
          </div>
          <div id="otp-send-wrap">
            <button type="button" class="auth-submit-btn" onclick="sendOTP()" style="background:linear-gradient(135deg,#1B7A3D,#0D5C2E);color:#FFF;margin-bottom:0.75rem;" data-i18n="auth_send_otp">إرسال رمز التحقق</button>
          </div>
          <div id="otp-verify-wrap" style="display:none;">
            <button type="button" class="auth-submit-btn" onclick="handleRegister()" data-i18n="auth_verify_register">تحقق وأنشئ الحساب</button>
          </div>
        </div>

        <!-- Security Badges -->
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;justify-content:center;margin-top:1.25rem;">
          <div class="sec-badge">
            <svg style="width:0.7rem;height:0.7rem;fill:none;stroke:currentColor;stroke-width:2;" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            AES-256
          </div>
          <div class="sec-badge">
            <svg style="width:0.7rem;height:0.7rem;fill:none;stroke:currentColor;stroke-width:2;" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            SSL/TLS
          </div>
          <div class="sec-badge">JWT Token</div>
          <div class="sec-badge">خصوصيتك أولًا</div>
        </div>

      </div>
    </div>
  </div>

</body>
</html>