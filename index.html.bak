        wilaya_en: 'Tipaza Province (42)',
        badge: 'مرشح لقائمة اليونسكو',
        lat: 36.6269,
        lng: 2.2214,
        image: 'timgad.jpg',
        zoom: 16,
        desc_ar: 'الضريح الملكي الموريطاني (قبر الرومية)، يقع فوق تل بتيبازة على ارتفاع 261م فوق البحر. قطره 60م وارتفاعه 32م، يعود لمطلع القرن الأول الميلادي. بُني للملك يوبا الثاني وزوجته كليوباترا سيليني الثانية.',
        desc_en: 'The Royal Mauretanian Mausoleum sits on a 261m hill above Tipaza. 60m diameter, 32m high, early 1st century AD. Built for King Juba II and Cleopatra Selene II.'
      },
      tin_hinan: {
        name_ar: 'ضريح تين هينان — ملكة الطوارق الأسطورية (تمنراست)',
        name_en: 'Tomb of Tin Hinan (Tamanrasset)',
        wilaya_ar: 'ولاية تمنراست (11)',
        wilaya_en: 'Tamanrasset Province (11)',
        badge: 'تراث وطني جزائري (القرن 4م)',
        lat: 23.1333,
        lng: 5.9500,
        image: 'tassili.jpg',
        zoom: 15,
        desc_ar: 'ضريح تين هينان في موقع أبلسا بتمنراست، يعود للقرن الرابع الميلادي. تين هينان ملكة أمازيغية أسطورية وجدة قبائل الطوارق كافة. اكتُشف الضريح عام 1925 وبه حلي ذهبية وفضية عريقة.',
        desc_en: 'Tomb of Tin Hinan at Abalessa, Tamanrasset, 4th century AD. Legendary Amazigh queen and mother of all Tuareg peoples. Discovered in 1925 with gold and silver jewelry.'
      },
      masinissa: {
        name_ar: 'قبر الملك ماسينيسا — الخروب، قسنطينة',
