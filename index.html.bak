        wilaya_en: 'Constantine Province (25)',
        badge: 'أثر نوميدي مصنف (148 ق.م)',
        lat: 36.2186,
        lng: 6.5881,
        image: 'cirta.jpg',
        zoom: 16,
        desc_ar: 'ضريح الملك ماسينيسا (238–148 ق.م)، مؤسس مملكة نوميديا الموحدة وأول دولة أمازيغية موحدة في شمال أفريقيا. قواعد معمارية كلسية ضخمة تخلد أعظم ملوك نوميديا.',
        desc_en: 'Mausoleum of King Masinissa (238–148 BC), founder of the unified Numidian kingdom. Massive limestone architecture commemorating Numidia\'s greatest sovereign.'
      }
    };

    function focusGoogleMapSite(key) {
      const site = GOOGLE_MAP_SITES[key];
      if (!site) return;
      currentGoogleMapSiteKey = key;

      // Update pills active state
      document.querySelectorAll('.gmap-monument-pill').forEach(pill => {
        pill.classList.remove('active');
        if (pill.getAttribute('onclick') && pill.getAttribute('onclick').includes(key)) {
          pill.classList.add('active');
        }
      });

      // Update iframe source
      const iframe = document.getElementById('google-heritage-iframe');
      if (iframe) {
        iframe.src = `https://maps.google.com/maps?q=${site.lat},${site.lng}&hl=${currentLang}&z=${site.zoom}&t=${currentGoogleMapMode}&output=embed`;
      }

      // Update floating card
      const card = document.getElementById('gmap-monument-card');
      const img = document.getElementById('gmap-card-img');
      const title = document.getElementById('gmap-card-title');
      const wilaya = document.getElementById('gmap-card-wilaya');
      const badge = document.getElementById('gmap-card-badge');
      const desc = document.getElementById('gmap-card-desc');
      const link = document.getElementById('gmap-card-direct-link');

      if (card) {
        card.style.display = 'block';
        if (img) img.src = site.image;
        if (title) title.textContent = currentLang === 'ar' ? site.name_ar : site.name_en;
        if (wilaya) wilaya.textContent = currentLang === 'ar' ? site.wilaya_ar : site.wilaya_en;
        if (badge) badge.textContent = site.badge;
        if (desc) desc.textContent = currentLang === 'ar' ? site.desc_ar : site.desc_en;
        if (link) link.href = `https://www.google.com/maps/dir/?api=1&destination=${site.lat},${site.lng}`;
      }
    }

    function setGoogleMapMode(mode) {
      currentGoogleMapMode = mode;
      const btnSat = document.getElementById('gmap-btn-sat');
      const btnRoad = document.getElementById('gmap-btn-road');
      if (btnSat) btnSat.className = mode === 'k' ? 'btn btn-gold' : 'btn btn-outline';
      if (btnRoad) btnRoad.className = mode === 'm' ? 'btn btn-gold' : 'btn btn-outline';

      focusGoogleMapSite(currentGoogleMapSiteKey);
    }

    function resetGoogleMapAlgeria() {
      const iframe = document.getElementById('google-heritage-iframe');
      if (iframe) {
        iframe.src = `https://maps.google.com/maps?q=Algeria&hl=${currentLang}&z=6&t=${currentGoogleMapMode}&output=embed`;
      }
      document.querySelectorAll('.gmap-monument-pill').forEach(p => p.classList.remove('active'));
    }

    /* Language Switcher */
    function toggleLanguage() {
      currentLang = currentLang === 'ar' ? 'en' : 'ar';
      document.body.classList.toggle('lang-en', currentLang === 'en');
      document.documentElement.setAttribute('lang', currentLang);
      document.documentElement.setAttribute('dir', currentLang === 'en' ? 'ltr' : 'rtl');
      
      const btnLabel = document.getElementById('lang-label');
      if (btnLabel) btnLabel.textContent = currentLang === 'ar' ? 'English' : 'العربية';
      
      const sovereignLabel = document.getElementById('sovereign-lang-label');
      if (sovereignLabel) sovereignLabel.textContent = currentLang === 'ar' ? 'English (EN)' : 'العربية (AR)';

      const drawerLangLabel = document.getElementById('drawer-lang-label');
      if (drawerLangLabel) drawerLangLabel.textContent = currentLang === 'ar' ? 'تبديل اللغة / Switch to English' : 'Switch Language / التحويل للعربية';

      // Update all static i18n tags
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (I18N[currentLang] && I18N[currentLang][key]) {
          el.innerText = I18N[currentLang][key];
        }
      });

      // Re-render all dynamic data cards with English/Arabic
      renderAllDynamicContent();
      loadQuizQuestion(currentQuizIndex);

      showToast(currentLang === 'ar' ? 'تم تحويل الواجهة بالكامل إلى اللغة العربية' : 'Switched entire interface to English');
    }

    /* Dynamic Renderers with strict language adherence */
    function renderEvents(data) {
      const wrap = document.getElementById('events-grid');
      if (!wrap) return;
      wrap.innerHTML = data.map(ev => {
        const name = currentLang === 'ar' ? ev.name_ar : ev.name_en;
        const wilaya = currentLang === 'ar' ? ev.wilaya_ar : ev.wilaya_en;
        const loc = currentLang === 'ar' ? ev.location_ar : ev.location_en;
        const date = currentLang === 'ar' ? ev.date_ar : ev.date_en;
        const desc = currentLang === 'ar' ? ev.desc_ar : ev.desc_en;
        const bookBtn = I18N[currentLang].btn_book_ticket;
        const mapBtn = I18N[currentLang].btn_map;

        return `
          <article class="card">
            <div class="img-wrap">
              <span class="img-tag">${escapeHTML(wilaya)}</span>
              <img src="${escapeHTML(ev.image)}" alt="${escapeHTML(name)}" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <div style="font-size:0.75rem; color:var(--gold-light); font-weight:600; margin-bottom:0.25rem;">${escapeHTML(date)}</div>
              <h3 class="font-heading" style="font-size:1.2rem; color:#FFF; margin-bottom:0.4rem;">${escapeHTML(name)}</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem; line-height:1.5;">${escapeHTML(desc)}</p>
              <div style="font-size:0.775rem; color:var(--text-dim); margin-bottom:1rem;">📍 ${escapeHTML(loc)}</div>
              <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">
                <button type="button" class="btn btn-gold" style="flex:1; padding:0.45rem 0.75rem; font-size:0.8rem;" onclick="openEventBooking('${ev.id}')">${bookBtn} (${ev.price})</button>
                <a href="https://www.google.com/maps/search/?api=1&query=${ev.lat},${ev.lng}" target="_blank" rel="noopener" class="btn btn-outline" style="padding:0.45rem 0.65rem;" title="Google Maps">
                  <svg style="width:1.1rem; height:1.1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                  <span>${mapBtn}</span>
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function filterEvents(cat) {
      if (cat === 'all') {
        renderEvents(FESTIVALS_DATA);
      } else {
        renderEvents(FESTIVALS_DATA.filter(e => e.category === cat));
      }
    }

    
    function focusGoogleMapSiteFromAtlas(id) {
      const mapping = {
        'atlas-timgad': 'timgad',
        'atlas-djemila': 'djemila',
        'atlas-tassili': 'tassili',
        'atlas-kasbah': 'kasbah',
        'atlas-medracen': 'medracen',
        'atlas-tombeau-chretienne': 'chretienne',
        'atlas-tin-hinan': 'tin_hinan',
        'atlas-masinissa': 'masinissa'
      };
      const key = mapping[id] || 'timgad';
      focusGoogleMapSite(key);
      const mapEl = document.getElementById('google-heritage-iframe');
      if (mapEl) mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function renderAtlas(data) {
      const wrap = document.getElementById('atlas-grid');
      if (!wrap) return;
      wrap.innerHTML = data.map(item => {
        const name = currentLang === 'ar' ? item.name_ar : item.name_en;
        const wilaya = currentLang === 'ar' ? item.wilaya_ar : item.wilaya_en;
        const desc = currentLang === 'ar' ? item.desc_ar : item.desc_en;
        const mapAction = I18N[currentLang].btn_google_maps;

        return `
          <article class="card card-interactive" onclick="focusGoogleMapSiteFromAtlas('${item.id}')" style="cursor:pointer;">
            <div class="img-wrap">
              <span class="img-tag">${escapeHTML(item.unesco)}</span>
              <img src="${escapeHTML(item.image)}" alt="${escapeHTML(name)}" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <div style="font-size:0.75rem; color:var(--gold-light); font-weight:600; margin-bottom:0.25rem;">${escapeHTML(wilaya)}</div>
              <h3 class="font-heading" style="font-size:1.2rem; color:#FFF; margin-bottom:0.4rem;">${escapeHTML(name)}</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1rem; line-height:1.5;">${escapeHTML(desc)}</p>
              <div style="display:flex; justify-content:space-between; align-items:center; font-family:monospace; font-size:0.75rem; color:var(--neon-cyan); margin-bottom:1rem; background:rgba(0,0,0,0.3); padding:0.35rem 0.65rem; border-radius:0.5rem;">
                <span>GPS: ${item.lat}, ${item.lng}</span>
                <span>Verified</span>
              </div>
              <a href="https://www.google.com/maps/search/?api=1&query=${item.lat},${item.lng}" target="_blank" rel="noopener" class="btn btn-gold" style="width:100%; font-size:0.8rem; padding:0.5rem;">
                <svg style="width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                ${mapAction}
              </a>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderMuseums(data) {
      const wrap = document.getElementById('museums-grid');
      if (!wrap) return;
      wrap.innerHTML = data.map(m => {
        const name = currentLang === 'ar' ? m.name_ar : m.name_en;
        const wilaya = currentLang === 'ar' ? m.wilaya_ar : m.wilaya_en;
        const addr = currentLang === 'ar' ? m.address_ar : m.address_en;
        const desc = currentLang === 'ar' ? m.desc_ar : m.desc_en;
        const bookBtn = I18N[currentLang].btn_book_ticket;

        return `
          <article class="card">
            <div class="img-wrap">
              <span class="img-tag">${escapeHTML(wilaya)}</span>
              <img src="${escapeHTML(m.image)}" alt="${escapeHTML(name)}" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <h3 class="font-heading" style="font-size:1.2rem; color:#FFF; margin-bottom:0.4rem;">${escapeHTML(name)}</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:0.75rem; line-height:1.5;">${escapeHTML(desc)}</p>
              <div style="font-size:0.75rem; color:var(--text-dim); margin-bottom:1rem;">📍 ${escapeHTML(addr)}</div>
              <div style="display:flex; gap:0.5rem;">
                <button type="button" class="btn btn-gold" style="flex:1; font-size:0.8rem; padding:0.5rem;" onclick="openMuseumBooking('${escapeHTML(name)}')">
                  ${bookBtn} (${m.price})
                </button>
                <a href="https://www.google.com/maps/search/?api=1&query=${m.lat},${m.lng}" target="_blank" rel="noopener" class="btn btn-outline" style="padding:0.5rem;" title="Google Maps">
                  <svg style="width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                </a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderArtists(data) {
      const wrap = document.getElementById('artists-grid');
      if (!wrap) return;
      wrap.innerHTML = data.map(art => {
        const name = currentLang === 'ar' ? art.name_ar : art.name_en;
        const disc = currentLang === 'ar' ? art.discipline_ar : art.discipline_en;
        const wilaya = currentLang === 'ar' ? art.wilaya_ar : art.wilaya_en;
        const bio = currentLang === 'ar' ? art.bio_ar : art.bio_en;
        const contactBtn = I18N[currentLang].btn_contact_art;

        return `
          <article class="card">
            <div class="img-wrap" style="height:220px;">
              <span class="img-tag">${escapeHTML(wilaya)}</span>
              <img src="${escapeHTML(art.image)}" alt="${escapeHTML(name)}" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <div style="font-size:0.75rem; color:var(--gold-light); font-weight:600; margin-bottom:0.25rem;">${escapeHTML(disc)}</div>
              <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.4rem;">${escapeHTML(name)}</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:1.25rem; line-height:1.5;">${escapeHTML(bio)}</p>
              <button type="button" class="btn btn-gold" style="width:100%; font-size:0.8rem; padding:0.5rem;" onclick="openArtistModal('${art.id}')">
                <svg style="width:1rem; height:1rem; fill:none; stroke:currentColor; stroke-width:2;" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                ${contactBtn}
              </button>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderCuisine(data) {
      const wrap = document.getElementById('cuisine-grid');
      if (!wrap) return;
      wrap.innerHTML = data.map(c => {
        const name = currentLang === 'ar' ? c.name_ar : c.name_en;
        const region = currentLang === 'ar' ? c.region_ar : c.region_en;
        const type = currentLang === 'ar' ? c.type_ar : c.type_en;
        const desc = currentLang === 'ar' ? c.desc_ar : c.desc_en;

        return `
          <article class="card card-interactive" onclick="openCuisineRestaurantsModal('${c.id}')" style="cursor:pointer;">
            <div class="img-wrap">
              <span class="img-tag">${escapeHTML(type)}</span>
              <img src="${escapeHTML(c.image)}" alt="${escapeHTML(name)}" loading="lazy">
            </div>
            <div style="padding:1.25rem;">
              <div style="font-size:0.75rem; color:var(--gold-light); font-weight:600; margin-bottom:0.25rem;">📍 ${escapeHTML(region)}</div>
              <h3 class="font-heading" style="font-size:1.25rem; color:#FFF; margin-bottom:0.4rem;">${escapeHTML(name)}</h3>
              <p style="color:var(--text-muted); font-size:0.85rem; line-height:1.6;">${escapeHTML(desc)}</p>
            </div>
          </article>
        `;
      }).join('');
    }

    function renderWilayaTable(data) {
      const tbody = document.getElementById('wilaya-table-body');
      if (!tbody) return;
      tbody.innerHTML = data.map(w => {
        const name = currentLang === 'ar' ? w.name_ar : w.name_en;
        const mon = currentLang === 'ar' ? w.mon_ar : w.mon_en;
        const stat = currentLang === 'ar' ? w.stat_ar : w.stat_en;

        return `
          <tr style="border-bottom:1px solid rgba(255,255,255,0.05);">
            <td style="padding:0.75rem 0.5rem; font-family:monospace; color:var(--gold-light);">${w.num}</td>
            <td style="padding:0.75rem 0.5rem; font-weight:600; color:#FFF;">${escapeHTML(name)}</td>
            <td style="padding:0.75rem 0.5rem; color:var(--text-muted);">${escapeHTML(mon)}</td>
            <td style="padding:0.75rem 0.5rem; color:var(--text-muted);">${w.mus}</td>
            <td style="padding:0.75rem 0.5rem; color:var(--gold-primary); font-weight:600;">${w.vis}</td>
            <td style="padding:0.75rem 0.5rem;"><span class="badge" style="background:#0F3A22; color:#86EFAC;">${stat}</span></td>
          </tr>
        `;
      }).join('');
    }

    function filterWilayaTable(val) {
      const q = (val || '').toLowerCase().trim();
      const filtered = WILAYAS_SAMPLE.filter(w => 
        w.name_ar.toLowerCase().includes(q) || 
        w.name_en.toLowerCase().includes(q) || 
        w.num.includes(q)
      );
      renderWilayaTable(filtered);
    }

    /* Router */
    
    function scrollToCategoriesSection() {
      const el = document.getElementById('categories-section');
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    
    function openSearchModal() {
      const modal = document.getElementById('search-modal');
      const input = document.getElementById('global-search-input');
      if (modal) {
        modal.style.display = 'flex';
        setTimeout(() => input && input.focus(), 50);
      }
    }
    function closeSearchModal() {
      const modal = document.getElementById('search-modal');
      if (modal) modal.style.display = 'none';
    }
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openSearchModal();
      }
      if (e.key === 'Escape') {
        closeSearchModal();
      }
    });

    function handleGlobalSearch(query) {
      const q = (query || '').trim().toLowerCase();
      const container = document.getElementById('search-results-box');
      if (!container) return;
      if (!q) {
        container.innerHTML = '<div style="padding:1.5rem; text-align:center; color:#94A3B8; font-size:0.9rem;">اكتب كلمة للبحث الفوري في كافة أقسام وتراث منصة ثقافة دز...</div>';
        return;
      }
      let matches = [];
      if (typeof FESTIVALS_DATA !== 'undefined') {
        FESTIVALS_DATA.forEach(f => {
          if ((f.name_ar && f.name_ar.toLowerCase().includes(q)) || (f.name_en && f.name_en.toLowerCase().includes(q))) {
            matches.push({ title: currentLang === 'ar' ? f.name_ar : f.name_en, section: 'events', badge: 'مهرجان' });
          }
        });
      }
      if (typeof ATLAS_DATA !== 'undefined') {
        ATLAS_DATA.forEach(m => {
          if ((m.name_ar && m.name_ar.toLowerCase().includes(q)) || (m.name_en && m.name_en.toLowerCase().includes(q))) {
            matches.push({ title: currentLang === 'ar' ? m.name_ar : m.name_en, section: 'atlas', badge: 'أثر يونسكو' });
          }
        });
      }
      if (typeof MUSEUMS_DATA !== 'undefined') {
        MUSEUMS_DATA.forEach(mu => {
          if ((mu.name_ar && mu.name_ar.toLowerCase().includes(q)) || (mu.name_en && mu.name_en.toLowerCase().includes(q))) {
            matches.push({ title: currentLang === 'ar' ? mu.name_ar : mu.name_en, section: 'tickets', badge: 'متحف' });
          }
        });
      }
      if (typeof ARTISTS_DATA !== 'undefined') {
        ARTISTS_DATA.forEach(a => {
          if ((a.name_ar && a.name_ar.toLowerCase().includes(q)) || (a.name_en && a.name_en.toLowerCase().includes(q))) {
            matches.push({ title: currentLang === 'ar' ? a.name_ar : a.name_en, section: 'artists', badge: 'فنان' });
          }
        });
      }
      if (typeof CUISINE_DATA !== 'undefined') {
        CUISINE_DATA.forEach(c => {
          if ((c.name_ar && c.name_ar.toLowerCase().includes(q)) || (c.name_en && c.name_en.toLowerCase().includes(q))) {
            matches.push({ title: currentLang === 'ar' ? c.name_ar : c.name_en, section: 'cuisine', badge: 'طبق تراثي' });
          }
        });
      }

      if (matches.length === 0) {
        container.innerHTML = '<div style="padding:1.5rem; text-align:center; color:#94A3B8;">لم يتم العثور على نتائج مطابقة لـ "' + q + '"</div>';
        return;
      }
      container.innerHTML = matches.slice(0, 8).map(m => `
        <div onclick="navigateTo('${m.section}'); closeSearchModal();" style="display:flex; justify-content:space-between; align-items:center; padding:0.75rem 1rem; border-radius:0.75rem; background:rgba(255,255,255,0.03); margin-bottom:0.4rem; cursor:pointer; transition:background 0.2s; border:1px solid rgba(255,255,255,0.05);">
          <span style="color:#FFF; font-weight:600;">${m.title}</span>
          <span class="badge" style="font-size:0.7rem; background:rgba(212,175,55,0.15); border-color:rgba(212,175,55,0.3); color:#D4AF37;">${m.badge}</span>
        </div>
      `).join('');
    }


    /* ══════════════════════════════════════════════════════
       BOOKS DATA — REAL ALGERIAN LITERATURE (DOCUMENTED)
       ══════════════════════════════════════════════════════ */
    const BOOKS_DATA = [
      {
        id: 'book-assia-djebar',
        title_ar: 'البوابة المفتوحة / الحب، الفانتازيا',
        title_fr: "L'Amour, la Fantasia",
        author_ar: 'آسيا جبار',
        author_en: 'Assia Djebar',
        year: 1985,
        publisher_ar: 'Albin Michel — باريس',
        genre_ar: 'رواية — أدب نسوي',
        genre_en: 'Novel — Feminist Literature',
        awards: 'Prix Marguerite Yourcenar 1997 | أول عضوة أفريقية في الأكاديمية الفرنسية',
        synopsis_ar: 'آسيا جبار (1936–2015) أول جزائرية وأفريقية في الأكاديمية الفرنسية. روايتها تمزج بين التاريخ الجزائري إبان الغزو الفرنسي وقصص نساء جزائريات في سرد شعري مؤثر.',
        synopsis_en: 'Assia Djebar (1936–2015), first Algerian and African at the Académie française. The novel blends Algeria\'s French conquest history with women\'s intimate stories in moving lyrical prose.',
        color: '#7C3AED'
      },
      {
        id: 'book-kateb-yacine',
        title_ar: 'نجمة',
        title_fr: 'Nedjma',
        author_ar: 'كاتب ياسين',
        author_en: 'Kateb Yacine',
        year: 1956,
        publisher_ar: 'Seuil — باريس',
        genre_ar: 'رواية — الأدب الوطني التأسيسي',
        genre_en: 'Novel — Foundational National Literature',
        awards: 'رمز الكفاح الوطني الجزائري | مقرر في جامعات العالم',
        synopsis_ar: 'نجمة (1956) الرواية التأسيسية للأدب الجزائري الحديث بالفرنسية. رمز الهوية والكفاح الوطني، مكتوبة وسط صرخة ثورة التحرير. كاتب ياسين (1929-1989) ركيزة الأدب المغاربي.',
        synopsis_en: 'Nedjma (1956), founding novel of modern Algerian literature in French. A symbol of identity and national struggle, written amid the cry of the liberation revolution. Kateb Yacine (1929–1989) is a cornerstone of Maghrebi literature.',
        color: '#059669'
      },
      {
        id: 'book-mhd-dib',
        title_ar: 'الحريق — ثلاثية الجزائر (الجزء الثاني)',
        title_fr: "L'Incendie",
